# 真实后端地址（SSR 直连 / 中间件转发 / GraphQL 目标均由此变量驱动）
# 本地开发：http://127.0.0.1:8000
# 生产（docker-compose + APISIX 统一入口）：http://backend:8000（compose 内网别名，
#   仅供 SSR 数据获取直连后端；浏览器端 /api、/graphql 由 APISIX 直接反代到 backend，不经过前端）
# 留空则前端不请求后端
API_URL=

# 监测基线 · RUM（可选）：前端性能监测 Sentry 的 DSN
# 填写真实 DSN 后，BaseLayout 会在每个页面注入 <SentryInit client:load="vue" />，
# 自动采集 Web Vitals（LCP/CLS/INP field）+ 错误，tracesSampleRate=0.2。
# 留空则不注入任何 Sentry 代码，完全不影响首屏/本地/测试。
PUBLIC_SENTRY_DSN=

# 站点对外 URL 与基础路径（可选；默认读取 src/data/config.yaml 的 site / base）
# 如部署在 https://example.com/blog 子路径下：PUBLIC_SITE_URL=https://example.com  PUBLIC_BASE_PATH=/blog
PUBLIC_SITE_URL=
PUBLIC_BASE_PATH=/
