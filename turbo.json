{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "pnpm-workspace.yaml",
    "turbo.json",
    "astro.config.ts"
  ],
  "tasks": {
    "check:astro": {
      "cache": true,
      "inputs": ["src/**", "astro.config.ts", "tsconfig.json"],
      "outputs": []
    },
    "check:eslint": {
      "cache": true,
      "inputs": ["src/**", "scripts/**", "eslint.config.js"],
      "outputs": []
    },
    "check:prettier": {
      "cache": true,
      "inputs": ["src/**", "scripts/**", "**/*.{json,md}", ".prettierignore"],
      "outputs": []
    },
    "check:jscpd": {
      "cache": true,
      "inputs": ["src/**", ".jscpdrc.json"],
      "outputs": []
    },
    "test": {
      "cache": true,
      "inputs": ["src/**", "tests/**", "vitest.config.ts"],
      "outputs": []
    },
    "build": {
      "cache": true,
      "inputs": ["src/**", "public/**", "astro.config.ts", "scripts/**"],
      "outputs": ["dist/**"],
      "env": ["PUBLIC_*", "NODE_ENV"]
    }
  }
}
