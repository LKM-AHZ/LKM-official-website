# build output
dist/
.output/
# 以 / 锚定根目录：不锚定会忽略任意层级的同名目录（如将来的 src/**/docs），
# 从而把源码里的文档目录悄悄排除出版本控制
/docs/
.turbo/

# dependencies
node_modules/
.pnpm-store/

# logs（*.log 已覆盖各包管理器的 debug 日志，另加通用的 logs/ 目录）
*.log
logs/


# environment variables
# 只忽略精确 .env 会漏掉 .env.local/.env.staging 等变体，一律按通配忽略
.env
.env.*
!.env.example

# macOS-specific files
.DS_Store

.astro

# Python
__pycache__
*.pyc
backend/.pytest_cache/

#ai
.claude
.codex
.codegraph
.superpowers/

# python venv
.venv/

# tools output（同样锚定根目录，避免误伤 src/tools、src/features/report 之类）
/tool/
/tools/
/reports/
/report/

# scripts/ 默认忽略（保留已跟踪的构建/检查脚本）
/scripts/*
!/scripts/generate-icons.mjs
!/scripts/generate-i18n-flat.mjs
!/scripts/lib/
!/scripts/lib/start-preview.mjs
!/scripts/precompress.mjs
!/scripts/check-bundle-budget.mjs
!/scripts/check-links.mjs
!/scripts/check-seo-output.mjs
!/scripts/optimize-avatars.mjs
!/scripts/lighthouse-budget.mjs
!/scripts/measure-cwv.mjs
!/scripts/jsbudget-baseline.json

# reference material (astro templates, not committed)
reference/astro-templates/

# Playwright test output
test-results/
# Vitest 覆盖率产物与 TS 增量编译信息（生成物，写了就别提交）
coverage/
*.tsbuildinfo
/LKM-service/
