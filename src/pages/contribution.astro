import { ContributionPage } from "~/features/contribution";
import { t } from "~/lib/i18n";

const metadata = { title: t("page.official.contribution.metaTitle") };
---

<Layout metadata={metadata}>
  <div class="site-content-frame max-w-5xl" style="min-height: 400px">
    <ContributionPage client:load />
  </div>
</Layout>
