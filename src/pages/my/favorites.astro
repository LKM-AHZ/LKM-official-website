---
import Layout from "~/layouts/SidebarLayout.astro";
import PageIntro from "~/components/patterns/PageIntro.astro";
import MyInteractionsPage from "~/features/profile/components/MyInteractionsPage.vue";
import { t } from "~/lib/i18n";

const title = t("myContent.favoritesTitle");
---

<Layout metadata={{ title }}>
  <div class="space-y-6">
    <PageIntro title={title} icon="tabler:bookmark" />
    <div class="min-h-[400px]">
      <MyInteractionsPage kind="favorites" client:only="vue" />
    </div>
  </div>
</Layout>
