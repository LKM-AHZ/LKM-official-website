---
import Layout from "~/layouts/PageLayout.astro";
import PageIntro from "~/components/patterns/PageIntro.astro";
import { Icon } from "astro-icon/components";
import type { MetaData } from "~/types/core";
import { buildUrl } from "~/lib/utils/paths";
import { t } from "~/lib/i18n";

const metadata: MetaData = {
  title: t("page.apps.title"),
  description: t("page.apps.description"),
};

const apps = [
  {
    name: t("page.apps.starHope.name"),
    desc: t("page.apps.starHope.description"),
    href: buildUrl("/starhope"),
    icon: "tabler:school",
  },
  {
    name: t("page.apps.treehole.name"),
    desc: t("page.apps.treehole.description"),
    href: buildUrl("/treehole"),
    icon: "tabler:moon-stars",
  },
];
---

<Layout metadata={metadata}>
  <div class="site-content-frame">
    <PageIntro
      title={t("page.apps.title")}
      description={t("page.apps.subtitle")}
      eyebrow={t("page.ui.appsEyebrow")}
      icon="tabler:apps"
    />
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        apps.map((app) => (
          <a
            href={app.href}
            class="group flex min-h-48 flex-col rounded-[20px] border border-surface-3 bg-card-bg p-6 transition-colors hover:border-primary/50 hover:bg-btn-card-bg-hover focus-visible:outline-2 focus-visible:outline-primary"
          >
            <span
              class="grid h-12 w-12 place-items-center rounded-2xl bg-btn-regular-bg text-primary-readable"
              aria-hidden="true"
            >
              <Icon name={app.icon} class="h-6 w-6" />
            </span>
            <h2 class="mt-5 text-lg font-semibold text-deep-text group-hover:text-primary-readable">
              {app.name}
            </h2>
            <p class="mt-2 text-sm leading-6 text-text-muted">{app.desc}</p>
            <span class="mt-auto flex items-center gap-1 pt-5 text-sm font-medium text-primary-readable">
              {t("page.apps.open")}{" "}
              <Icon
                name="tabler:arrow-up-right"
                class="h-4 w-4"
                aria-hidden="true"
              />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
