---
import Layout from "~/layouts/PageLayout.astro";
import type { MetaData } from "~/types/core";
import { buildUrl } from "~/lib/utils/paths";
import { t } from "~/lib/i18n";

const metadata: MetaData = {
  title: t("page.apps.title"),
  description: t("page.apps.description"),
};

const apps = [
  {
    name: t("page.apps.starHope.name"),
    desc: t("page.apps.starHope.description"),
    href: buildUrl("/starhope"),
    icon: "📚",
  },
  {
    name: t("page.apps.treehole.name"),
    desc: t("page.apps.treehole.description"),
    href: buildUrl("/treehole"),
    icon: "🌙",
  },
];
---

<Layout metadata={metadata}>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">
      {t("page.apps.title")}
    </h1>
    <p class="text-gray-500 dark:text-gray-400 mb-8">
      {t("page.apps.subtitle")}
    </p>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        apps.map((app) => (
          <a
            href={app.href}
            class="block p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-primary/50 hover:shadow-md transition-all"
          >
            <div class="text-3xl mb-3">{app.icon}</div>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">
              {app.name}
            </h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
              {app.desc}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
