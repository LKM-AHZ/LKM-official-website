---
import Layout from "~/layouts/SidebarLayout.astro";
import QAListPage from "~/features/qa/components/QAListPage.vue";
import { getPermalink } from "~/lib/utils/permalinks";
import { t } from "~/lib/i18n";

const metadata = { title: `${t("page.qa.title")} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={[
    { text: "nav.overview", href: "#overview" },
    { text: "nav.qa", href: "#questions" },
  ]}
  currentPath={getPermalink("/qa")}
>
  <div class="space-y-6">
    <div id="overview">
      <h1 class="text-3xl font-bold text-deep-text">{t("page.qa.title")}</h1>
      <p class="text-text-muted mt-2">{t("page.qa.subtitle")}</p>
    </div>
    <div id="questions" style="min-height: 400px">
      <QAListPage client:load />
    </div>
  </div>
</Layout>
