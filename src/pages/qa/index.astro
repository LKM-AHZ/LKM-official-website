---
import Layout from "~/layouts/SidebarLayout.astro";
import PageIntro from "~/components/patterns/PageIntro.astro";
import QAListPage from "~/features/qa/components/QAListPage.vue";
import { getPermalink } from "~/lib/utils/permalinks";
import { t } from "~/lib/i18n";

const metadata = { title: t("page.qa.title") };
---

<Layout
  metadata={metadata}
  sidebarLinks={[
    {
      text: "nav.overview",
      href: "#overview",
      icon: "tabler:layout-dashboard",
    },
    { text: "nav.qa", href: "#questions", icon: "tabler:help-circle" },
  ]}
  currentPath={getPermalink("/qa")}
>
  <div class="space-y-6">
    <PageIntro
      title={t("page.qa.title")}
      description={t("page.qa.subtitle")}
      eyebrow={t("page.ui.qaEyebrow")}
      icon="tabler:help-circle"
    />
    <div id="questions" style="min-height: 400px">
      <QAListPage client:load />
    </div>
  </div>
</Layout>
