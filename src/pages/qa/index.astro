---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import QAListPage from '~/features/qa/components/QAListPage.vue';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = { title: `${t('page.qa.title')} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink('/qa')}
  navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}
>
  <div class="space-y-6">
    <h1 class="text-3xl font-bold text-deep-text">{t('page.qa.title')}</h1>
    <p class="text-text-muted mt-2">{t('page.qa.subtitle')}</p>
    <div style="min-height: 400px"><QAListPage client:load /></div>
  </div>
</Layout>
