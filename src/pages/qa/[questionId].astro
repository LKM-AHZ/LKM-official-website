---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import QuestionDetail from '~/features/qa/components/QuestionDetail.vue';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

// 详情数据由客户端 island 从后端 /api/v1/content/qa 拉取（真实动态数据，非 SSG 内同步 mock）。
const { questionId } = Astro.params;
const metadata = { title: `${t('page.qa.title')} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink(`/qa/${questionId}`)}
  navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}
>
  <QuestionDetail client:load questionId={questionId ?? ''} />
</Layout>
