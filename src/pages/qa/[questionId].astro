---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import { Icon } from 'astro-icon/components';
import { getQuestionById, getAnswersByQuestionId } from '~/features/qa/data/mock-questions';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

// server 模式：params 从 URL 直接解析
const { questionId } = Astro.params;
const question = getQuestionById(questionId || '');
const answers = getAnswersByQuestionId(questionId || '');

if (!question) {
  return Astro.redirect(getPermalink('/qa'));
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

const metadata = { title: `${t(question.title)} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink(`/qa/${questionId}`)}
  navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}
>
  <div class="space-y-6 max-w-3xl">
    <!-- 问题 -->
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span
          class:list={[
            'text-xs px-2 py-0.5 rounded-full font-medium',
            question.status === 'resolved'
              ? 'bg-green-100 dark:bg-green-950/30 text-green-500'
              : 'bg-yellow-100 dark:bg-yellow-950/30 text-yellow-500',
          ]}
        >
          {question.status === 'resolved' ? t('page.qa.resolved') : t('page.qa.unresolved')}
        </span>
        {
          question.bounty > 0 && (
            <span class="text-xs text-amber-500 font-medium">{t('page.qa.bounty', { count: question.bounty })}</span>
          )
        }
      </div>
      <h1 class="text-2xl font-bold text-deep-text">{t(question.title)}</h1>
      <div class="flex items-center gap-2 mt-2 text-sm text-text-muted/60">
        <span>{t(question.askerName)}</span>
        <span>·</span>
        <span>{formatDate(question.createdAt)}</span>
        <span>·</span>
        <span>{t('page.qa.views', { count: question.viewCount })}</span>
      </div>
      <div class="flex flex-wrap gap-1 mt-2">
        {
          question.tags.map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary">{t(tag)}</span>
          ))
        }
      </div>
      <div class="mt-4 p-4 bg-card-bg border border-surface-3 rounded-xl text-sm text-deep-text leading-relaxed">
        {t(question.content)}
      </div>
    </div>

    <!-- 回答列表 -->
    <div>
      <h3 class="font-semibold text-deep-text mb-4">{t('page.qa.answers', { count: answers.length })}</h3>
      <div class="space-y-4">
        {
          answers.map((a) => (
            <div
              class="bg-card-bg border rounded-xl p-4"
              class:list={[
                { 'border-green-200 dark:border-green-900/30 bg-green-50 dark:bg-green-950/10': a.isAccepted },
                { 'border-surface-3': !a.isAccepted },
              ]}
            >
              {a.isAccepted && (
                <div class="text-xs text-green-500 font-medium mb-2 inline-flex items-center gap-1">
                  <Icon name="material-symbols:check-circle" class="w-3.5 h-3.5" /> {t('page.qa.accepted')}
                </div>
              )}
              <div class="text-sm text-deep-text leading-relaxed">{t(a.content)}</div>
              <div class="flex items-center gap-3 mt-3 text-xs text-text-muted/60">
                <span>{t(a.authorName)}</span>
                <span>{formatDate(a.createdAt)}</span>
                <span>{t('page.qa.likes', { count: a.likeCount })}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
