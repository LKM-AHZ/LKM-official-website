---
import { AdminLayout } from '~/features/admin';
import DashboardStats from '~/features/admin/components/DashboardStats.vue';
import DashboardShortcuts from '~/features/admin/components/DashboardShortcuts.vue';
import DashboardActivity from '~/features/admin/components/DashboardActivity.vue';
import DashboardTrend from '~/features/admin/components/DashboardTrend.vue';
import { t } from '~/lib/i18n';
---

<AdminLayout>
  <h1 class="text-2xl font-bold text-deep-text mb-6">{t('page.admin.dashboard.title')}</h1>
  <div class="space-y-6">
    <section>
      <h2 class="text-lg font-semibold text-deep-text mb-3">{t('admin.console.overview')}</h2>
      <DashboardStats client:load />
    </section>
    <section>
      <h2 class="text-lg font-semibold text-deep-text mb-3">{t('admin.console.trend')}</h2>
      <div class="bg-card-bg border border-surface-3 rounded-xl p-4">
        <DashboardTrend client:load />
      </div>
    </section>
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      <div class="lg:col-span-2">
        <h2 class="text-lg font-semibold text-deep-text mb-3">{t('admin.console.activity')}</h2>
        <DashboardActivity client:load />
      </div>
      <div>
        <h2 class="text-lg font-semibold text-deep-text mb-3">{t('admin.console.shortcuts')}</h2>
        <DashboardShortcuts client:load />
      </div>
    </section>
  </div>
</AdminLayout>
