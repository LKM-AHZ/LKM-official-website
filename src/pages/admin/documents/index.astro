---
import PageLayout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = {
  title: t('page.admin.documents.metaTitle'),
  description: t('page.admin.documents.metaDescription'),
};
---

<PageLayout metadata={metadata}>
  <div class="section-container max-w-4xl mx-auto py-8 px-4">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-6 gap-3">
      <h1 class="text-2xl font-bold">{t('page.admin.documents.title')}</h1>
      <div class="flex gap-2 w-full sm:w-auto">
        <input
          type="text"
          class="input input-bordered input-sm flex-1 sm:w-48"
          placeholder={t('page.admin.documents.searchPlaceholder')}
          id="search-input"
          oninput="renderList()"
        />
        <select class="select select-bordered select-sm" id="status-filter" onchange="renderList()">
          <option value="all">{t('page.admin.documents.all')}</option>
          <option value="draft">{t('page.admin.documents.draft')}</option>
          <option value="published">{t('page.admin.documents.published')}</option>
          <option value="archived">{t('page.admin.documents.archived')}</option>
        </select>
        <a href={getPermalink('/editor')} class="btn btn-primary btn-sm">{t('page.admin.documents.newDocument')}</a>
      </div>
    </div>
    <div id="doc-list" class="bg-card-bg border border-surface-3 rounded-lg overflow-hidden">
      <div class="p-8 text-center text-deep-text/50">
        <span class="loading loading-spinner loading-md"></span>
        <p class="mt-2 text-sm">{t('page.admin.documents.loading')}</p>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  import { buildUrl } from '~/lib/utils/paths';
  import { t } from '~/lib/i18n';

  interface DocumentMeta {
    id: string;
    title: string;
    lastModified: string;
    status: 'draft' | 'published' | 'archived';
    version: number;
  }

  const DOCS_KEY = 'lkm-admin-documents';
  const STATUSES: readonly DocumentMeta['status'][] = ['draft', 'published', 'archived'];

  /**
   * localStorage 内容可被手改/旧版本写脏：只接受形状正确的条目并归一化字段，
   * 否则 docs.filter / d.title.toLowerCase() / statusLabels 都会拿到脏值而抛错或注入标记。
   */
  function normalizeDoc(raw: unknown): DocumentMeta | null {
    if (!raw || typeof raw !== 'object') return null;
    const d = raw as Record<string, unknown>;
    if (typeof d.id !== 'string' || !d.id) return null;
    if (typeof d.title !== 'string') return null;
    const status = STATUSES.includes(d.status as DocumentMeta['status'])
      ? (d.status as DocumentMeta['status'])
      : 'draft';
    return {
      id: d.id,
      title: d.title,
      lastModified: typeof d.lastModified === 'string' ? d.lastModified : '',
      status,
      version: typeof d.version === 'number' ? d.version : 1,
    };
  }

  function listDocuments(): DocumentMeta[] {
    try {
      const raw = JSON.parse(localStorage.getItem(DOCS_KEY) ?? '[]');
      if (!Array.isArray(raw)) return [];
      return raw.map(normalizeDoc).filter((d): d is DocumentMeta => d !== null);
    } catch {
      return [];
    }
  }

  function deleteDocument(id: string): void {
    const docs = listDocuments().filter((d) => d.id !== id);
    try {
      localStorage.setItem(DOCS_KEY, JSON.stringify(docs));
    } catch (err) {
      // 存储被禁用（SecurityError）或超额（QuotaExceededError）时写入会抛：
      // 不接住会让 handleDelete 中断、列表不刷新且确认框反复弹出
      console.error('[admin/documents] 保存文档列表失败', err);
      return;
    }
  }

  function renderList(): void {
    let docs: DocumentMeta[] = listDocuments();
    const container = document.getElementById('doc-list');
    if (!container) return;

    // Filter by status
    const statusFilter = (document.getElementById('status-filter') as HTMLSelectElement)?.value ?? 'all';
    if (statusFilter !== 'all') {
      docs = docs.filter((d) => d.status === statusFilter);
    }

    // Search by title
    const searchTerm = ((document.getElementById('search-input') as HTMLInputElement)?.value ?? '').toLowerCase();
    if (searchTerm) {
      docs = docs.filter((d) => d.title.toLowerCase().includes(searchTerm));
    }

    if (docs.length === 0) {
      container.innerHTML = `
        <div class="p-12 text-center text-deep-text/50">
          <p class="text-lg">${t('page.admin.documents.noDocuments')}</p>
          <p class="text-sm mt-1">${t('page.admin.documents.emptyHint')}</p>
        </div>
      `;
      return;
    }

    const statusLabels: Record<string, string> = {
      published: t('page.admin.documents.published'),
      archived: t('page.admin.documents.archived'),
      draft: t('page.admin.documents.draft'),
    };

    container.innerHTML = docs
      .map(
        (doc) => `
      <div class="flex items-center justify-between p-4 border-b border-surface-3 last:border-b-0 hover:bg-page-bg transition-colors group">
        <a href="${buildUrl('/editor')}?id=${encodeURIComponent(doc.id)}" class="flex-1 min-w-0">
          <h3 class="font-medium truncate">${escapeHtml(doc.title)}</h3>
          <p class="text-xs text-deep-text/50 mt-1">
            ${new Date(doc.lastModified).toLocaleString('zh-CN')} ·
            <span class="badge badge-xs ${doc.status === 'published' ? 'badge-success' : doc.status === 'archived' ? 'badge-error' : 'badge-ghost'}">${statusLabels[doc.status] ?? doc.status}</span>
          </p>
        </a>
        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
          <button
            class="btn btn-ghost btn-xs text-error"
            data-doc-id="${doc.id}"
            data-doc-title="${escapeHtml(doc.title)}"
            onclick="handleDelete(this.dataset.docId, this.dataset.docTitle)"
            title="${t('common.delete')}"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
            </svg>
          </button>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-deep-text/30">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </div>
      </div>
    `
      )
      .join('');
  }

  /** 这个模板同时把值放进文本节点和属性：引号也必须转义，
      否则被篡改的 title 可从 `data-doc-title="…"` 里逃逸注入属性 */
  function escapeHtml(text: string): string {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // 模板里的 oninput/onchange 在全局作用域求值，模块作用域的函数必须显式挂到 window
  (window as unknown as Record<string, () => void>).renderList = renderList;

  (window as unknown as Record<string, (id: string, title: string) => void>).handleDelete = function (
    id: string,
    title: string
  ) {
    if (window.confirm(t('page.admin.documents.deleteConfirm', { title }))) {
      deleteDocument(id);
      renderList();
    }
  };

  renderList();
</script>
