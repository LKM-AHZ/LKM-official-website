---
import { AdminLayout } from '~/features/admin';
import BotSettings from '~/features/admin/components/BotSettings.vue';
import { t } from '~/lib/i18n';

const ticket = (Astro.locals as { botTicket?: string }).botTicket;
---

<AdminLayout>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-deep-text">{t('page.admin.bot.settings.title')}</h1>
  </div>
  <BotSettings client:load ticket={ticket} />
</AdminLayout>
