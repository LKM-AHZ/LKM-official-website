---
import { AdminLayout } from '~/features/admin';
import BotList from '~/features/admin/components/BotList.vue';
import { t } from '~/lib/i18n';

const ticket = (Astro.locals as { botTicket?: string }).botTicket;
const columns = [
  { key: 'name', label: t('page.admin.bot.common.name') },
  { key: 'subtitle', label: t('page.admin.bot.common.version') },
];
---

<AdminLayout>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-deep-text">{t('page.admin.bot.extensions.title')}</h1>
  </div>
  <BotList
    client:load
    listPath="/api/v1/admin/bot/plugins"
    toggleBase="/api/v1/admin/bot/plugins/"
    hashRoute="/plugins"
    ticket={ticket}
    titleKey="page.admin.bot.extensions.title"
    columns={columns}
  />
</AdminLayout>
