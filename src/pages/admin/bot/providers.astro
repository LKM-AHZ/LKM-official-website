---
import { AdminLayout } from '~/features/admin';
import BotList from '~/features/admin/components/BotList.vue';
import { t } from '~/lib/i18n';

const ticket = (Astro.locals as { botTicket?: string }).botTicket;
const columns = [
  { key: 'name', label: t('page.admin.bot.common.name') },
  { key: 'type', label: t('page.admin.bot.common.type') },
  { key: 'model', label: t('page.admin.bot.common.model') },
];
---

<AdminLayout>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-deep-text">{t('page.admin.bot.providers.title')}</h1>
  </div>
  <BotList
    client:load
    listPath="/api/v1/admin/bot/providers"
    toggleBase="/api/v1/admin/bot/providers/"
    hashRoute="/providers"
    ticket={ticket}
    titleKey="page.admin.bot.providers.title"
    columns={columns}
  />
</AdminLayout>
