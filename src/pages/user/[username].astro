---
import MainGridLayout from "~/layouts/BlogMainGridLayout.astro";
import { UserProfile } from "~/features/profile";

const { username } = Astro.params;
const displayName = username || "";
---

<MainGridLayout username={username} title={displayName} description="">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <div
    class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <UserProfile client:load username={username || ""} />
    </div>
  </div>
</MainGridLayout>
