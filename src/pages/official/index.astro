          iconName: 'tabler:alert-triangle',
        },
        {
          year: '2026.06',
          title: t('page.home.timeline.items.rebirth.title'),
          description: t('page.home.timeline.items.rebirth.description'),
          iconName: 'tabler:refresh',
        },
      ]}
    />
  </Section>

  <Section
    id="update"
    title={t('page.home.update.title')}
    subtitle={t('page.home.update.subtitle')}
    classes={{ container: '' }}
  >
    <BlogLatestPostsClient client:visible articles={latestArticles}>
      <p class="text-gray-500">{t('page.home.update.loading')}</p>
    </BlogLatestPostsClient>
  </Section>

  <!-- 常见问题部件 -->

  <FAQs
    id="faq"
    title={t('page.home.faq.title')}
    subtitle={t('page.home.faq.subtitle')}
    classes={{ container: 'max-w-4xl mx-auto' }}
    items={[
      {
        title: t('page.home.faq.whatIs.title'),
        description: t('page.home.faq.whatIs.description'),
      },
      {
        title: t('page.home.faq.howToJoin.title'),
        description: t('page.home.faq.howToJoin.description'),
      },
      {
        title: t('page.home.faq.activities.title'),
        description: t('page.home.faq.activities.description'),
      },
      {
        title: t('page.home.faq.build.title'),
        description: t('page.home.faq.build.description'),
      },
      {
        title: t('page.home.faq.officialSite.title'),
        description: t('page.home.faq.officialSite.description'),
      },
      {
        title: t('page.home.faq.contact.title'),
        description: t('page.home.faq.contact.description'),
      },
    ]}
  />
</Layout>
