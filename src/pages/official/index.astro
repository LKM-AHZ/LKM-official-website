          title: t('page.home.timeline.items.officialGroupsReorganized.title'),
          description: t('page.home.timeline.items.officialGroupsReorganized.description'),
          iconName: 'tabler:users-group',
        },
        {
          year: '2025.04',
          title: t('page.home.timeline.items.teamAndWebsite.title'),
          description: t('page.home.timeline.items.teamAndWebsite.description'),
          iconName: 'tabler:database',
        },
        {
          year: '2025.04.02',
          title: t('page.home.timeline.items.eventPlanningDept.title'),
          description: t('page.home.timeline.items.eventPlanningDept.description'),
          iconName: 'tabler:calendar-event',
        },
        {
          year: '2025.07 ~ 2025.08',
          title: t('page.home.timeline.items.firstSummerEvent.title'),
          description: t('page.home.timeline.items.firstSummerEvent.description'),
          iconName: 'tabler:sun',
        },
        {
          year: '2025.08.04',
          title: t('page.home.timeline.items.databaseWipe.title'),
          description: t('page.home.timeline.items.databaseWipe.description'),
