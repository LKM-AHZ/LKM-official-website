---
import Layout from '~/layouts/OfficialLayout.astro'; 

import { getPermalink } from '~/lib/utils/permalinks'; 

import { t } from '~/lib/i18n';

import Hero from '~/features/homepage/components/Hero.astro';
import BlogLatestPostsClient from '~/features/homepage/components/BlogLatestPostsClient.vue';

import { avatarUrl } from '~/lib/utils/avatars';

import FAQs from '~/features/homepage/components/FAQs.astro';
import ClockTimeline from '~/features/homepage/components/ClockTimeline.astro';
import Section from '~/features/homepage/components/Section.astro';

import { ssrFetch } from '~/lib/fetch-ssr';

import {
  NEWS_CATEGORY_SLUGS,
  type OfficialArticle,
  type OfficialArticleListData,
} from '~/lib/api/modules/official-articles';

const metadata = {
  title: t('page.home.metaTitle'),
  ignoreTitleTemplate: true,
};

// 首页「最新新闻」服务端取数（3 秒超时 + 失败降级为空数组，避免后端不可用拖慢/崩首屏）。
// 取多页后按三大新闻分类（官方公告/科技新闻/科普相关）过滤，只把新闻类文章上首页。
const { data: latestData } = await ssrFetch<OfficialArticleListData>(
  '/api/v1/articles?page=1&page_size=30',
  { fallback: { items: [], total: 0 } },
);

// 日期在服务端格式化为确定文本，组件直接渲染，客户端不再复算
function formatHomeDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const latestArticles = (latestData?.items ?? [])
  // 仅保留三大新闻分类
  .filter((a: OfficialArticle) => NEWS_CATEGORY_SLUGS.includes(a.category))
  .slice(0, 6)
  .map((a: OfficialArticle) => ({
    slug: a.slug,
    title: a.title,
    description: a.description,
    cover: a.cover,
    publishedText: formatHomeDate(a.published),
  }));
---

<Layout metadata={metadata} navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}>
  <!-- Hero 部件 -->

  <Hero
    id="intro"
    actions={[
      {
        variant: 'primary',
        text: t('page.home.hero.communityIntro'),
        href: getPermalink('/blog/about'),
        target: '_self',
        icon: 'tabler:arrow-right',
      },
      {
        variant: 'primary',
        text: t('page.home.hero.seekHelp'),
        href: getPermalink('/official/articles'),
        target: '_self',
        icon: 'tabler:book',
      },
    ]}
  >
    <Fragment slot="title">
      <div class="flex flex-col gap-4">
        <div
          class="text-[#6C2AD8] dark:text-primary text-[40px] md:text-[56px] font-semibold leading-[1.07] tracking-[-0.005em] [text-shadow:0_0_1px_var(--color-primary-content)]"
        >
          {t('page.home.hero.title')}
        </div>

        <div
          class="block mb-1 font-semibold tracking-[-0.005em] text-deep-text [text-shadow:0_0_1px_var(--color-base-content)]"
        >
          {t('page.home.hero.subtitle')}
        </div>
      </div>
    </Fragment>
    <Fragment slot="subtitle">
      <div class="inline-block bg-card-bg/30 backdrop-blur-md rounded-lg px-3 py-1 mb-2">
        <span class="text-[17px] font-normal text-text-muted leading-relaxed"> {t('page.home.hero.badge')} </span>
      </div>

      <!-- 小屏简短版 -->
      <div class="sm:hidden bg-card-bg/30 backdrop-blur-md rounded-lg px-3 py-1.5">
        <span class="text-[13px] text-text-muted leading-relaxed">
          <strong class="font-semibold text-primary mr-1">Here!</strong>
          {t('page.home.hero.short')}
        </span>
      </div>
      <!-- 桌面完整版 -->
      <div class="hidden sm:inline-block bg-card-bg/30 backdrop-blur-md rounded-lg px-3 py-1.5">
        <span class="text-[14px] text-text-muted leading-relaxed">
          <strong class="font-semibold text-primary mr-1">Here!</strong>
          {t('page.home.hero.long')}
        </span>
      </div>
    </Fragment>
  </Hero>

  {/* ===== 如下板块将由清汉维护 ===== */}
  <!-- 资源导航入口 -->
  <Section id="resources-entry" classes={{ container: 'bg-card-bg' }}>
    <div class="max-w-4xl mx-auto text-center">
      <a href={getPermalink('resources')} class="profile-card group inline-block w-full sm:w-auto">
        <div class="profile-inner p-8 flex flex-col items-center gap-4">
          <span class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center text-2xl">📚</span>
          <h3 class="text-xl font-bold text-deep-text group-hover:text-primary transition-colors">
            {t('page.home.resources.title')}
          </h3>
          <p class="text-sm text-text-muted max-w-md">{t('page.home.resources.desc')}</p>
          <span class="mt-2 inline-flex items-center gap-1 text-sm text-primary font-medium">
            {t('page.home.resources.goTo')}
          </span>
        </div>
      </a>
    </div>
  </Section>
  <!-- 截至此处 -->

  <!-- 推荐板块 -->
  <Section id="recommend" classes={{ container: '' }}>
    <div class="max-w-7xl mx-auto">
      <h2 class="text-2xl font-bold text-deep-text text-center mb-2">{t('page.home.explore.title')}</h2>
      <p class="text-sm text-text-muted text-center mb-6">{t('page.home.explore.subtitle')}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href={getPermalink('/community/forum/basic-science')} class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center"
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary"
                ><circle cx="12" cy="12" r="3"></circle><path d="M12 2v4"></path><path d="M12 18v4"></path><path
                  d="M2 12h4"></path><path d="M18 12h4"></path><path d="m4.93 4.93 2.83 2.83"></path><path
                  d="m16.24 16.24 2.83 2.83"></path><path d="m4.93 19.07 2.83-2.83"></path><path
                  d="m16.24 7.76 2.83-2.83"></path></svg
              ></span
            >
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">
              {t('page.home.explore.basicScience')}
            </h3>
            <p class="text-xs text-text-muted">{t('page.home.explore.stats', { members: '1.2k', posts: '45' })}</p>
          </div>
        </a>
        <a href={getPermalink('/community/forum/applied-science')} class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center"
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary"
                ><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"
                ></line><line x1="12" y1="17" x2="12" y2="21"></line></svg
              ></span
            >
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">
              {t('page.home.explore.appliedScience')}
            </h3>
            <p class="text-xs text-text-muted">{t('page.home.explore.stats', { members: '890', posts: '32' })}</p>
          </div>
        </a>
        <a href={getPermalink('/community/forum/hobby')} class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center"
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary"
                ><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line
                  x1="9"
                  y1="9"
                  x2="9.01"
                  y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg
              ></span
            >
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">
              {t('page.home.explore.hobbies')}
            </h3>
            <p class="text-xs text-text-muted">{t('page.home.explore.stats', { members: '520', posts: '28' })}</p>
          </div>
        </a>
        <a href={getPermalink('/blog')} class="profile-card group">
          <div class="profile-inner p-5 flex flex-col items-center text-center gap-2">
            <span class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center"
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary"
                ><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path
                  d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg
              ></span
            >
            <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">
              {t('page.home.explore.columns')}
            </h3>
            <p class="text-xs text-text-muted">{t('page.home.explore.columnsStats')}</p>
          </div>
        </a>
      </div>
    </div>
  </Section>

  <Section
    title={t('page.home.members.title')}
    subtitle={t('page.home.members.subtitle')}
    id="team"
    classes={{ container: 'bg-card-bg' }}
  >
    <div class="grid gap-5 md:gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          {
            name: t('page.home.members.julyO.name'),
            desc: t('page.home.members.julyO.desc'),
            avatar: avatarUrl('七月O.png'),
          },
          {
            name: t('page.home.members.julyHua.name'),
            desc: t('page.home.members.julyHua.desc'),
            avatar: avatarUrl('七月花.jpg'),
          },
          {
            name: t('page.home.members.julyMoran.name'),
            desc: t('page.home.members.julyMoran.desc'),
            avatar: avatarUrl('七月墨染.png'),
          },
          {
            name: t('page.home.members.julyYuli.name'),
            desc: t('page.home.members.julyYuli.desc'),
            avatar: avatarUrl('七月郁离.png'),
          },
          {
            name: t('page.home.members.julyYouzhi.name'),
            desc: t('page.home.members.julyYouzhi.desc'),
            avatar: avatarUrl('七月有枝.jpeg'),
          },
        ].map((m) => (
          <a href={getPermalink('/official/team')} class="profile-card ">
            <div class="profile-inner p-4 sm:p-5 flex flex-row items-center gap-3 sm:flex-col sm:items-center text-left sm:text-center rounded-lg">
              <img
                src={m.avatar}
                alt={m.name}
                width={96}
                height={96}
                class="w-10 h-10 sm:w-16 sm:h-16 rounded-full object-cover shrink-0 sm:mb-3"
                loading="lazy"
                decoding="async"
              />
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-lg text-deep-text">{m.name}</h3>
                <p class="text-xs text-text-muted mt-1">{m.desc}</p>
              </div>
            </div>
          </a>
        ))
      }
      <a href={getPermalink('/official/team')} class="profile-card">
        <div
          class="profile-inner p-4 sm:p-5 flex flex-col items-center justify-center text-center gap-3 min-h-full rounded-lg"
        >
          <span class="text-lg font-bold text-deep-text">{t('page.home.members.more')}</span>
          <span class="text-xs text-text-muted">{t('page.home.members.moreHint')}</span>
          <span
            class="not-hover-color inline-flex items-center justify-center rounded-full px-5 py-2 text-sm font-semibold leading-6 text-on-primary bg-primary"
            >{t('page.home.members.viewAll')}</span
          >
        </div>
      </a>
    </div>
  </Section>

  <Section title={t('page.home.timeline.title')} subtitle={t('page.home.timeline.subtitle')} id="timeline">
    <ClockTimeline
      items={[
        {
          year: '2014.08.01',
          title: t('page.home.timeline.items.founding.title'),
          description: t('page.home.timeline.items.founding.description'),
          iconName: 'tabler:star',
        },
        {
          year: '2014 ~ 2016',
          title: t('page.home.timeline.items.expansion.title'),
          description: t('page.home.timeline.items.expansion.description'),
          iconName: 'tabler:users-plus',
        },
        {
          year: '2015 ~ 2016',
          title: t('page.home.timeline.items.subjectGroups.title'),
          description: t('page.home.timeline.items.subjectGroups.description'),
          iconName: 'tabler:folders',
        },
        {
          year: '2016',
          title: t('page.home.timeline.items.interestGroups.title'),
          description: t('page.home.timeline.items.interestGroups.description'),
          iconName: 'tabler:puzzle',
        },
        {
          year: '2017 ~ 2018',
          title: t('page.home.timeline.items.websitePlanning.title'),
          description: t('page.home.timeline.items.websitePlanning.description'),
          iconName: 'tabler:file-text',
        },
        {
          year: '2018',
          title: t('page.home.timeline.items.founderStepsBack.title'),
          description: t('page.home.timeline.items.founderStepsBack.description'),
          iconName: 'tabler:shield-check',
        },
        {
          year: '2018.02',
          title: t('page.home.timeline.items.julyTeamEarly.title'),
          description: t('page.home.timeline.items.julyTeamEarly.description'),
          iconName: 'tabler:building-community',
        },
        {
          year: '2019.08.15',
          title: t('page.home.timeline.items.qianxunJoins.title'),
          description: t('page.home.timeline.items.qianxunJoins.description'),
          iconName: 'tabler:user-plus',
        },
        {
          year: '2020',
          title: t('page.home.timeline.items.qianxunStepsBack.title'),
          description: t('page.home.timeline.items.qianxunStepsBack.description'),
          iconName: 'tabler:user-minus',
        },
        {
          year: '2024.04.19',
          title: t('page.home.timeline.items.rebuildSeed.title'),
          description: t('page.home.timeline.items.rebuildSeed.description'),
          iconName: 'tabler:message-heart',
        },
        {
          year: '2024.07.30',
