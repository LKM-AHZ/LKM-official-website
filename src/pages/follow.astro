---
import Layout from "~/layouts/PageLayout.astro";
import PageIntro from "~/components/patterns/PageIntro.astro";
import { FollowingPage } from "~/features/follow";
import { t } from "~/lib/i18n";

// 词典里没有 page.follow.metaTitle（会渲染成原始 key），关注页文案在 page.official.follow 下
const metadata = { title: t("page.official.follow.metaTitle") };
---

<Layout metadata={metadata}>
  <div class="site-content-frame max-w-4xl min-h-[400px]">
    <PageIntro title={t("nav.follow")} icon="tabler:heart" />
    <FollowingPage client:load />
  </div>
</Layout>
