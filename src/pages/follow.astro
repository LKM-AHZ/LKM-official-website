---
import Layout from '~/layouts/PageLayout.astro';
import { FollowingPage } from '~/features/follow';
import { t } from '~/lib/i18n';

// 词典里没有 page.follow.metaTitle（会渲染成原始 key），关注页文案在 page.official.follow 下
const metadata = { title: t('page.official.follow.metaTitle') };
---

<Layout metadata={metadata}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 min-h-[400px]">
    <FollowingPage client:load />
  </div>
</Layout>
