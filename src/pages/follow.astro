---
import Layout from '~/layouts/PageLayout.astro';
import { FollowingPage } from '~/features/follow';
import { t } from '~/lib/i18n';

const metadata = { title: t('page.follow.metaTitle') };
---

<Layout metadata={metadata}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8" style="min-height: 400px">
    <FollowingPage client:load />
  </div>
</Layout>
