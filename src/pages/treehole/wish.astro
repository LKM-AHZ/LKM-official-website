---
import Layout from "~/layouts/PageLayout.astro";
import WishPage from "~/features/anonymous-letter/pages/WishPage.vue";
import "~/features/anonymous-letter/styles/global.css";
import { t } from "~/lib/i18n";
import type { MetaData } from "~/types/core";
const metadata: MetaData = {
  title: t("page.treehole.wishTitle"),
  description: t("page.treehole.wishDescription"),
};
---

<Layout metadata={metadata} showFooter={false}>
  <div class="min-h-[calc(100dvh-4.5rem)]"><WishPage client:load /></div>
</Layout>
