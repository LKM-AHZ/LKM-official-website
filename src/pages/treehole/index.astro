---
import Layout from "~/layouts/BaseLayout.astro";
import HomePage from "~/features/anonymous-letter/pages/HomePage.vue";
import "~/features/anonymous-letter/styles/global.css";
import { allMenuItems } from "~/features/shell/menus";
import { filterNavbarByNames } from "~/lib/navigation";
import { t } from "~/lib/i18n";
import type { MetaData } from "~/types/core";

const metadata: MetaData = {
  title: t("page.treehole.homeTitle"),
  description: t("page.treehole.homeDescription"),
};
---

<Layout
  metadata={metadata}
  navbarLinks={filterNavbarByNames(allMenuItems, [
    "nav.community",
    "nav.blog",
    "nav.resources",
    "nav.mine",
  ])}
>
  <div style="min-height: 400px"><HomePage client:load /></div>
</Layout>

<script is:inline>
  // 在 Vue 组件 mount 前强制同步主题和色相——确保 CSS 变量在首次渲染时就正确
  (function () {
    const theme = localStorage.theme;
    const isDark =
      theme === "dark" ||
      (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.classList.toggle("dark", isDark);
    const hue = localStorage.getItem("hue");
    if (hue) document.documentElement.style.setProperty("--hue", hue);
  })();
</script>
