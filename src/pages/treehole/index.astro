---
import Layout from "~/layouts/PageLayout.astro";
import HomePage from "~/features/anonymous-letter/pages/HomePage.vue";
import "~/features/anonymous-letter/styles/global.css";
import { t } from "~/lib/i18n";
import type { MetaData } from "~/types/core";

const metadata: MetaData = {
  title: t("page.treehole.homeTitle"),
  description: t("page.treehole.homeDescription"),
};
---

<Layout metadata={metadata} showFooter={false}>
  <div class="min-h-[calc(100dvh-4.5rem)]"><HomePage client:load /></div>
</Layout>
