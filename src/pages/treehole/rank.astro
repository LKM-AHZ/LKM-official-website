---
import Layout from "~/layouts/PageLayout.astro";
import RankPage from "~/features/anonymous-letter/pages/RankPage.vue";
import "~/features/anonymous-letter/styles/global.css";
import { t } from "~/lib/i18n";
import type { MetaData } from "~/types/core";
const metadata: MetaData = {
  title: t("page.treehole.rankTitle"),
  description: t("page.treehole.rankDescription"),
};
---

<Layout metadata={metadata} showFooter={false}>
  <div class="min-h-[calc(100dvh-4.5rem)]"><RankPage client:load /></div>
</Layout>
