---
import Layout from "~/layouts/PageLayout.astro";
import SettingsPage from "~/features/anonymous-letter/pages/SettingsPage.vue";
import "~/features/anonymous-letter/styles/global.css";
import { t } from "~/lib/i18n";
import type { MetaData } from "~/types/core";
const metadata: MetaData = {
  title: t("page.treehole.settingsTitle"),
  description: t("page.treehole.settingsDescription"),
};
---

<Layout metadata={metadata} showFooter={false}>
  <div class="min-h-[calc(100dvh-4.5rem)]"><SettingsPage client:load /></div>
</Layout>
