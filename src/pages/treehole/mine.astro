---
import Layout from "~/layouts/PageLayout.astro";
import MinePage from "~/features/anonymous-letter/pages/MinePage.vue";
import "~/features/anonymous-letter/styles/global.css";
import { t } from "~/lib/i18n";
import type { MetaData } from "~/types/core";
const metadata: MetaData = {
  title: t("page.treehole.mineTitle"),
  description: t("page.treehole.mineDescription"),
};
---

<Layout metadata={metadata} showFooter={false}>
  <div class="min-h-[calc(100dvh-4.5rem)]"><MinePage client:load /></div>
</Layout>
