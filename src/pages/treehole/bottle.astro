---
import Layout from "~/layouts/PageLayout.astro";
import BottlePage from "~/features/anonymous-letter/pages/BottlePage.vue";
import "~/features/anonymous-letter/styles/global.css";
import { t } from "~/lib/i18n";
import type { MetaData } from "~/types/core";
const metadata: MetaData = {
  title: t("page.treehole.bottleTitle"),
  description: t("page.treehole.bottleDescription"),
};
---

<Layout metadata={metadata} showFooter={false}>
  <div class="min-h-[calc(100dvh-4.5rem)]"><BottlePage client:load /></div>
</Layout>
