---
import Layout from "~/layouts/PageLayout.astro";
import RandomPage from "~/features/anonymous-letter/pages/RandomPage.vue";
import "~/features/anonymous-letter/styles/global.css";
import { t } from "~/lib/i18n";
import type { MetaData } from "~/types/core";
const metadata: MetaData = {
  title: t("page.treehole.randomTitle"),
  description: t("page.treehole.randomDescription"),
};
---

<Layout metadata={metadata} showFooter={false}>
  <div class="min-h-[calc(100dvh-4.5rem)]"><RandomPage client:load /></div>
</Layout>
