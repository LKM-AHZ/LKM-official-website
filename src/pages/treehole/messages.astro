---
import Layout from "~/layouts/PageLayout.astro";
import MessagesPage from "~/features/anonymous-letter/pages/MessagesPage.vue";
import "~/features/anonymous-letter/styles/global.css";
import { t } from "~/lib/i18n";
import type { MetaData } from "~/types/core";
const metadata: MetaData = {
  title: t("page.treehole.messagesTitle"),
  description: t("page.treehole.messagesDescription"),
};
---

<Layout metadata={metadata} showFooter={false}>
  <div class="min-h-[calc(100dvh-4.5rem)]"><MessagesPage client:load /></div>
</Layout>
