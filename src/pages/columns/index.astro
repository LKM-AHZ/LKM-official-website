---
import Layout from '~/layouts/CommunitySidebarLayout.astro';
import { Icon } from 'astro-icon/components';
import { columnApi } from '~/features/column';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

// SSR 拉取后端专栏列表；接口不可用/无数据时降级为空数组（页面显示空态而非崩溃）
const columns = await columnApi.getColumns();

const metadata = { title: `${t('community.columns.title')} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink('/columns')}
  navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}
>
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold text-deep-text">{t('community.columns.title')}</h1>
      <p class="text-text-muted mt-2">{t('community.columns.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        columns.map((col) => (
          <a href={getPermalink(`/columns/${col.slug}`)} class="profile-card group overflow-hidden flex flex-col">
            {/* 封面区 */}
            <div class="h-36 bg-gradient-to-br from-primary/20 via-primary/10 to-surface-3 flex items-center justify-center relative">
              {col.isVerified && (
                <span class="absolute top-3 right-3 inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950/30 text-amber-600 dark:text-amber-400 font-medium">
                  <Icon name="tabler:rosette" class="w-3 h-3" />
                  {t('community.columns.verified')}
                </span>
              )}
              <Icon name="tabler:article" class="w-12 h-12 text-primary/40" />
            </div>
            <div class="p-5 flex flex-col gap-2 flex-1">
              <h3 class="font-bold text-lg text-deep-text group-hover:text-primary transition-colors line-clamp-1">
                {col.title}
              </h3>
              <div class="flex items-center gap-2 text-xs text-text-muted/60">
                <span>{col.authorName ?? '—'}</span>
                <span>·</span>
                <span class="text-text-muted">{col.authorTitle ?? ''}</span>
              </div>
              <p class="text-sm text-text-muted line-clamp-2 leading-relaxed flex-1">{col.description}</p>
              <div class="flex items-center justify-between text-xs text-text-muted/60 pt-2 border-t border-surface-3">
                <span>
                  {col.articleCount} {t('community.columns.articles')}
                </span>
                <span>
                  {col.followerCount.toLocaleString()} {t('community.columns.followers')}
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
