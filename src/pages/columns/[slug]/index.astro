---
import Layout from '~/layouts/CommunitySidebarLayout.astro';
import { Icon } from 'astro-icon/components';
import { columnApi } from '~/features/column';
import ColumnArticleList from '~/features/column/components/ColumnArticleList.vue';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const { slug } = Astro.params;
const column = await columnApi.getColumnBySlug(slug || '');

if (!column) {
  return Astro.redirect(getPermalink('/columns'));
}

// 能按 slug 查到专栏说明 slug 参数必非空；传给文章列表组件的是该专栏的可路由标识
const columnSlugValue: string = column.slug ?? slug ?? '';

function formatCount(n: number): string {
  return n.toLocaleString('zh-CN');
}

const metadata = { title: `${column.title} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink(`/columns/${slug}`)}
  navItems={['社区主页', '博客', '资源', '我的']}
>
  <div class="space-y-6">
    <!-- 封面背景 Hero -->
    <div
      class="relative overflow-hidden rounded-2xl border border-surface-3 h-52 md:h-60 bg-gradient-to-br from-primary/40 via-primary/15 to-surface-3"
    >
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent"></div>
      {
        column.isVerified && (
          <span class="absolute top-4 right-4 inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-950/30 text-amber-600 dark:text-amber-400 font-medium">
            <Icon name="tabler:rosette" class="w-3.5 h-3.5" />
            {t('page.communityDetail.verified')}
          </span>
        )
      }
      <h1 class="absolute top-4 left-6 text-xl md:text-2xl font-bold text-white">{column.title}</h1>
      <div class="absolute bottom-4 left-6 flex items-center gap-4">
        <div
          class="w-16 h-16 rounded-full bg-white/20 backdrop-blur border border-white/30 flex items-center justify-center text-white font-bold text-2xl shrink-0"
        >
          {(column.authorName ?? '专').charAt(0)}
        </div>
        <div>
          <p class="text-white font-semibold text-lg leading-tight">{column.authorName ?? '专栏作者'}</p>
          <p class="text-white/80 text-sm mt-0.5">{column.authorTitle ?? ''}</p>
        </div>
      </div>
    </div>

    <!-- 数据统计条 -->
    <div class="grid grid-cols-3 gap-4">
      <div class="bg-card-bg border border-surface-3 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-deep-text">{formatCount(column.articleCount)}</div>
        <div class="text-xs text-text-muted mt-1">
          {t('page.communityDetail.articlesCount', { count: formatCount(column.articleCount) })}
        </div>
      </div>
      <div class="bg-card-bg border border-surface-3 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-deep-text">{formatCount(column.likeCount)}</div>
        <div class="text-xs text-text-muted mt-1">
          {t('page.communityDetail.likedCount', { count: formatCount(column.likeCount) })}
        </div>
      </div>
      <div class="bg-card-bg border border-surface-3 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-deep-text">{formatCount(column.subscribeCount)}</div>
        <div class="text-xs text-text-muted mt-1">
          {t('page.communityDetail.subscribedCount', { count: formatCount(column.subscribeCount) })}
        </div>
      </div>
    </div>

    <!-- 作者权威卡 -->
    <div class="bg-card-bg border border-surface-3 rounded-2xl p-6">
      <div class="flex items-start gap-4">
        <div
          class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-xl shrink-0"
        >
          {(column.authorName ?? '专').charAt(0)}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-semibold text-deep-text">{column.authorName ?? '专栏作者'}</span>
            <span class="text-sm text-text-muted">{column.authorTitle ?? ''}</span>
          </div>
          <div class="flex flex-wrap items-center gap-1.5 mt-2">
            {
              column.badges.map((badge) => (
                <span class="text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary">{badge}</span>
              ))
            }
            <span class="text-xs px-2 py-0.5 rounded-full bg-surface-3 text-text-muted">
              {t('page.communityDetail.fansCount', { count: formatCount(column.followerCount) })}
            </span>
          </div>
          <p class="text-sm text-text-muted mt-3 leading-relaxed">{column.authorBio ?? ''}</p>
        </div>
      </div>
    </div>

    <!-- 专栏介绍 -->
    <div class="bg-card-bg border border-surface-3 rounded-2xl p-6">
      <h2 class="font-bold text-deep-text mb-2">{t('page.communityDetail.introTitle')}</h2>
      <p class="text-sm text-text-muted leading-relaxed">{column.description}</p>
    </div>

    <!-- 标签（板块标签突出） -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center gap-1 text-xs px-3 py-1 rounded-full bg-primary text-white font-medium">
        <Icon name="tabler:category" class="w-3.5 h-3.5" />
        {column.boardTag ?? '专栏'}
      </span>
      {column.tags.map((tag) => <span class="text-xs px-3 py-1 rounded-full bg-surface-3 text-text-muted">{tag}</span>)}
    </div>

    <!-- 文章列表 -->
    <div style="min-height: 400px">
      <ColumnArticleList columnSlug={columnSlugValue} client:load />
    </div>
  </div>
</Layout>
