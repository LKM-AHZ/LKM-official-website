---
import Layout from '~/layouts/CommunitySidebarLayout.astro';
import { Icon } from 'astro-icon/components';
import { columnApi } from '~/features/column';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import { getPermalink } from '~/lib/utils/permalinks';
import { sanitizeHtmlContent } from '~/lib/utils/html-sanitize';
import { t } from '~/lib/i18n';

const { slug, articleId } = Astro.params;
const column = await columnApi.getColumnBySlug(slug || '');
const article = await columnApi.getArticleById(slug || '', Number(articleId) || 0);

if (!column || !article) {
  return Astro.redirect(getPermalink('/columns'));
}

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

// 同专栏其他文章
const otherArticles = (await columnApi.getArticlesBySlug(slug || ''))
  .filter((a) => a.id !== article.id)
  .slice(0, 4);

const metadata = { title: `${article.title} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink(`/columns/${slug}`)}
  navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}
>
  <div class="max-w-3xl mx-auto">
    <!-- 面包屑 -->
    <div class="flex items-center gap-2 text-sm text-text-muted/60 mb-6">
      <a href={getPermalink('/columns')} class="hover:text-primary transition-colors">
        {t('page.communityDetail.columns')}
      </a>
      <Icon name="tabler:chevron-right" class="w-3.5 h-3.5" />
      <a href={getPermalink(`/columns/${column.slug}`)} class="hover:text-primary transition-colors"
        >{column.title}</a
      >
    </div>

    <!-- 文章头 -->
    <header class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-deep-text leading-tight">{article.title}</h1>
      <div class="flex flex-wrap items-center gap-3 mt-4 text-sm text-text-muted/60">
        <span>{column.authorName ?? '专栏作者'}</span>
        <span>·</span>
        <span>{formatDate(article.publishedAt)}</span>
      </div>
      {
        column.boardTag && (
          <div class="flex flex-wrap gap-1.5 mt-3">
            <span class="text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary">{column.boardTag}</span>
          </div>
        )
      }
    </header>

    <!-- 正文 沉浸式阅读 -->
    <div class="prose dark:prose-invert max-w-none prose-lg">
      <Fragment set:html={sanitizeHtmlContent(article.content)} />
    </div>

    <!-- 底部信息 -->
    <div class="mt-10 pt-6 border-t border-surface-3">
      <div class="flex items-center justify-between text-sm text-text-muted/60">
        <span
          >{
            t('page.communityDetail.stats', {
              views: article.viewCount,
              likes: article.likeCount,
              comments: article.commentCount,
            })
          }</span
        >
      </div>
    </div>

    <!-- 作者卡片 -->
    <div class="mt-6 bg-card-bg border border-surface-3 rounded-xl p-5 flex items-start gap-4">
      <div
        class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-xl shrink-0"
      >
        {(column.authorName ?? '专').charAt(0)}
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-semibold text-deep-text">{column.authorName ?? '专栏作者'}</span>
          {
            column.isVerified && (
              <span class="inline-flex items-center gap-1 text-xs px-1.5 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950/30 text-amber-600 dark:text-amber-400 font-medium">
                <Icon name="tabler:rosette" class="w-3 h-3" />
                {t('page.communityDetail.verified')}
              </span>
            )
          }
        </div>
        <p class="text-sm text-text-muted mt-0.5">{column.authorTitle ?? ''}</p>
        <p class="text-sm text-text-muted/60 mt-1">{column.authorBio ?? ''}</p>
      </div>
    </div>

    <!-- 同专栏其他文章 -->
    {
      otherArticles.length > 0 && (
        <div class="mt-8 pt-6 border-t border-surface-3">
          <h3 class="font-semibold text-deep-text mb-4">{t('page.communityDetail.otherInColumn')}</h3>
          <div class="space-y-3">
            {otherArticles.map((a) => (
              <a
                href={getPermalink(`/columns/${column.slug}/${a.id}`)}
                class="block p-3 rounded-lg hover:bg-surface-3/50 transition-colors"
              >
                <div class="font-medium text-deep-text hover:text-primary transition-colors">{a.title}</div>
                <div class="text-xs text-text-muted/60 mt-1">{formatDate(a.publishedAt)}</div>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</Layout>
