---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = {
  title: t('page.admin.documents.editorMetaTitle'),
  description: t('page.admin.documents.editorMetaDescription'),
};
---

<BaseLayout metadata={metadata}>
  <div class="h-screen flex flex-col p-3">
    <div class="mb-3 flex items-center gap-3 shrink-0">
      <a href={getPermalink('/admin/documents')} class="btn btn-ghost btn-sm gap-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        {t('page.admin.documents.backToDocs')}
      </a>
    </div>
    <div id="editor-root" class="flex-1 min-h-0">
      <div class="flex items-center justify-center h-full">
        <span class="loading loading-spinner loading-md"></span>
        <span class="ml-2 text-deep-text/50">{t('page.admin.documents.loadingEditor')}</span>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { createRoot } from 'react-dom/client';
  import { createElement } from 'react';
  import EditorMount from '~/features/editor/components/core/EditorMount';
  import { createLocalPersistence } from '~/features/editor/persistence/index';
  import { createGitPersistence } from '~/features/editor/persistence/git-persistence';

  const rootEl = document.getElementById('editor-root');
  if (rootEl) {
    const root = createRoot(rootEl);
    // 浏览器端解析 URL：带 ?seriesId → Git 系列写作（admin 的 /editor 无 seriesId 保持本地 adapter）
    const params = new URLSearchParams(window.location.search);
    const rawSeriesId = params.get('seriesId');
    if (rawSeriesId && rawSeriesId.trim() !== '') {
      // seriesId 为后端 uuid 字符串，直接透传（不再做数值转换/校验）
      const seriesId = rawSeriesId.trim();
      const path = params.get('path') ?? undefined;
      root.render(
        createElement(EditorMount, {
          adapter: createGitPersistence(seriesId, path),
          seriesId,
          path,
        }),
      );
    } else {
      root.render(
        createElement(EditorMount, { adapter: createLocalPersistence() }),
      );
    }
  }
</script>
