---
import { Icon } from "astro-icon/components";
import Layout from "~/layouts/PageLayout.astro";
import heroImage from "~/assets/images/hero-image.png";
import { getPermalink } from "~/lib/utils/permalinks";
import { OFFICIAL_SITE_URL } from "~/lib/constants/site-urls";

const paths = {
  forum: getPermalink("/forum"),
  files: getPermalink("/files"),
  qa: getPermalink("/qa"),
  projects: getPermalink("/projects"),
  competition: getPermalink("/competition"),
  apps: getPermalink("/apps"),
};

const destinations = [
  {
    number: "01",
    icon: "tabler:messages",
    title: "社区论坛",
    description: "从一个好问题开始，和同好一起讨论科学与技术。",
    href: paths.forum,
    action: "进入论坛",
  },
  {
    number: "02",
    icon: "tabler:folder-open",
    title: "共享资源",
    description: "发现、整理和分享学习资料，让知识更容易抵达。",
    href: paths.files,
    action: "浏览文件库",
  },
  {
    number: "03",
    icon: "tabler:bulb",
    title: "问答交流",
    description: "把还没想明白的事情提出来，和大家一起寻找答案。",
    href: paths.qa,
    action: "去提问题",
  },
];

const moreDestinations = [
  {
    icon: "tabler:rocket",
    title: "项目",
    description: "看看社区里正在发生的创作",
    href: paths.projects,
  },
  {
    icon: "tabler:trophy",
    title: "竞赛",
    description: "在挑战中检验灵感与积累",
    href: paths.competition,
  },
  {
    icon: "tabler:apps",
    title: "更多应用",
    description: "探索理科迷的其他角落",
    href: paths.apps,
  },
];
---

<Layout
  metadata={{
    title: "理科迷 · 让科学回归每一个人",
    description:
      "理科迷是创立于 2014 年的科技爱好者社区。在这里探索科学、分享知识、结识同好。",
  }}
>
  <div class="overflow-hidden">
    <section
      class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 pb-20 pt-16 sm:px-6 md:pb-28 md:pt-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8 lg:pt-28"
    >
      <div class="relative z-10 max-w-2xl">
        <div
          class="mb-7 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3.5 py-2 text-xs font-semibold tracking-wide text-primary-readable"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"
          ></span>
          从好奇出发，向世界提问
        </div>
        <h1
          class="font-heading text-[clamp(2.9rem,6vw,5.5rem)] font-bold leading-[1.13] tracking-tight text-deep-text"
        >
          好奇有方向，<br />
          <span class="text-primary-readable">探索无边界。</span>
        </h1>
        <p class="mt-7 max-w-xl text-base leading-8 text-text-muted sm:text-lg">
          理科迷是一个由科技爱好者组成的社区。无论你热爱数学、自然科学，还是喜欢动手创造，都能在这里找到一起思考的人。
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={paths.forum}
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-primary-action px-6 font-semibold text-white shadow-sm transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-action"
          >
            进入社区 <Icon
              name="tabler:arrow-up-right"
              class="h-5 w-5"
              aria-hidden="true"
            />
          </a>
          <a
            href={paths.files}
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-surface-3 bg-card-bg px-6 font-semibold text-deep-text transition hover:border-primary/50 hover:text-primary-readable focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-action"
          >
            探索资源 <Icon
              name="tabler:arrow-right"
              class="h-5 w-5"
              aria-hidden="true"
            />
          </a>
          <a
            href={OFFICIAL_SITE_URL}
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-surface-3 bg-card-bg px-6 font-semibold text-deep-text transition hover:border-primary/50 hover:text-primary-readable focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-action"
          >
            前往官网 <Icon
              name="tabler:arrow-up-right"
              class="h-5 w-5"
              aria-hidden="true"
            />
          </a>
        </div>
        <div
          class="mt-11 flex items-center gap-4 border-t border-surface-3 pt-6 text-sm text-text-muted"
        >
          <span
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary"
          >
            <Icon name="tabler:atom" class="h-6 w-6" aria-hidden="true" />
          </span>
          <span>始于 2014 年 · 让科学回归每一个人</span>
        </div>
      </div>

      <div
        class="relative isolate mx-auto flex min-h-[400px] w-full max-w-[560px] items-center justify-center sm:min-h-[500px]"
        aria-hidden="true"
      >
        <div class="absolute inset-[8%] rounded-full bg-primary/10 blur-3xl">
        </div>
        <div class="absolute inset-[9%] rounded-full border border-primary/15">
        </div>
        <div class="absolute inset-[19%] rounded-full border border-primary/20">
        </div>
        <div class="absolute inset-[29%] rounded-full border border-primary/20">
        </div>
        <div
          class="absolute left-[6%] top-[17%] h-3 w-3 rounded-full bg-primary/45"
        >
        </div>
        <div
          class="absolute bottom-[14%] right-[13%] h-2.5 w-2.5 rounded-full bg-primary/60"
        >
        </div>
        <img
          src={heroImage.src}
          width={heroImage.width}
          height={heroImage.height}
          alt=""
          fetchpriority="high"
          class="relative z-10 w-[115%] max-w-none drop-shadow-2xl"
        />
        <div
          class="absolute bottom-[8%] left-[2%] z-20 rounded-2xl border border-surface-3 bg-card-bg/95 px-4 py-3 shadow-lg backdrop-blur-sm sm:left-[5%]"
        >
          <div class="flex items-center gap-3">
            <Icon name="tabler:flask-2" class="h-6 w-6 text-primary" />
            <div>
              <strong class="block text-sm text-deep-text">保持好奇</strong
              ><span class="text-xs text-text-muted"
                >每一个发现都从这里开始</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="border-y border-surface-3 bg-card-bg/70 px-4 py-12 sm:px-6"
      aria-label="社区学科"
    >
      <div
        class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-5"
      >
        <p class="text-sm font-semibold text-text-muted">
          在理科迷，尽情探索你感兴趣的领域
        </p>
        <div
          class="flex flex-wrap gap-2 text-xs font-semibold text-deep-text sm:text-sm"
        >
          {
            ["数学", "物理", "化学", "生物", "信息技术"].map((subject) => (
              <span class="rounded-full border border-surface-3 bg-page-bg px-3.5 py-2">
                {subject}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28"
      aria-labelledby="explore-heading"
    >
      <div class="mb-9 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p
            class="mb-3 text-xs font-bold tracking-[0.16em] text-primary-readable"
          >
            EXPLORE LKM
          </p>
          <h2
            id="explore-heading"
            class="font-heading text-3xl font-bold tracking-tight text-deep-text sm:text-4xl"
          >
            从这里开始探索
          </h2>
          <p class="mt-3 max-w-xl leading-7 text-text-muted">
            交流想法、积累知识、一起把兴趣变成新的发现。
          </p>
        </div>
        <a
          href={paths.apps}
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-readable hover:underline"
          >查看全部入口 <Icon
            name="tabler:arrow-right"
            class="h-4 w-4"
            aria-hidden="true"
          /></a
        >
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {
          destinations.map((item) => (
            <a
              href={item.href}
              class="group flex min-h-[260px] flex-col rounded-2xl border border-surface-3 bg-card-bg p-6 transition duration-200 hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <div class="flex items-start justify-between">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <Icon name={item.icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <span class="font-mono text-xs text-text-muted dark:text-slate-400">
                  {item.number} / 03
                </span>
              </div>
              <h3 class="mt-8 text-xl font-bold text-deep-text group-hover:text-primary-readable">
                {item.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-7 text-text-muted dark:text-slate-400">
                {item.description}
              </p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-readable">
                {item.action}
                <Icon
                  name="tabler:arrow-up-right"
                  class="h-4 w-4"
                  aria-hidden="true"
                />
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section
      class="bg-card-bg px-4 py-20 sm:px-6 md:py-24"
      aria-labelledby="more-heading"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-8">
          <p
            class="mb-3 text-xs font-bold tracking-[0.16em] text-primary-readable"
          >
            MORE TO DISCOVER
          </p>
          <h2
            id="more-heading"
            class="font-heading text-3xl font-bold text-deep-text sm:text-4xl"
          >
            把热爱带到更远的地方
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {
            moreDestinations.map((item) => (
              <a
                href={item.href}
                class="group flex items-center gap-4 rounded-2xl border border-surface-3 bg-page-bg p-5 transition hover:border-primary/40 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <Icon name={item.icon} class="h-5 w-5" aria-hidden="true" />
                </span>
                <span class="min-w-0 flex-1">
                  <>
                    <strong class="block text-sm text-deep-text group-hover:text-primary-readable">
                      {item.title}
                    </strong>
                    <small class="mt-1 block text-xs leading-5 text-text-muted">
                      {item.description}
                    </small>
                  </>
                </span>
                <Icon
                  name="tabler:arrow-up-right"
                  class="h-4 w-4 shrink-0 text-text-muted group-hover:text-primary"
                  aria-hidden="true"
                />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28"
      aria-labelledby="join-heading"
    >
      <div
        class="relative overflow-hidden rounded-[2rem] border border-primary/20 bg-primary/10 px-6 py-14 text-center sm:px-12 md:py-20"
      >
        <div
          class="absolute -left-24 -top-24 h-64 w-64 rounded-full border border-primary/20"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute -bottom-32 -right-16 h-80 w-80 rounded-full border border-primary/20"
          aria-hidden="true"
        >
        </div>
        <div class="relative mx-auto max-w-2xl">
          <p
            class="mb-3 text-xs font-bold tracking-[0.16em] text-primary-readable"
          >
            JOIN THE CONVERSATION
          </p>
          <h2
            id="join-heading"
            class="font-heading text-3xl font-bold leading-tight text-deep-text sm:text-4xl"
          >
            下一次精彩的讨论，<br class="hidden sm:block" />从你的好奇开始。
          </h2>
          <p class="mt-5 leading-7 text-text-muted">
            来社区分享一个发现，提出一个问题，或认识志同道合的朋友。
          </p>
          <a
            href={paths.forum}
            class="mt-8 inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-primary-action px-6 font-semibold text-white transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-action"
            >走进理科迷 <Icon
              name="tabler:arrow-right"
              class="h-5 w-5"
              aria-hidden="true"
            /></a
          >
        </div>
      </div>
    </section>
  </div>
</Layout>
