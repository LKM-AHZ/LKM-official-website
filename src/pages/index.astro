---
import { Icon } from "astro-icon/components";
import Layout from "~/layouts/PageLayout.astro";
import { contentApi } from "~/lib/api/modules/content";
import { projectApi } from "~/lib/api/modules/projects";
import { qaApi } from "~/lib/api/modules/qa";
import {
  mockCompetitions,
  mockQuestions,
} from "~/features/competition/data/mock-competitions";
import DemoNotice from "~/components/patterns/DemoNotice.astro";
import { getPermalink } from "~/lib/utils/permalinks";
import { t } from "~/lib/i18n";

const paths = {
  forum: getPermalink("/forum"),
  projects: getPermalink("/projects"),
  files: getPermalink("/files"),
  qa: getPermalink("/qa"),
  competition: getPermalink("/competition"),
  bank: getPermalink("/competition/bank"),
  search: getPermalink("/search"),
};

// 模块独立降级：一个服务暂不可用时仍能展示其他社区内容。
const [questionResult, projectResult, columnResult] = await Promise.allSettled([
  qaApi.listQuestions("help", 1, 12, "bounty"),
  projectApi.listProjects(),
  contentApi.listItems({ content_type: "column_post", limit: 12 }),
]);
const questions =
  questionResult.status === "fulfilled" ? questionResult.value : [];
const projects =
  projectResult.status === "fulfilled" ? projectResult.value : [];
const columnResponse =
  columnResult.status === "fulfilled" ? columnResult.value : null;
const columns = columnResponse?.isOk() ? columnResponse.value.items : [];
const featuredQuestions = questions
  .filter(
    (q) =>
      q.status === "open" &&
      q.bountyTotal > 0 &&
      (!q.bountyExpiresAt || Date.parse(q.bountyExpiresAt) > Date.now()),
  )
  .sort((a, b) => b.bountyTotal - a.bountyTotal)
  .slice(0, 3);
const recruitingProjects = projects
  .filter((project) => project.isRecruiting)
  .sort(
    (a, b) =>
      Number(b.isPinned) - Number(a.isPinned) || b.progress - a.progress,
  )
  .slice(0, 3);
const featuredColumns = columns
  .filter((item) => item.status === "published")
  .sort(
    (a, b) =>
      Number(b.is_featured) - Number(a.is_featured) ||
      b.like_count - a.like_count ||
      Date.parse(b.published_at ?? b.created_at) -
        Date.parse(a.published_at ?? a.created_at),
  )
  .slice(0, 3);
const upcomingCompetition = mockCompetitions
  .filter((item) => item.status === "upcoming" || item.status === "ongoing")
  .sort((a, b) => Date.parse(a.startDate) - Date.parse(b.startDate))[0];
const daysUntil =
  upcomingCompetition?.status === "upcoming"
    ? Math.max(
        0,
        Math.ceil(
          (Date.parse(`${upcomingCompetition.startDate}T00:00:00`) -
            Date.now()) /
            86_400_000,
        ),
      )
    : null;
const dailyQuestion =
  mockQuestions[Math.floor(Date.now() / 86_400_000) % mockQuestions.length];
---

<Layout
  metadata={{
    title: "理科迷 · 发现问题，找到同行",
    description:
      "搜索理科社区的讨论、专栏、资料与题库，发现悬赏求助、项目招募和竞赛。",
  }}
>
  <div class="min-h-screen bg-page-bg pb-20">
    {/* 竞赛倒计时与「每日一题」取自 mock-competitions（R7）；横幅不可关闭 */}
    <DemoNotice scope="首页的竞赛倒计时与「每日一题」模块" />
    <section
      class="relative overflow-hidden bg-card-bg px-4 py-12 sm:px-6 md:py-16"
      aria-labelledby="home-title"
    >
      <div
        class="pointer-events-none absolute -right-24 -top-48 h-[34rem] w-[34rem] rounded-full bg-[#e8f0fe] blur-3xl dark:bg-[#1b365c]"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative mx-auto grid max-w-[1200px] items-center gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(300px,0.65fr)] lg:gap-12"
      >
        <div class="min-w-0">
          <div
            class="mb-6 inline-flex items-center gap-2 rounded-full bg-btn-regular-bg px-4 py-2 text-sm font-medium text-primary-readable"
          >
            <Icon name="tabler:atom" class="h-4 w-4" aria-hidden="true" /> 理科迷
            · 科学与创造者社区
          </div>
          <h1
            id="home-title"
            class="max-w-4xl font-heading text-[clamp(2.25rem,4.5vw,3.6rem)] font-semibold leading-[1.18] tracking-tight text-deep-text"
          >
            从一个问题出发，<br /><span class="text-primary-readable"
              >找到整个理科社区。</span
            >
          </h1>
          <p class="mt-6 max-w-2xl text-base leading-7 text-text-muted">
            讨论、专栏和学习资料；找到愿意一起解题、做项目、参加竞赛的同好。
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={paths.forum}
              class="rounded-full bg-primary-action px-6 py-3 text-sm font-medium text-white transition hover:shadow-md"
              >浏览社区</a
            >
            <a
              href={paths.projects}
              class="rounded-full border border-surface-3 bg-card-bg px-6 py-3 text-sm font-medium text-deep-text transition hover:bg-btn-regular-bg"
              >查看项目</a
            >
          </div>
        </div>
        <aside
          class="rounded-[24px] border border-surface-3 bg-page-bg p-6 sm:p-7"
          aria-label="快速开始"
        >
          <span
            class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-btn-regular-bg text-primary-readable"
            ><Icon
              name="tabler:compass"
              class="h-6 w-6"
              aria-hidden="true"
            /></span
          >
          <h2 class="mt-5 text-xl font-semibold text-deep-text">从这里开始</h2>
          <p class="mt-2 text-sm leading-6 text-text-muted">
            选一个方向，继续探索理科迷。
          </p>
          <div class="mt-6 grid gap-2">
            <a
              href={paths.qa}
              class="flex items-center justify-between rounded-2xl bg-card-bg px-4 py-3 text-sm font-medium text-deep-text hover:bg-btn-regular-bg hover:text-primary-readable"
              >悬赏求助 <Icon
                name="tabler:arrow-up-right"
                class="h-4 w-4"
                aria-hidden="true"
              /></a
            >
            <a
              href={paths.projects}
              class="flex items-center justify-between rounded-2xl bg-card-bg px-4 py-3 text-sm font-medium text-deep-text hover:bg-btn-regular-bg hover:text-primary-readable"
              >寻找项目 <Icon
                name="tabler:arrow-up-right"
                class="h-4 w-4"
                aria-hidden="true"
              /></a
            >
            <a
              href={paths.bank}
              class="flex items-center justify-between rounded-2xl bg-card-bg px-4 py-3 text-sm font-medium text-deep-text hover:bg-btn-regular-bg hover:text-primary-readable"
              >赛后题库 <Icon
                name="tabler:arrow-up-right"
                class="h-4 w-4"
                aria-hidden="true"
              /></a
            >
          </div>
          <details class="group relative mt-4">
            <summary
              class="flex cursor-pointer list-none items-center gap-2 rounded-full bg-primary-action px-5 py-2 text-sm font-medium text-white transition hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-action"
              ><Icon
                name="tabler:plus"
                class="h-4 w-4"
                aria-hidden="true"
              />发布<Icon
                name="tabler:chevron-down"
                class="h-4 w-4"
                aria-hidden="true"
              /></summary
            >
            <div
              class="mt-2 rounded-2xl border border-surface-3 bg-card-bg p-1.5"
            >
              <a
                href={paths.forum}
                class="block rounded-lg px-3 py-2 text-sm text-deep-text hover:bg-primary/10"
                >发帖 · 选择板块</a
              >
              <a
                href={`${paths.files}#upload`}
                class="block rounded-lg px-3 py-2 text-sm text-deep-text hover:bg-primary/10"
                >发文件</a
              >
              <a
                href={`${paths.projects}#create`}
                class="block rounded-lg px-3 py-2 text-sm text-deep-text hover:bg-primary/10"
                >发起项目</a
              >
              <a
                href={paths.qa}
                class="block rounded-lg px-3 py-2 text-sm text-deep-text hover:bg-primary/10"
                >发起求助</a
              >
            </div>
          </details>
        </aside>
      </div>
    </section>

    <section
      class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6 md:py-16"
      aria-labelledby="pulse-heading"
    >
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p
            class="text-xs font-semibold tracking-[0.12em] text-primary-readable"
          >
            探索社区
          </p><h2
            id="pulse-heading"
            class="mt-2 font-heading text-2xl font-semibold text-deep-text sm:text-3xl"
          >
            此刻值得关注
          </h2><p class="mt-2 text-text-muted">
            有待解决的问题、正在招募的队伍，以及值得细读的文章。
          </p>
        </div><a
          href={paths.forum}
          class="rounded-full px-4 py-2 text-sm font-medium text-primary-readable transition hover:bg-btn-regular-bg"
          >探索社区 →</a
        >
      </div>
      <div class="grid gap-5 lg:grid-cols-3">
        <div
          class="rounded-[22px] border border-surface-3 bg-card-bg p-5 sm:p-6"
        >
          <div class="flex items-center justify-between">
            <div
              class="flex items-center gap-2 text-[#b06000] dark:text-[#ffba6a]"
            >
              <Icon name="tabler:coin" class="h-5 w-5" /><h3 class="font-bold">
                悬赏求助精选
              </h3>
            </div><a
              href={paths.qa}
              class="text-xs font-semibold text-primary-readable hover:underline"
              >全部求助 →</a
            >
          </div><div class="mt-5 space-y-3">
            {
              featuredQuestions.length ? (
                featuredQuestions.map((q) => (
                  <a
                    href={getPermalink(`/qa/${q.id}`)}
                    class="group block rounded-2xl border border-surface-3 bg-page-bg p-4 transition hover:border-amber-400 hover:shadow-sm"
                  >
                    <>
                      <div class="mb-2 flex items-center justify-between gap-2">
                        <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-800">
                          💰 悬赏 {q.bountyTotal} 积分
                        </span>
                        {q.urgent && (
                          <span class="text-xs font-bold text-red-500">
                            加急
                          </span>
                        )}
                      </div>
                      <h4 class="line-clamp-2 font-semibold leading-6 text-deep-text group-hover:text-primary-readable">
                        {q.title}
                      </h4>
                      <p class="mt-2 text-xs text-text-muted">
                        {q.answerCount} 个回答 · {q.authorName || "社区成员"}
                      </p>
                    </>
                  </a>
                ))
              ) : (
                <p class="rounded-2xl bg-page-bg p-5 text-sm leading-6 text-text-muted">
                  暂时没有开放中的悬赏。你可以提出第一个问题。
                </p>
              )
            }
          </div>
        </div>
        <div
          class="rounded-[22px] border border-surface-3 bg-card-bg p-5 sm:p-6"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-primary-readable">
              <Icon name="tabler:rocket" class="h-5 w-5" /><h3
                class="font-bold"
              >
                热门项目招募
              </h3>
            </div><a
              href={paths.projects}
              class="text-xs font-semibold text-primary-readable hover:underline"
              >项目大厅 →</a
            >
          </div><div class="mt-5 space-y-3">
            {
              recruitingProjects.length ? (
                recruitingProjects.map((project) => (
                  <a
                    href={getPermalink(`/projects/${project.id}`)}
                    class="group block rounded-2xl border border-surface-3 bg-page-bg p-4 transition hover:border-sky-400 hover:shadow-sm"
                  >
                    <>
                      <div class="mb-2 flex items-center justify-between">
                        <>
                          <span class="rounded-full bg-sky-100 px-2.5 py-1 text-xs font-bold text-sky-800">
                            招募中
                          </span>
                          <span class="text-xs text-text-muted">
                            进度 {project.progress}%
                          </span>
                        </>
                      </div>
                      <h4 class="line-clamp-1 font-semibold text-deep-text group-hover:text-primary-readable">
                        {project.title}
                      </h4>
                      <p class="mt-1 line-clamp-2 text-xs leading-5 text-text-muted">
                        {project.summary}
                      </p>
                      <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-surface-3">
                        <div
                          class="h-full rounded-full bg-sky-500"
                          style={`width: ${Math.max(0, Math.min(100, project.progress))}%`}
                        />
                      </div>
                    </>
                  </a>
                ))
              ) : (
                <p class="rounded-2xl bg-page-bg p-5 text-sm leading-6 text-text-muted">
                  目前没有开放招募的项目。去项目大厅看看新的创作。
                </p>
              )
            }
          </div>
        </div>
        <div
          class="rounded-[22px] border border-surface-3 bg-card-bg p-5 sm:p-6"
        >
          <div class="flex items-center justify-between">
            <div
              class="flex items-center gap-2 text-[#a1428b] dark:text-[#f4a9d7]"
            >
              <Icon name="tabler:book-2" class="h-5 w-5" /><h3
                class="font-bold"
              >
                专栏好文推荐
              </h3>
            </div><a
              href={`${paths.search}?type=columns`}
              class="text-xs font-semibold text-primary-readable hover:underline"
              >搜索专栏 →</a
            >
          </div><div class="mt-5 space-y-3">
            {
              featuredColumns.length ? (
                featuredColumns.map((item) => (
                  <a
                    href={getPermalink(`/forum/post/${item.id}`)}
                    class="group block rounded-2xl border border-surface-3 bg-page-bg p-4 transition hover:border-violet-400 hover:shadow-sm"
                  >
                    <>
                      <span class="text-xs font-bold text-violet-600 dark:text-violet-400">
                        {item.column_title || "理科专栏"}
                      </span>
                      <h4 class="mt-2 line-clamp-2 font-semibold leading-6 text-deep-text group-hover:text-primary-readable">
                        {item.title}
                      </h4>
                      <p class="mt-2 text-xs text-text-muted">
                        {item.like_count} 赞 · {item.view_count} 次阅读
                      </p>
                    </>
                  </a>
                ))
              ) : (
                <p class="rounded-2xl bg-page-bg p-5 text-sm leading-6 text-text-muted">
                  近期还没有已发布的专栏文章。先去发现社区讨论。
                </p>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="mx-auto max-w-[1200px] px-4 pb-12 sm:px-6 md:pb-16"
      aria-labelledby="ops-heading"
    >
      <div class="mb-8">
        <p class="text-xs font-semibold tracking-[0.12em] text-primary-readable">
          社区运营
        </p>
        <h2
          id="ops-heading"
          class="mt-2 font-heading text-2xl font-semibold text-deep-text sm:text-3xl"
        >
          你的社区动态
        </h2>
        <p class="mt-2 text-text-muted">
          个人看板、官方公告，以及本周最活跃的社区成员。
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {/* 卡片一：用户个人看板 */}
        <div class="card-base p-5 sm:p-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-primary-readable">
              <Icon name="tabler:dashboard" class="h-5 w-5" />
              <h3 class="font-bold">个人看板</h3>
            </div>
            <a
              href={getPermalink("/account")}
              class="text-xs font-semibold text-primary-readable hover:underline"
              >我的主页 →</a
            >
          </div>

          <div
            class="mt-5 flex items-center justify-between rounded-2xl bg-page-bg p-4"
          >
            <div>
              <p class="text-xs text-text-muted">贡献积分余额</p>
              <p class="mt-1 text-2xl font-bold text-deep-text">
                1,280 <span class="text-sm font-normal text-text-muted">积分</span>
              </p>
            </div>
            <span class="badge badge-success badge-sm">本月 +120</span>
          </div>

          <div class="mt-4">
            <p class="text-xs font-semibold text-text-muted">最近参与的悬赏</p>
            <div class="mt-2 space-y-2">
              <a
                href={paths.qa}
                class="group flex items-center justify-between gap-3 rounded-xl border border-surface-3 bg-page-bg px-3 py-2.5 hover:border-amber-400"
              >
                <span
                  class="line-clamp-1 text-sm text-deep-text group-hover:text-primary-readable"
                  >测不准原理的物理直觉怎么理解？</span
                >
                <span
                  class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-800"
                  >💰 50</span
                >
              </a>
              <a
                href={paths.qa}
                class="group flex items-center justify-between gap-3 rounded-xl border border-surface-3 bg-page-bg px-3 py-2.5 hover:border-amber-400"
              >
                <span
                  class="line-clamp-1 text-sm text-deep-text group-hover:text-primary-readable"
                  >复赛第三题的构造性证明思路</span
                >
                <span
                  class="shrink-0 rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-800"
                  >已采纳</span
                >
              </a>
            </div>
          </div>

          <div
            class="mt-4 flex items-center justify-between rounded-xl bg-btn-regular-bg px-4 py-3"
          >
            <div class="flex items-center gap-2">
              <Icon
                name="tabler:notebook"
                class="h-4 w-4 text-primary-readable"
              />
              <span class="text-sm text-deep-text">错题本待复习</span>
            </div>
            <span class="text-sm font-bold text-primary-readable">
              12 道 <span class="font-normal text-text-muted">（今日到期 3 道）</span>
            </span>
          </div>
        </div>

        {/* 卡片二：社区公告与活动 */}
        <div class="card-base p-5 sm:p-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-primary-readable">
              <Icon name="tabler:flag" class="h-5 w-5" />
              <h3 class="font-bold">公告与活动</h3>
            </div>
            <a href={paths.forum} class="text-xs font-semibold text-primary-readable hover:underline"
              >全部 →</a
            >
          </div>

          <p class="mt-5 text-xs font-semibold tracking-wide text-text-muted">
            官方公告
          </p>
          <div class="mt-2 space-y-2">
            <a
              href={getPermalink("/forum")}
              class="group block rounded-xl border border-surface-3 bg-page-bg p-3 hover:border-sky-400"
            >
              <span class="text-xs text-text-muted">10-05</span>
              <p
                class="mt-1 line-clamp-1 text-sm font-medium text-deep-text group-hover:text-primary-readable"
                >社区积分体系 V2 正式上线，悬赏结算规则更新</p
              >
            </a>
            <a
              href={getPermalink("/forum")}
              class="group block rounded-xl border border-surface-3 bg-page-bg p-3 hover:border-sky-400"
            >
              <span class="text-xs text-text-muted">10-01</span>
              <p
                class="mt-1 line-clamp-1 text-sm font-medium text-deep-text group-hover:text-primary-readable"
                >秋季维护公告：题库服务将于本周六凌晨升级</p
              >
            </a>
          </div>

          <p class="mt-5 text-xs font-semibold tracking-wide text-text-muted">
            进行中的活动
          </p>
          <div
            class="mt-2 flex items-center justify-between rounded-xl border border-violet-300 bg-violet-50 p-3 dark:border-violet-500/40 dark:bg-violet-500/10"
          >
            <div>
              <p class="text-sm font-semibold text-deep-text">
                秋季数学建模组队周
              </p>
              <p class="mt-0.5 text-xs text-text-muted">距结束还有 5 天</p>
            </div>
            <a
              href={paths.competition}
              class="shrink-0 rounded-full bg-primary-action px-3.5 py-1.5 text-xs font-medium text-white transition hover:shadow-md"
              >立即参加</a
            >
          </div>
        </div>

        {/* 卡片三：活跃榜单 */}
        <div class="card-base p-5 sm:p-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-primary-readable">
              <Icon name="tabler:trophy" class="h-5 w-5" />
              <h3 class="font-bold">活跃榜单</h3>
            </div>
            <span class="badge badge-ghost badge-sm">本周</span>
          </div>

          <div class="mt-5 space-y-5">
            {
              [
                {
                  title: "解答达人榜",
                  icon: "tabler:star-filled",
                  rows: [
                    ["林小满", "156 采纳"],
                    ["陈数", "142 采纳"],
                    ["阿基米德", "128 采纳"],
                    ["量子少年", "110 采纳"],
                    ["黎曼ζ", "98 采纳"],
                  ],
                },
                {
                  title: "项目贡献榜",
                  icon: "tabler:rocket",
                  rows: [
                    ["物理仿真组", "32 PR"],
                    ["题库整理组", "28 PR"],
                    ["竞赛算法组", "21 PR"],
                    ["专栏编辑部", "17 PR"],
                    ["资料组", "12 PR"],
                  ],
                },
                {
                  title: "积分富豪榜",
                  icon: "tabler:coin",
                  rows: [
                    ["学霸本霸", "9,800"],
                    ["解题狂魔", "7,600"],
                    ["深夜刷题人", "6,200"],
                    ["公式之美", "5,400"],
                    ["路人甲", "4,800"],
                  ],
                },
              ].map((list) => (
                <div>
                  <p class="flex items-center gap-1.5 text-xs font-semibold text-text-muted">
                    <Icon name={list.icon} class="h-3.5 w-3.5" />
                    {list.title}
                  </p>
                  <ol class="mt-2 space-y-1.5">
                    {list.rows.map(([name, value], idx) => (
                      <li class="flex items-center justify-between text-sm">
                        <span class="flex items-center gap-2">
                          <span
                            class={
                              idx === 0
                                ? "w-4 text-center font-bold text-amber-500"
                                : idx === 1
                                  ? "w-4 text-center font-bold text-slate-400"
                                  : idx === 2
                                    ? "w-4 text-center font-bold text-orange-400"
                                    : "w-4 text-center text-text-muted"
                            }
                          >
                            {idx + 1}
                          </span>
                          <span class="text-deep-text">{name}</span>
                        </span>
                        <span class="text-xs text-text-muted">{value}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="border-y border-surface-3 bg-card-bg px-4 py-12 sm:px-6 md:py-16"
      aria-labelledby="competition-heading"
    >
      <div class="mx-auto max-w-[1200px]">
        <div class="mb-8">
          <p
            class="text-xs font-semibold tracking-[0.12em] text-primary-readable"
          >
            每日挑战
          </p><h2
            id="competition-heading"
            class="mt-2 font-heading text-2xl font-semibold text-deep-text sm:text-3xl"
          >
            以赛促学，每天进步一点
          </h2>
        </div><div class="grid gap-5 lg:grid-cols-[1.4fr_1fr]">
          <div
            class="relative overflow-hidden rounded-[28px] bg-[#d3e3fd] p-7 text-[#17365d] dark:bg-[#234268] dark:text-[#e8f0fe] sm:p-9"
          >
            <div
              class="absolute -right-16 -top-20 h-64 w-64 rounded-full border border-white/40"
              aria-hidden="true"
            >
            </div><div class="relative">
              <span
                class="inline-flex rounded-full bg-white/60 px-3 py-1 text-xs font-semibold dark:bg-white/10"
                >{
                  upcomingCompetition
                    ? upcomingCompetition.status === "ongoing"
                      ? "正在进行"
                      : "即将开始"
                    : "竞赛大厅"
                }</span
              ><h3 class="mt-6 max-w-lg text-2xl font-bold sm:text-3xl">
                {
                  upcomingCompetition
                    ? t(upcomingCompetition.title)
                    : "下一场挑战，从这里开始"
                }
              </h3><p
                class="mt-3 max-w-lg text-sm leading-7 text-[#3d5879] dark:text-[#c6daf7]"
              >
                {
                  upcomingCompetition
                    ? t(upcomingCompetition.description)
                    : "浏览赛事安排，与同好一起迎接下一场理科挑战。"
                }
              </p>{
                upcomingCompetition && (
                  <p class="mt-5 text-sm font-semibold">
                    {daysUntil === null
                      ? "赛事进行中"
                      : `${daysUntil} 天后开始`}{" "}
                    · {upcomingCompetition.startDate}
                  </p>
                )
              }<a
                href={upcomingCompetition
                  ? getPermalink(`/competition/${upcomingCompetition.id}`)
                  : paths.competition}
                class="mt-7 inline-flex items-center gap-2 rounded-full bg-[#0b57d0] px-5 py-3 text-sm font-medium text-white transition hover:shadow-md"
                >{upcomingCompetition ? "查看赛事" : "查看竞赛大厅"}<Icon
                  name="tabler:arrow-up-right"
                  class="h-4 w-4"
                /></a
              >
            </div>
          </div><div
            class="rounded-[28px] border border-surface-3 bg-page-bg p-7 sm:p-9"
          >
            <span
              class="inline-flex rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary-readable"
              >今日练习 · 赛后题库</span
            ><h3 class="mt-5 text-xl font-bold text-deep-text">
              用一道题，保持思考的手感。
            </h3><p class="mt-3 line-clamp-2 text-sm leading-7 text-text-muted">
              {
                dailyQuestion
                  ? t(dailyQuestion.stem)
                  : "从题库选择感兴趣的学科，开始练习。"
              }
            </p><div class="mt-8 flex flex-wrap gap-3">
              <a
                href={paths.bank}
                class="inline-flex items-center gap-2 rounded-full bg-primary-action px-5 py-3 text-sm font-medium text-white transition hover:shadow-md"
                >进入题库 <Icon name="tabler:arrow-right" class="h-4 w-4" /></a
              ><a
                href={paths.competition}
                class="inline-flex items-center rounded-full border border-surface-3 px-5 py-3 text-sm font-medium text-deep-text transition hover:bg-btn-regular-bg"
                >全部竞赛</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
