---
import SidebarLayout from "~/layouts/SidebarLayout.astro";
import FileListPage from "~/features/file-library/components/FileListPage.vue";
import { t } from "~/lib/i18n";

const metadata = { title: `${t("community.files.title")} —— LKM` };
---

<SidebarLayout
  metadata={metadata}
  sidebarLinks={[
    { text: "nav.overview", href: "#overview" },
    { text: "nav.fileLibrary", href: "#library" },
  ]}
  currentPath={Astro.url.pathname}
>
  <div class="space-y-6">
    <div id="overview">
      <h1 class="text-3xl font-bold text-deep-text">
        {t("community.files.title")}
      </h1>
      <p class="text-text-muted mt-2">{t("community.files.subtitle")}</p>
    </div>
    <div id="library" class="min-h-[400px]"><FileListPage client:load /></div>
  </div>
</SidebarLayout>
