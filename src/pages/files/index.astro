---
import SidebarLayout from "~/layouts/SidebarLayout.astro";
import PageIntro from "~/components/patterns/PageIntro.astro";
import FileListPage from "~/features/file-library/components/FileListPage.vue";
import { t } from "~/lib/i18n";

const metadata = { title: t("community.files.title") };
---

<SidebarLayout
  metadata={metadata}
  sidebarLinks={[
    {
      text: "nav.overview",
      href: "#overview",
      icon: "tabler:layout-dashboard",
    },
    { text: "nav.fileLibrary", href: "#library", icon: "tabler:folder" },
  ]}
  currentPath={Astro.url.pathname}
>
  <div class="space-y-6">
    <PageIntro
      title={t("community.files.title")}
      description={t("community.files.subtitle")}
      eyebrow={t("page.ui.filesEyebrow")}
      icon="tabler:folder"
    />
    <div id="library" class="min-h-[400px]"><FileListPage client:load /></div>
  </div>
</SidebarLayout>
