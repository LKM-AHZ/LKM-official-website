---
import CommunitySidebarLayout from '~/layouts/CommunitySidebarLayout.astro';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import FileListPage from '~/features/file-library/components/FileListPage.vue';
import { t } from '~/lib/i18n';

const metadata = { title: `${t('community.files.title')} —— LKM` };
---

<CommunitySidebarLayout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={Astro.url.pathname}
  navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}
>
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold text-deep-text">{t('community.files.title')}</h1>
      <p class="text-text-muted mt-2">{t('community.files.subtitle')}</p>
    </div>
    <div style="min-height: 400px"><FileListPage client:load /></div>
  </div>
</CommunitySidebarLayout>
