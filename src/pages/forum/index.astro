---
import Layout from '~/layouts/CommunitySidebarLayout.astro';
import { Icon } from 'astro-icon/components';
import { getRootCategories, getChildCategories } from '~/features/forum/data/categories';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = { title: `${t('community.forum.title')} —— LKM` };
const rootCategories = getRootCategories();

// 每类子分类的网格列数
function gridCols(count: number): string {
  if (count <= 3) return 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3';
  return 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4';
}
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink('/forum')}
  navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}
>
  <div class="space-y-10">
    <div>
      <h1 class="text-3xl font-bold text-deep-text">{t('community.forum.title')}</h1>
      <p class="text-text-muted mt-2">{t('community.forum.subtitle')}</p>
    </div>

    {
      rootCategories.map((root) => {
        const children = getChildCategories(root.id);
        const showChildren = children.length > 0;

        return (
          <section id={root.slug}>
            <a
              href={getPermalink(`/forum/${root.slug}`)}
              class="flex items-center gap-3 mb-4 rounded-xl p-2 -mx-2 group"
            >
              <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
                <Icon name={root.icon} class="w-6 h-6 text-primary" />
              </div>
              <div class="min-w-0">
                <h2 class="text-xl font-bold text-deep-text group-hover:text-primary transition-colors">
                  {t(root.name)}
                </h2>
                <p class="text-sm text-text-muted">
                  {root.memberCount} {t('community.forum.members')} · {root.postCount} {t('community.forum.posts')} ·{' '}
                  {t('community.forum.todayPosts', { count: root.todayPostCount })}
                </p>
              </div>
              <span class="ml-auto text-sm text-primary group-hover:underline whitespace-nowrap shrink-0 inline-flex items-center gap-1">
                {t('community.forum.viewAll')}
                <Icon name="tabler:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>

            {showChildren ? (
              <div class:list={['grid gap-4', gridCols(children.length)]}>
                {children.map((child) => (
                  <a href={getPermalink(`/forum/${child.slug}`)} class="profile-card group">
                    <div class="profile-inner p-4 flex flex-col gap-2 h-full">
                      <div class="flex items-center gap-2">
                        <Icon name={child.icon} class="w-5 h-5 text-primary shrink-0" />
                        <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">
                          {t(child.name)}
                        </h3>
                      </div>
                      <p class="text-xs text-text-muted line-clamp-2 leading-relaxed flex-1">{t(child.description)}</p>
                      <div class="flex items-center justify-between text-xs text-text-muted/60 pt-1 border-t border-surface-3">
                        <span>
                          {child.memberCount} {t('community.forum.members')}
                        </span>
                        <span>
                          {child.postCount} {t('community.forum.postsShort')}
                        </span>
                        <span class="text-primary/80">
                          {child.todayPostCount > 0
                            ? t('community.forum.todayPosts', { count: child.todayPostCount })
                            : ''}
                        </span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <a
                href={getPermalink(`/forum/${root.slug}`)}
                class="block bg-card-bg border border-surface-3 rounded-xl p-8 text-center group hover:bg-surface-2/80 transition-colors"
              >
                <Icon name={root.icon} class="w-8 h-8 text-primary mx-auto mb-2" />
                <p class="text-text-muted text-sm mb-2">{t(root.description)}</p>
                <span class="inline-flex items-center gap-1 text-primary text-sm font-medium group-hover:underline">
                  {t('community.forum.viewAll')}
                  <Icon name="tabler:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
                </span>
                {root.slug === 'school-club' && (
                  <span class="mt-3 block text-xs text-text-muted/70">{t('community.forum.applyCollaboration')}</span>
                )}
              </a>
            )}
          </section>
        );
      })
    }
  </div>
</Layout>
