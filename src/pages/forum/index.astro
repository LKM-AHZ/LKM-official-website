---
import Layout from '~/layouts/CommunitySidebarLayout.astro';
import { Icon } from 'astro-icon/components';
import { getRootCategories, getChildCategories } from '~/features/forum/data/categories';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import { contentApi, type BoardItem } from '~/lib/api/modules/content';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = { title: `${t('community.forum.title')} —— LKM` };

// 板块广场：优先从后端取真实 boards（含父/子层级），失败/空时回退静态 mock。
interface RenderBoard {
  slug: string;
  title: string;
  description: string;
  icon: string;
  isParent: boolean;
  childCount: number;
}

let rootBoards: RenderBoard[] = [];

try {
  const res = await contentApi.listBoards();
  const boards: BoardItem[] = res.isOk() ? (res.value?.items ?? []) : [];
  if (boards.length > 0) {
    const parentById = new Map<number, BoardItem[]>();
    for (const b of boards) {
      if (b.parent_id != null) {
        const arr = parentById.get(b.parent_id) ?? [];
        arr.push(b);
        parentById.set(b.parent_id, arr);
      }
    }
    rootBoards = boards
      .filter((b) => b.parent_id == null)
      .map((p) => ({
        slug: p.slug,
        title: p.title,
        description: p.description || '',
        icon: 'tabler:building-community',
        isParent: true,
        childCount: (parentById.get(p.id) ?? []).length,
      }));
  }
} catch (_e) {
  // 后端不可用时回退静态 mock
}

if (rootBoards.length === 0) {
  rootBoards = getRootCategories().map((c) => ({
    slug: c.slug,
    title: t(c.name),
    description: t(c.description),
    icon: c.icon,
    isParent: getChildCategories(c.id).length > 0,
    childCount: getChildCategories(c.id).length,
  }));
}

---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink('/forum')}
  navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}
>
  <div class="space-y-10">
    <div>
      <h1 class="text-3xl font-bold text-deep-text">{t('community.forum.title')}</h1>
      <p class="text-text-muted mt-2">{t('community.forum.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {rootBoards.map((b) => (
        <a href={getPermalink(`/forum/${b.slug}`)} class="profile-card group">
          <div class="profile-inner p-4 flex flex-col gap-2 h-full">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <Icon name={b.icon} class="w-5 h-5 text-primary" />
              </div>
              <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors">{b.title}</h3>
            </div>
            <p class="text-xs text-text-muted line-clamp-2 leading-relaxed flex-1">{b.description}</p>
            {b.isParent && (
              <span class="text-xs text-primary/80">
                {b.childCount} {t('community.forum.members')}
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
