---
import Layout from '~/layouts/CommunitySidebarLayout.astro';
import { Icon } from 'astro-icon/components';
import { getCategoryBySlug } from '~/features/forum/data/categories';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import PostInteractions from '~/features/forum/components/PostInteractions.vue';
import CommentSection from '~/features/forum/components/CommentSection.vue';
import PostCard from '~/features/forum/components/PostCard.astro';
import { getPermalink } from '~/lib/utils/permalinks';
import { sanitizeHtmlContent } from '~/lib/utils/html-sanitize';
import { forumApi } from '~/lib/api';
import type { GqlPost } from '~/features/forum/graphql';
import { t } from '~/lib/i18n';

const { postId } = Astro.params;

// 通过 forumApi 获取帖子详情（统一数据访问层）
const postResult = await forumApi.getPostDetail(Number(postId));
const post = postResult.data?.post;

if (!post) {
  return Astro.redirect(getPermalink('/forum'));
}

const category = getCategoryBySlug(post.categoryId);

// 通过 forumApi 获取相关帖子
const relatedResult = await forumApi.listRelatedPosts(post.categoryId, post.id);
const relatedPosts = relatedResult.data?.posts?.items ?? [];

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

const authorName = post.author?.displayName ?? t('page.communityDetail.forum.anonymousUser');
---

<Layout
  metadata={{ title: `${post.title} —— LKM` }}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink(`/forum/post/${postId}`)}
  navItems={['社区主页', '博客', '资源', '我的']}
>
  <div class="space-y-6">
    <!-- 面包屑 -->
    <div class="flex items-center gap-2 text-sm text-text-muted/60">
      <a href={getPermalink('/forum')} class="hover:text-primary transition-colors">
        {t('page.communityDetail.forum.forum')}
      </a>
      <Icon name="tabler:chevron-right" class="w-3.5 h-3.5" />
      {
        category && (
          <>
            <a href={getPermalink(`/forum/${category.slug}`)} class="hover:text-primary transition-colors">
              {t(category.name)}
            </a>
            <Icon name="tabler:chevron-right" class="w-3.5 h-3.5" />
          </>
        )
      }
      <span class="text-text-muted truncate">{post.title}</span>
    </div>

    <!-- 帖子正文 -->
    <article>
      <!-- 标题区 -->
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-2">
          {
            post.isPinned && (
              <span class="inline-flex items-center gap-1 text-xs px-1.5 py-0.5 rounded font-medium bg-red-100 dark:bg-red-950/30 text-red-600 dark:text-red-400">
                <Icon name="tabler:pin" class="w-3 h-3" /> {t('page.communityDetail.forum.pinned')}
              </span>
            )
          }
          {
            post.isFeatured && (
              <span class="inline-flex items-center gap-1 text-xs px-1.5 py-0.5 rounded font-medium bg-amber-100 dark:bg-amber-950/30 text-amber-600 dark:text-amber-400">
                <Icon name="tabler:star-filled" class="w-3 h-3" /> {t('page.communityDetail.forum.featured')}
              </span>
            )
          }
        </div>
        <h1 class="text-2xl md:text-3xl font-bold text-deep-text leading-tight">{post.title}</h1>
        <div class="flex flex-wrap items-center gap-3 mt-4 text-sm text-text-muted/60">
          <span>{authorName}</span>
          <span>·</span>
          <span>{formatDate(post.createdAt)}</span>
          <span>·</span>
          <span>
            <Icon name="tabler:eye" class="w-4 h-4 inline mr-1" />
            {t('page.communityDetail.forum.views', { count: post.viewCount })}
          </span>
        </div>
        {
          post.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-3">
              {post.tags.map((tag: string) => (
                <span class="text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary">{tag}</span>
              ))}
            </div>
          )
        }
      </div>

      <!-- 正文 -->
      <div class="prose dark:prose-invert max-w-none mb-8">
        <Fragment set:html={sanitizeHtmlContent(post.content)} />
      </div>

      <!-- 交互栏 -->
      <PostInteractions
        client:visible
        likeCount={post.likeCount}
        bookmarkCount={post.bookmarkCount}
        forwardCount={post.forwardCount}
      />

      <!-- 评论 -->
      <div id="comments" class="mt-8 pt-6 border-t border-surface-3">
        <CommentSection client:visible postId={String(post.id)} />
      </div>
    </article>

    <!-- 相关推荐 -->
    {
      relatedPosts.length > 0 && (
        <div class="border-t border-surface-3 pt-6 mt-6">
          <h3 class="font-semibold text-deep-text mb-4">{t('page.communityDetail.forum.related')}</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {relatedPosts.map((rp: GqlPost) => (
              <PostCard post={rp} />
            ))}
          </div>
        </div>
      )
    }
  </div>
</Layout>
