---
import Layout from '~/layouts/CommunitySidebarLayout.astro';
import { Icon } from 'astro-icon/components';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import ContentCard from '~/features/content/components/ContentCard.astro';
import CreatePostDialog from '~/features/forum/components/CreatePostDialog.vue';
import { contentApi, type BoardItem, type ContentItem } from '~/lib/api/modules/content';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const { categorySlug } = Astro.params;

// 板块详情：从后端解析真实板块（按 slug），并拉取其统一内容（讨论/官方/专栏/博客）
const boardsRes = await contentApi.listBoards();
let boards: BoardItem[] = boardsRes.isOk() ? (boardsRes.value?.items ?? []) : [];
const board = boards.find((b) => b.slug === categorySlug);

if (!board) {
  return Astro.redirect(getPermalink('/forum'));
}

// 子板块（父板块展示） + 本板块id
const children = boards.filter((b) => b.parent_id === board.id);
const boardIds = board.parent_id == null
  ? [board.id, ...children.map((c) => c.id)]
  : [board.id];

// 拉统一内容（这里全量拉第一页，后续可加内容体裁 Tab 分类）
let allItems: ContentItem[] = [];
for (const bid of boardIds) {
  const res = await contentApi.listItems({ board_id: bid, limit: 50 });
  if (res.isOk()) {
    allItems = allItems.concat(res.value.items ?? []);
  }
}

// 排序：置顶优先，其次按创建时间降序
allItems.sort((a, b) => {
  if (a.is_pinned && !b.is_pinned) return -1;
  if (!a.is_pinned && b.is_pinned) return 1;
  return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
});

const boardTitle = board.title;
const boardDesc = board.description || '';
const boardLabel = boardTitle;
const metadata = { title: `${boardLabel} —— LKM` };

// 热门：置顶/精华优先，其次浏览数
const hotItems = allItems
  .slice()
  .sort((a, b) => {
    if ((a.is_pinned || a.is_featured) !== (b.is_pinned || b.is_featured)) {
      return a.is_pinned || a.is_featured ? -1 : 1;
    }
    return b.view_count - a.view_count;
  })
  .slice(0, 6);

const recentItems = allItems.slice(0, 48);
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink(`/forum/${categorySlug}`)}
  navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}
>
  <div class="space-y-6">
    <!-- 面包屑 / 返回板块广场 -->
    <div class="flex items-center gap-2 text-sm text-text-muted">
      <a href={getPermalink('/forum')} class="hover:text-primary transition-colors">
        {t('page.communityDetail.forum.backToSquare')}
      </a>
      <span>/</span>
      <span class="text-deep-text font-medium">{boardLabel}</span>
    </div>

    <!-- 板块头部 -->
    <div class="relative overflow-hidden rounded-2xl bg-card-bg border border-surface-3">
      <div class="absolute -top-16 -right-16 w-56 h-56 rounded-full bg-primary/5"></div>
      <div class="relative p-5 sm:p-6">
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0">
            <Icon name="tabler:building-community" class="w-8 h-8 text-primary" />
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <h1 class="text-2xl font-bold text-deep-text">{boardLabel}</h1>
            </div>
            <p class="text-sm text-text-muted line-clamp-2 mt-2">{boardDesc}</p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <button
              type="button"
              class="btn-primary px-4 py-2 rounded-lg text-sm font-semibold inline-flex items-center gap-1.5"
            >
              <Icon name="tabler:heart-plus" class="w-4 h-4" />
              {t('page.communityDetail.forum.follow')}
            </button>
            <button
              type="button"
              id="create-post-btn"
              class="btn-secondary px-4 py-2 rounded-lg text-sm font-semibold inline-flex items-center gap-1.5"
              onclick="window.dispatchEvent(new CustomEvent('lkm:open-create-post'))"
            >
              <Icon name="tabler:pencil-plus" class="w-4 h-4" />
              {t('page.communityDetail.forum.createPost')}
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- 子板块导航（一级分类时显示） -->
    {
      children.length > 0 && (
        <section class="bg-card-bg border border-surface-3 rounded-2xl p-5">
          <div class="flex items-center gap-2 mb-3">
            <Icon name="tabler:category-2" class="w-4 h-4 text-primary" />
            <h2 class="font-semibold text-deep-text">{t('page.communityDetail.forum.subcategoriesTitle')}</h2>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
            {children.map((child) => (
              <a
                href={getPermalink(`/forum/${child.slug}`)}
                class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-3/50 hover:bg-primary/10 transition-colors text-sm"
              >
                <Icon name="tabler:building-community" class="w-4 h-4 text-primary shrink-0" />
                <span class="text-deep-text font-medium truncate flex-1">{child.title}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- 板块介绍 -->
    <section class="bg-card-bg border border-surface-3 rounded-2xl p-5">
      <div class="flex items-center gap-2 mb-3">
        <Icon name="tabler:info-circle" class="w-4 h-4 text-primary" />
        <h2 class="font-semibold text-deep-text">{t('page.communityDetail.forum.introTitle')}</h2>
      </div>
      <p class="text-sm text-text-muted leading-relaxed">{boardDesc}</p>
    </section>

    <!-- 热门讨论 -->
    {
      hotItems.length > 0 && (
        <section>
          <div class="flex items-center gap-2 mb-3">
            <Icon name="tabler:flame" class="w-4 h-4 text-orange-500" />
            <h2 class="font-semibold text-deep-text">{t('page.communityDetail.forum.hotPosts')}</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {hotItems.map((item) => <ContentCard post={item} />)}
          </div>
        </section>
      )
    }

    <!-- 全部内容 -->
    <section>
      <div class="flex items-center gap-2 mb-3">
        <Icon name="tabler:news" class="w-4 h-4 text-primary" />
        <h2 class="font-semibold text-deep-text">{t('community.forum.latestPosts')}</h2>
        <span class="text-xs text-text-muted ml-auto">
          {t('page.communityDetail.forum.postsShort', { count: recentItems.length })}
        </span>
      </div>
      <div class="space-y-3">
        {
          recentItems.length > 0 ? (
            recentItems.map((item) => <ContentCard post={item} />)
          ) : (
            <div class="bg-card-bg border border-surface-3 rounded-xl p-12 text-center">
              <Icon name="tabler:article-off" class="w-12 h-12 text-text-muted/30 mx-auto mb-3" />
              <p class="text-text-muted">{t('page.communityDetail.forum.emptyPosts')}</p>
              <button type="button" class="mt-3 btn-primary px-4 py-2 rounded-lg text-sm">
                {t('page.communityDetail.forum.createFirst')}
              </button>
            </div>
          )
        }
      </div>
    </section>

    <CreatePostDialog client:load />
  </div>
</Layout>
