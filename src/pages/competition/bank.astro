---
import Layout from '~/layouts/CommunitySidebarLayout.astro';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import QuestionBank from '~/features/competition/components/QuestionBank.vue';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = { title: `${t('community.competition.questionBank')} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink('/competition/bank')}
  navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}
>
  <div class="space-y-6">
    <h1 class="text-3xl font-bold text-deep-text">{t('community.competition.questionBank')}</h1>
    <div style="min-height: 400px"><QuestionBank client:load /></div>
  </div>
</Layout>
