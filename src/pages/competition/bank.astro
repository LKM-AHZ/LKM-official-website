---
import Layout from "~/layouts/SidebarLayout.astro";
import QuestionBank from "~/features/competition/components/QuestionBank.vue";
import { getPermalink } from "~/lib/utils/permalinks";
import { t } from "~/lib/i18n";

const metadata = { title: `${t("community.competition.questionBank")} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={[
    { text: "nav.overview", href: "#overview" },
    { text: "nav.bank", href: "#questions" },
  ]}
  currentPath={getPermalink("/competition/bank")}
>
  <div class="space-y-6">
    <div id="overview">
      <h1 class="text-3xl font-bold text-deep-text">
        {t("community.competition.questionBank")}
      </h1>
    </div>
    <div id="questions" style="min-height: 400px">
      <QuestionBank client:load />
    </div>
  </div>
</Layout>
