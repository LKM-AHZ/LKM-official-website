---
import Layout from "~/layouts/SidebarLayout.astro";
import PageIntro from "~/components/patterns/PageIntro.astro";
import QuestionBank from "~/features/competition/components/QuestionBank.vue";
import { getPermalink } from "~/lib/utils/permalinks";
import { t } from "~/lib/i18n";

const metadata = { title: t("community.competition.questionBank") };
---

<Layout
  metadata={metadata}
  sidebarLinks={[
    {
      text: "nav.overview",
      href: "#overview",
      icon: "tabler:layout-dashboard",
    },
    { text: "nav.bank", href: "#questions", icon: "tabler:notebook" },
  ]}
  currentPath={getPermalink("/competition/bank")}
>
  <div class="space-y-6">
    <PageIntro
      title={t("community.competition.questionBank")}
      eyebrow={t("page.ui.bankEyebrow")}
      icon="tabler:notebook"
    />
    <div id="questions" style="min-height: 400px">
      <QuestionBank client:load />
    </div>
  </div>
</Layout>
