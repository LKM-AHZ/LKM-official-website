---
import Layout from "~/layouts/SidebarLayout.astro";
import PageIntro from "~/components/patterns/PageIntro.astro";
import DemoNotice from "~/components/patterns/DemoNotice.astro";
import CompetitionDetail from "~/features/competition/components/CompetitionDetail.vue";
import { mockCompetitions } from "~/features/competition/data/mock-competitions";
import { getPermalink } from "~/lib/utils/permalinks";
import { t } from "~/lib/i18n";

// server 模式：params 从 URL 直接解析
const { id } = Astro.params;
const comp = mockCompetitions.find((c) => c.id === id);

// server 模式：未知 id 应以 404 响应，避免软 404 被爬虫/监控当成有效页面
if (!comp) {
  Astro.response.status = 404;
}

const metadata = {
  title: comp ? t(comp.title) : t("page.communityDetail.competition.metaTitle"),
};
---

<Layout
  metadata={metadata}
  sidebarLinks={comp
    ? [
        { text: "nav.overview", href: "#overview", icon: "tabler:trophy" },
        { text: "nav.details", href: "#details", icon: "tabler:clipboard-list" },
      ]
    : []}
  currentPath={getPermalink(`/competition/${id}`)}
>
  {
    comp ? (
      <div id="details" class="space-y-6">
        <DemoNotice scope="本赛事的赛程、规则与报名状态" />
        <PageIntro
          title={t(comp.title)}
          description={t(comp.description)}
          icon="tabler:trophy"
        />
        <CompetitionDetail comp={comp} client:visible />
      </div>
    ) : (
      <p>{t("page.communityDetail.competition.notFound")}</p>
    )
  }
</Layout>
