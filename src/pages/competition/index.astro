---
import Layout from "~/layouts/SidebarLayout.astro";
import PageIntro from "~/components/patterns/PageIntro.astro";
import CompetitionHall from "~/features/competition/components/CompetitionHall.vue";
import { getPermalink } from "~/lib/utils/permalinks";
import { t } from "~/lib/i18n";

const metadata = { title: t("community.competition.title") };
---

<Layout
  metadata={metadata}
  sidebarLinks={[
    {
      text: "nav.overview",
      href: "#overview",
      icon: "tabler:layout-dashboard",
    },
    { text: "nav.competition", href: "#competitions", icon: "tabler:trophy" },
  ]}
  currentPath={getPermalink("/competition")}
>
  <div class="space-y-6">
    <PageIntro
      title={t("community.competition.title")}
      eyebrow={t("page.ui.competitionEyebrow")}
      icon="tabler:trophy"
    />
    {/* 竞赛大厅在首屏之下且是点击驱动：进入视口再水合，避免首屏白下整包 Vue */}
    <div id="competitions" class="min-h-[400px]">
      <CompetitionHall client:visible />
    </div>
  </div>
</Layout>
