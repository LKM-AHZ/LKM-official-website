---
import Layout from '~/layouts/CommunitySidebarLayout.astro';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import CompetitionHall from '~/features/competition/components/CompetitionHall.vue';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = { title: `${t('community.competition.title')} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink('/competition')}
  navItems={['nav.community', 'nav.blog', 'nav.resources', 'nav.mine']}
>
  <div class="space-y-6">
    <h1 class="text-3xl font-bold text-deep-text">{t('community.competition.title')}</h1>
    {/* 竞赛大厅在首屏之下且是点击驱动：进入视口再水合，避免首屏白下整包 Vue */}
    <div class="min-h-[400px]"><CompetitionHall client:visible /></div>
  </div>
</Layout>
