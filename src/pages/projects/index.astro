---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
// 走 feature barrel 而不是深路径：深路径会让 barrel 的再导出无人消费、与真实组件悄悄漂移
import { ProjectHubProjectHall } from '~/features/project-hub';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = { title: `${t('page.projects.title')} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink('/projects')}
  navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}
>
  <div class="space-y-6">
    <h1 class="text-3xl font-bold text-deep-text">{t('page.projects.title')}</h1>
    <div class="min-h-[400px]"><ProjectHubProjectHall client:load /></div>
  </div>
</Layout>
