---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import { getPermalink } from '~/lib/utils/permalinks';
import { logSsrError } from '~/lib/fetch-ssr';
import { fetchArticleCategories } from '~/lib/api';
import { t } from '~/lib/i18n';

const { categories, error } = await fetchArticleCategories();
logSsrError('所有分类', error);

const metadata = { title: `${t('page.articles.categoriesTitle')} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink('/articles')}
  navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}
>
  <div class="space-y-6">
    <header>
      <h1 class="text-3xl font-bold text-deep-text">{t('page.articles.categoriesTitle')}</h1>
      <p class="mt-2 text-text-muted">{t('page.articles.categoriesSubtitle', { count: categories.length })}</p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((cat) => (
          <a
            href={getPermalink(`/articles/category/${cat.slug}`)}
            class="block p-6 bg-card-bg rounded-lg border border-surface-3 hover:border-primary transition-all hover:shadow-lg group"
          >
            <div class="flex flex-col h-full">
              <h2 class="text-xl font-semibold mb-2 group-hover:text-primary transition-colors">{cat.name}</h2>
              <p class="text-text-muted text-sm mt-auto">
                {t('page.articles.articleCount', { count: cat.article_count })}
              </p>
            </div>
          </a>
        ))
      }
    </div>

    {
      categories.length === 0 && (
        <div class="text-center py-12">
          <p class="text-text-muted text-lg">
            {error ? t('page.articles.loadFailed', { error }) : t('page.articles.categoryEmpty')}
          </p>
        </div>
      )
    }
  </div>
</Layout>
