---
import Layout from '~/layouts/OfficialSidebarLayout.astro';
import { communitySidebarLinks } from '~/features/shell-community/data/community-sidebar';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';

const metadata = { title: `${t('page.articles.aboutTitle')} —— LKM` };
---

<Layout
  metadata={metadata}
  sidebarLinks={communitySidebarLinks}
  currentPath={getPermalink('/articles')}
  navItems={['nav.home', 'nav.news', 'nav.team', 'nav.resources']}
>
  <div class="space-y-6">
    <header>
      <h1 class="text-3xl font-bold text-deep-text">{t('page.articles.aboutTitle')}</h1>
      <p class="mt-2 text-text-muted">{t('page.articles.aboutSubtitle')}</p>
    </header>

    <div class="prose prose-slate dark:prose-invert max-w-none">
      <h2>{t('page.articles.whatIs')}</h2>
      <p>{t('page.articles.whatIsP1')}</p>
      <p>
        {t('page.articles.whatIsP2a')}<a href="https://astro.build/">Astro</a>{t('page.articles.whatIsP2b')}
      </p>

      <h2>{t('page.articles.modules')}</h2>
      <p>{t('page.articles.modulesIntro')}</p>
      <ul>
        <li>
          <strong>{t('page.articles.moduleArticles')}</strong>{t('page.articles.listColon')}{
            t('page.articles.moduleArticlesDesc')
          }
        </li>
        <li>
          <strong>{t('page.articles.moduleCommunity')}</strong>{t('page.articles.listColon')}{
            t('page.articles.moduleCommunityDesc')
          }
        </li>
        <li>
          <strong>{t('page.articles.moduleAccount')}</strong>{t('page.articles.listColon')}{
            t('page.articles.moduleAccountDesc')
          }
        </li>
        <li>
          <strong>{t('page.articles.moduleTeam')}</strong>{t('page.articles.listColon')}{
            t('page.articles.moduleTeamDesc')
          }
        </li>
      </ul>

      <h2>{t('page.articles.community')}</h2>
      <p>{t('page.articles.communityP1')}</p>
      <p>{t('page.articles.communityP2')}</p>

      <h2>{t('page.articles.tech')}</h2>
      <p>
        {t('page.articles.techIntroA')}<strong>{t('page.articles.techIntroStrong')}</strong>{
          t('page.articles.techIntroB')
        }
      </p>
      <ul>
        <li>{t('page.articles.techList1')}</li>
        <li>
          {t('page.articles.techList2a')}<code>API_URL</code>{t('page.articles.techList2b')}
        </li>
        <li>
          {t('page.articles.techList3a')}<code>/api/*</code>{t('page.articles.techList3b')}<code>/graphql</code>
          {t('page.articles.techList3c')}
        </li>
        <li>{t('page.articles.techList4')}</li>
      </ul>

      <h2>{t('page.articles.projectInfo')}</h2>
      <ul>
        <li>
          <strong>{t('page.articles.repoAddress')}</strong>{t('page.articles.listColon')}<a
            href="https://github.com/LKM-AHZ/LKM-official-website">github.com/LKM-AHZ/LKM-official-website</a
          >
        </li>
        <li>
          <strong>{t('page.articles.techStack')}</strong>{t('page.articles.listColon')}{
            t('page.articles.techStackValue')
          }
        </li>
      </ul>
    </div>
  </div>
</Layout>
