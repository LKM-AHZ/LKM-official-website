---
import { Icon } from "astro-icon/components";
import { siteConfig } from "~/lib/config";
import type { NavBarLink } from "~/types/config";
import { url } from "~/lib/utils/url-utils";
import { t } from "~/lib/i18n";
import PreferencesMenu from "~/features/shell/components/PreferencesMenu.vue";
import { SearchGlobalSearch } from "~/features/search";
import { NotificationBell } from "~/features/notification";
import UserAvatarMenu from "~/features/shell/components/user/UserAvatarMenu.vue";

interface Props {
  class?: string;
  links: NavBarLink[];
}

const className = Astro.props.class;
const navInnerClass = [
  "grid h-[4.5rem] grid-cols-[minmax(0,1fr)_auto] items-center border-b border-surface-3 bg-card-bg/95 px-4 shadow-[0_1px_3px_rgb(0_0_0_/_0.04)] backdrop-blur-xl sm:px-6 xl:grid-cols-[auto_1fr_auto]",
  className,
]
  .filter(Boolean)
  .join(" ");

const links: NavBarLink[] = Astro.props.links;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div id="navbar" class="z-50 onload-animation">
  <div class={navInnerClass}>
    <!-- 左侧：首页入口 -->
    <div class="flex min-w-0 items-center gap-1 justify-self-start">
      <a
        href={url("/")}
        class="flex h-12 items-center rounded-full px-2 font-semibold text-deep-text transition-colors hover:bg-btn-plain-bg-hover focus-visible:outline-2 focus-visible:outline-primary sm:px-3"
      >
        <div class="flex items-center gap-2.5 text-lg tracking-normal">
          <span class="grid h-7 w-7 grid-cols-2 gap-0.5" aria-hidden="true">
            <span class="rounded-[4px] bg-[#4285f4]"></span><span
              class="rounded-[4px] bg-[#ea4335]"></span>
            <span class="rounded-[4px] bg-[#fbbc04]"></span><span
              class="rounded-[4px] bg-[#34a853]"></span>
          </span>
          {siteConfig.title}
        </div>
      </a>
    </div>

    <!-- 中间：导航链接列表 -->
    <nav
      class="hidden items-center gap-1 pl-8 xl:flex"
      id="navbar-links"
      aria-label={t("nav.navigation")}
    >
      {
        links.map((l, idx) => {
          const hasChildren = l.children && l.children.length > 0;
          if (!hasChildren) {
            return (
              <a
                aria-label={t(l.name)}
                href={l.external ? l.url : url(l.url)}
                target={l.external ? "_blank" : null}
                rel={l.external ? "noopener noreferrer" : null}
                aria-current={
                  currentPath === (url(l.url).replace(/\/$/, "") || "/")
                    ? "page"
                    : undefined
                }
                class:list={[
                  "flex h-10 items-center gap-1 rounded-full px-4 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-primary",
                  currentPath === (url(l.url).replace(/\/$/, "") || "/")
                    ? "bg-btn-regular-bg text-primary-readable"
                    : "text-text-muted hover:bg-btn-plain-bg-hover hover:text-deep-text",
                ]}
              >
                {t(l.name)}
                {l.external && (
                  <Icon
                    name="fa6-solid:arrow-up-right-from-square"
                    class="text-[0.875rem] -translate-y-[1px] text-black/20 dark:text-white/30"
                  />
                )}
              </a>
            );
          }
          const isCurrent =
            currentPath ===
              (url(l.url).split("?")[0].replace(/\/$/, "") || "/") ||
            l.children!.some(
              (child) =>
                currentPath ===
                (url(child.url).split("?")[0].replace(/\/$/, "") || "/"),
            );
          return (
            <div class="relative dropdown" data-nav-dropdown={idx}>
              <div
                class:list={[
                  "flex h-10 items-center rounded-full text-sm font-medium transition-colors hover:bg-btn-plain-bg-hover",
                  isCurrent
                    ? "bg-btn-regular-bg text-primary-readable"
                    : "text-text-muted hover:text-deep-text",
                ]}
              >
                <a
                  href={url(l.url)}
                  aria-current={
                    currentPath === (url(l.url).replace(/\/$/, "") || "/")
                      ? "page"
                      : undefined
                  }
                  class="flex h-10 items-center rounded-l-full pl-4 pr-1 focus-visible:outline-2 focus-visible:outline-primary"
                >
                  {t(l.name)}
                </a>
                <button
                  type="button"
                  aria-label={`${t(l.name)}：${t("nav.navigation")}`}
                  aria-expanded="false"
                  class="flex h-10 w-7 items-center justify-center rounded-r-full focus-visible:outline-2 focus-visible:outline-primary"
                  data-dropdown-trigger
                >
                  <Icon
                    name="material-symbols:keyboard-arrow-down-rounded"
                    class="text-[1rem] transition-transform"
                    data-dropdown-arrow
                  />
                </button>
              </div>
              <div
                class="absolute left-0 top-full pt-2 hidden z-50"
                data-dropdown-menu
              >
                <div class="float-panel min-w-48 rounded-2xl border border-surface-3 bg-card-bg p-2 shadow-lg">
                  {l.children!.map((child) => (
                    <a
                      aria-label={t(child.name)}
                      href={child.external ? child.url : url(child.url)}
                      target={child.external ? "_blank" : null}
                      rel={child.external ? "noopener noreferrer" : null}
                      class="mb-0.5 flex h-10 w-full items-center whitespace-nowrap rounded-xl px-3 text-sm font-medium text-deep-text transition-colors hover:bg-btn-plain-bg-hover hover:text-primary-readable"
                    >
                      {t(child.name)}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </nav>

    <!-- 右侧：功能按钮组 -->
    <div class="flex justify-self-end items-center gap-1">
      <div class="flex h-11 min-w-11 items-center justify-center xl:w-44">
        <SearchGlobalSearch client:only="vue" compact />
      </div>
      <div class="hidden xl:block"><NotificationBell client:idle /></div>
      <div class="hidden xl:block">
        <PreferencesMenu
          client:load
          allowColor={!siteConfig.themeColor.fixed}
        />
      </div>
      <UserAvatarMenu client:idle base={url("/")} />
      <button
        aria-label="Menu"
        name="Nav Menu"
        class="group flex h-11 w-11 items-center justify-center rounded-full text-deep-text transition-colors hover:bg-btn-plain-bg-hover focus-visible:outline-2 focus-visible:outline-primary xl:!hidden"
        id="nav-menu-switch"
      >
        <Icon
          name="material-symbols:menu-rounded"
          class="text-[1.25rem] transition-transform duration-300"
          data-menu-icon
        />
      </button>
    </div>
  </div>
</div>
<!-- Extracted reference: src/features/shell/scripts/navbar.ts (navbar scripts) -->
<script is:inline>
  // swup 导航（#navbar-wrapper 现在是动态容器）会重建或复用顶栏节点，且容器内 is:inline
  // 脚本会被 reloadScripts 重跑。同一节点若被重复绑定 click，叠加偶数个 handler 会导致
  // 下拉/面板按钮「点击开了又关」失灵（需整页刷新才恢复）。因此绑定标记须持久化到元素
  // 自身属性（WeakSet 会在脚本重跑时重置，不可用），保证同一 DOM 节点只绑一次。
  // 标记用带前缀的私有属性，避免与外部 setAttribute/data-* 冲突。
  // 用 var 而非 const：本内联脚本位于 Swup 容器内，会被 reloadScripts 在每次过渡时重新执行，
  // 顶层 const 重复声明会抛 "Identifier 'B' has already been declared"，中断整个脚本及后续
  // 绑定 → 页面切换/导航水合异常。var 重复声明合法（仅覆盖），保证重跑安全、可重绑新节点。
  var B = "__lkmBound__";
  function mark(el) {
    if (el) el[B] = true;
  }
  function bound(el) {
    return !!el && el[B] === true;
  }

  function bindNavbarButtons() {
    // ── nav-menu 面板（移动端） ──
    const menuBtn = document.getElementById("nav-menu-switch");
    const menuIcon = menuBtn?.querySelector("[data-menu-icon]");
    if (menuBtn?.id && !bound(menuBtn)) {
      mark(menuBtn);
      menuBtn.addEventListener("click", function nmHandler(e) {
        e.stopPropagation();
        document
          .querySelectorAll("[data-dropdown-menu]")
          .forEach((m) => m.classList.add("hidden"));
        document
          .querySelectorAll("[data-dropdown-trigger]")
          .forEach((b) => b.setAttribute("aria-expanded", "false"));
        document
          .querySelectorAll("[data-dropdown-arrow]")
          .forEach((a) => a.classList.remove("rotate-180"));
        document
          .getElementById("mobile-nav-fuwari")
          ?.dispatchEvent(new CustomEvent("mobile-nav:toggle"));
      });
    }

    // ── navbar dropdown ──
    document.querySelectorAll("[data-nav-dropdown]").forEach((dropdown) => {
      const trigger = dropdown.querySelector("[data-dropdown-trigger]");
      const menu = dropdown.querySelector("[data-dropdown-menu]");
      const arrow = dropdown.querySelector("[data-dropdown-arrow]");
      if (!trigger || !menu) return;
      // 同一 trigger 节点只绑一次（标记持久化在元素上，脚本重跑/节点复用也不重复绑定）
      if (bound(trigger)) return;
      mark(trigger);

      trigger.addEventListener("click", function ddHandler(e) {
        e.stopPropagation();
        const isOpen = !menu.classList.contains("hidden");
        // 关闭其他所有弹出
        document
          .querySelectorAll("[data-dropdown-menu]")
          .forEach((m) => m.classList.add("hidden"));
        document
          .querySelectorAll("[data-dropdown-trigger]")
          .forEach((b) => b.setAttribute("aria-expanded", "false"));
        document
          .querySelectorAll("[data-dropdown-arrow]")
          .forEach((a) => a.classList.remove("rotate-180"));
        if (!isOpen) {
          menu.classList.remove("hidden");
          trigger.setAttribute("aria-expanded", "true");
          if (arrow) arrow.classList.add("rotate-180");
        }
      });
    });

    // 监听面板状态切换图标（同一面板节点只 observe 一次，防重复叠加触发）
    const panelRoot = document.getElementById("mobile-nav-fuwari");
    const panelEl = panelRoot?.querySelector("[data-nav-panel]");
    if (panelEl && menuIcon && !bound(panelEl)) {
      mark(panelEl);
      const observer = new MutationObserver(() => {
        const isOpen = !panelEl.classList.contains("translate-x-full");
        if (isOpen) {
          menuIcon.setAttribute("name", "material-symbols:close");
        } else {
          menuIcon.setAttribute("name", "material-symbols:menu-rounded");
        }
      });
      observer.observe(panelEl, {
        attributes: true,
        attributeFilter: ["class"],
      });
    }
  }

  // ── 全局：点击外部收起所有面板（document 上只需绑定一次） ──
  if (!window.__navbar_outside) {
    window.__navbar_outside = true;
    document.addEventListener("click", () => {
      document
        .querySelectorAll("[data-dropdown-menu]")
        .forEach((m) => m.classList.add("hidden"));
      document
        .querySelectorAll("[data-dropdown-trigger]")
        .forEach((b) => b.setAttribute("aria-expanded", "false"));
      document
        .querySelectorAll("[data-dropdown-arrow]")
        .forEach((a) => a.classList.remove("rotate-180"));
    });
  }

  // 首次加载绑定
  bindNavbarButtons();
  // View Transitions 导航后重新绑定
  document.addEventListener("astro:after-swap", bindNavbarButtons);

  function updateProfileLink() {
    try {
      const saved = localStorage.getItem("lkm-auth-store");
      if (!saved) return;
      const data = JSON.parse(saved);
      const username = data.user?.username;
      if (!username) return;
      document.querySelectorAll("a").forEach((a) => {
        if ((a.textContent || "").trim() === "个人主页") {
          const base = window.__BASE_URL__ || "/";
          a.setAttribute("href", base.replace(/\/$/, "") + `/user/${username}`);
        }
      });
    } catch {
      /* empty */
    }
  }
  updateProfileLink();
  document.addEventListener("astro:after-swap", updateProfileLink);
</script>
