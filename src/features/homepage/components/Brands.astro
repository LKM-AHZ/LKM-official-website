---
import { Icon } from 'astro-icon/components';
import type { Brands as Props } from '~/types/core';

import { Image, Headline, WidgetWrapper } from '~/components/primitives';
const {
  title = '',
  subtitle = '',
  tagline = '',
  icons = [],
  images = [],
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  <div class="flex flex-wrap justify-center gap-x-6 sm:gap-x-12 lg:gap-x-24">
    {
      icons &&
        icons.map((icon) => (
          <Icon name={icon} class="py-3 lg:py-5 w-12 h-auto mx-auto sm:mx-0 text-gray-500 dark:text-gray-400" />
        ))
    }
    {
      images &&
        images.map(
          (image) =>
            image.src && (
              <div class="flex justify-center my-2 lg:my-4 py-1 px-3 rounded-md bg-page-bg">
                <Image src={image.src} alt={image.alt || ''} class="max-h-12" width={120} height={48} format="webp" />
              </div>
            )
        )
    }
  </div>
</WidgetWrapper>
