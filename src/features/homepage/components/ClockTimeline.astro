---
import { Icon } from 'astro-icon/components';
import { t } from '~/lib/i18n';
import type { TimelineData } from '~/types/core';

interface Props {
  items: TimelineData[];
}

const { items } = Astro.props;

// 提取简短年份用于钟表刻度标注
function shortYear(raw: string): string {
  const m = raw.match(/^\d{4}/);
  return m ? m[0] : raw;
}

// 空列表时 360/0 会得到 Infinity，随后的 rotate(Infinitydeg)/rotate(NaNdeg) 是无效 CSS
//（items 为空时页面本就无卡片可展示，角度给 0 即可）
const step = items.length > 0 ? 360 / items.length : 0;
const clockYears = items.map((i) => shortYear(i.year));
---

<div class="ct-root" data-clock-timeline>
  <div class="ct-layout">
    {/* ========== 左侧卡片区 ========== */}
    <div class="ct-cards-col" data-ct-cards-col>
      <div class="ct-cards-viewport">
        <div class="ct-cards-track" data-ct-cards-track>
          {
            items.map((item) => (
              <div class="ct-card">
                <div class="ct-card-body">
                  <div class="font-mono text-[28px] font-bold text-primary mb-2">{item.year}</div>
                  <div class="text-[30px] font-semibold text-neutral-800 dark:text-neutral-100 border-b border-primary pb-2 mb-3">
                    {item.title}
                  </div>
                  <div class="text-[15px] leading-relaxed text-neutral-600 dark:text-neutral-300">
                    {item.description}
                  </div>
                </div>
                {/* 移动端：卡片内文字右侧箭头 */}
                <div class="ct-arrows ct-arrows-mobile">
                  <button
                    class="ct-arrow text-neutral-700 dark:text-neutral-200"
                    data-ct-arrow="prev"
                    aria-label={t('blog.prev')}
                  >
                    <Icon name="tabler:chevron-up" class="h-6 w-6" />
                  </button>
                  <button
                    class="ct-arrow text-neutral-700 dark:text-neutral-200"
                    data-ct-arrow="next"
                    aria-label={t('blog.next')}
                  >
                    <Icon name="tabler:chevron-down" class="h-6 w-6" />
                  </button>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      {/* 桌面端：卡片外部右侧箭头 */}
      <div class="ct-arrows ct-arrows-desktop">
        <button
          class="ct-arrow text-neutral-700 dark:text-neutral-200"
          data-ct-arrow="prev"
          aria-label={t('blog.prev')}
        >
          <Icon name="tabler:chevron-up" class="h-6 w-6" />
        </button>
        <button
          class="ct-arrow text-neutral-700 dark:text-neutral-200"
          data-ct-arrow="next"
          aria-label={t('blog.next')}
        >
          <Icon name="tabler:chevron-down" class="h-6 w-6" />
        </button>
      </div>
    </div>

    {/* ========== 右侧钟表区 ========== */}
    <div class="ct-clock-col" data-ct-clock-col>
      <div class="clock-face">
        {/* 指针 */}
        <div class="clock-pointer" data-ct-pointer>
          <div class="clock-pointer-line"></div>
        </div>
        {/* 刻度 */}
        {
          items.map((_item, i) => {
            const deg = i * step;
            return (
              <div class="clock-tick cursor-pointer flex items-center" style={`transform: rotate(${deg}deg)`}>
                <div
                  class="clock-tick-mark flex items-center justify-center text-neutral-600 dark:text-neutral-100"
                  data-ct-tick={i}
                  role="button"
                  tabindex="0"
                  aria-label={clockYears[i]}
                >
                  <span class="clock-tick-year text-neutral-600 dark:text-neutral-100 leading-none">
                    {clockYears[i]}
                  </span>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</div>
<script>
  function initClockTimeline(root: HTMLElement): void {
    const track = root.querySelector('[data-ct-cards-track]') as HTMLElement;
    const clockCol = root.querySelector('[data-ct-clock-col]') as HTMLElement;
    const allPrevBtns = root.querySelectorAll('[data-ct-arrow="prev"]');
    const allNextBtns = root.querySelectorAll('[data-ct-arrow="next"]');

    if (!track || !clockCol || allPrevBtns.length === 0 || allNextBtns.length === 0) return;

    const total = track.querySelectorAll('.ct-card').length;
    // 无卡片时下面 360/total 会得到 Infinity，指针角度变成 rotate(NaNdeg)；
    // 此时也没有任何刻度/卡片可交互，直接不初始化
    if (total === 0) return;
    let currentIndex = 0;
    const angleStep = 360 / total;

    // 每步按当前卡片的真实布局位置换算位移：卡片高度随断点 min-height、文案长度、
    // 字体/图片回流而变，只在 init 时量一次会让轨道与卡片逐级错位
    //（跨 767px 断点 resize 就会每步差 20px）。
    function measureStepOffset(): number {
      const card = track.children[currentIndex] as HTMLElement | undefined;
      if (card) {
        // 用与 track 的 rect 差值而非 offsetTop：track 自身会被 translate 变换，
        // offsetParent 会随之改变，而纯平移不影响二者 rect 之差，结果更稳。
        return (
          card.getBoundingClientRect().top -
          track.getBoundingClientRect().top
        );
      }
      const firstCard = track.querySelector('.ct-card') as HTMLElement | null;
      return firstCard
        ? firstCard.getBoundingClientRect().height * currentIndex
        : 0;
    }

    function update(): void {
      track.style.transform = `translate3d(0, -${measureStepOffset()}px, 0)`;

      // 非当前卡片只是被视觉裁掉、仍在 tab 序列里：键盘会 Tab 进屏幕外的按钮。
      // inert 把它们整体移出焦点顺序（并屏蔽点击/读屏），随 currentIndex 一起更新
      track.querySelectorAll('.ct-card').forEach((card, i) => {
        (card as HTMLElement).toggleAttribute('inert', i !== currentIndex);
      });

      const pointer = clockCol.querySelector('.clock-pointer') as HTMLElement;
      if (pointer) {
        pointer.style.transform = `rotate(${currentIndex * angleStep}deg)`;
      }

      clockCol.querySelectorAll('[data-ct-tick]').forEach((el) => {
        const idx = parseInt(el.getAttribute('data-ct-tick') || '0');
        el.classList.toggle('clock-tick-active', idx === currentIndex);
        // 刻度可聚焦（role=button），读屏需要知道当前停在哪一年
        el.setAttribute('aria-current', idx === currentIndex ? 'true' : 'false');
      });
    }

    allPrevBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentIndex = currentIndex <= 0 ? total - 1 : currentIndex - 1;
        update();
      });
    });

    allNextBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentIndex = currentIndex >= total - 1 ? 0 : currentIndex + 1;
        update();
      });
    });

    // 钟表刻度点击 → 切换到对应事件
    function selectTick(tick: Element): void {
      const idx = parseInt(tick.getAttribute('data-ct-tick') || '0');
      currentIndex = idx;
      update();
    }

    clockCol.querySelectorAll('[data-ct-tick]').forEach((tick) => {
      tick.addEventListener('click', () => selectTick(tick));
      // 刻度带 role=button/tabindex，必须同时支持键盘激活，否则聚焦后按 Enter/Space 没反应
      tick.addEventListener('keydown', (e) => {
        // addEventListener 的签名给的是 Event，key 需要自行收窄
        const key = (e as KeyboardEvent).key;
        if (key !== 'Enter' && key !== ' ') return;
        e.preventDefault();
        selectTick(tick);
      });
    });

    update();
  }

  // 首次加载直接初始化；Swup 导航后由 astro:page-load 重新初始化
  function initAllClockTimelines(): void {
    const schedule = window.requestIdleCallback || ((cb) => setTimeout(cb, 1));
    document.querySelectorAll('[data-clock-timeline]').forEach((el) => {
      schedule(() => initClockTimeline(el as HTMLElement), { timeout: 3000 });
    });
  }

  initAllClockTimelines();
  document.addEventListener('astro:page-load', initAllClockTimelines);
</script>
