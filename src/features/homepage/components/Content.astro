---
import { Icon } from 'astro-icon/components';
import { Button, Headline, WidgetWrapper, Image } from '~/components/primitives';
import type { Content as Props } from '~/types/core';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  callToAction,
  items = [],
  columns,
  image = await Astro.slots.render('image'),
  isReversed = false,
  isAfterContent = false,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// 每档都显式写全断点（含 grid-cols-1 基线）：原来缺省档返回空串，
// 靠 grid 默认单列兜底，读起来像没配置
const columnsClass =
  columns === 4
    ? 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4'
    : columns === 3
      ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'
      : columns === 2
        ? 'grid-cols-1 sm:grid-cols-2'
        : 'grid-cols-1';
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${isAfterContent ? 'pt-0 md:pt-0 lg:pt-0' : ''} ${classes?.container ?? ''}`}
  bg={bg}
>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-xl sm:mx-auto lg:max-w-2xl',
      title: 'text-[40px] font-semibold tracking-[-0.005em] mb-3 font-heading',
      subtitle: 'max-w-3xl mx-auto sm:text-center text-[17px] text-text-muted',
    }}
  />
  <div class="mx-auto max-w-7xl p-4 md:px-8">
    <div class:list={['md:flex md:gap-16', { 'md:flex-row-reverse': isReversed }]}>
      <div class="md:basis-1/2 self-center">
        {content && <div class="mb-12 text-[17px] text-text-muted leading-relaxed" set:html={content} />}

        {
          callToAction && (
            <div class="mt-[-40px] mb-8 text-primary">
              <Button variant="link" {...callToAction} />
            </div>
          )
        }

        {
          items.length > 0 && (
            <div class:list={['grid mx-auto gap-y-4 md:gap-y-8 gap-8', columnsClass]}>
              {items.map(({ title: itemTitle, description, icon, callToAction }) => (
                <div>
                  <div class="flex flex-row max-w-none">
                    <div class="flex justify-center">
                      <Icon
                        name={icon || 'tabler:check'}
                        class="flex h-5 w-5 items-center justify-center rounded-full bg-primary/10 text-primary p-1 mr-2 rtl:mr-0 rtl:ml-2"
                      />
                    </div>
                    <div class="mt-0.5">
                      {itemTitle && (
                        <h3 class="text-[17px] font-semibold leading-6 text-deep-text ml-2 rtl:ml-0 rtl:mr-2">
                          {itemTitle}
                        </h3>
                      )}
                      {description && (
                        <p
                          class:list={[
                            { 'mt-1': itemTitle },
                            'text-[14px] text-text-muted leading-relaxed ml-2 rtl:ml-0 rtl:mr-2',
                          ]}
                          set:html={description}
                        />
                      )}
                      {callToAction && (
                        <div
                          class:list={[
                            { 'mt-3': itemTitle || description },
                            'text-lg font-medium leading-6 text-deep-text ml-2 rtl:ml-0 rtl:mr-2',
                          ]}
                        >
                          <Button variant="link" {...callToAction} />
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </div>
      <div aria-hidden="true" class="mt-10 md:mt-0 md:basis-1/2">
        {
          image && (
            <div class="relative m-auto max-w-4xl">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="mx-auto w-full rounded-[16px] bg-surface-3 overflow-hidden"
                  width={500}
                  height={500}
                  widths={[400, 768]}
                  sizes="(max-width: 768px) 100vw, 432px"
                  layout="responsive"
                  format="webp"
                  {...image}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</WidgetWrapper>
