---
import { TimelineItem } from '~/components/patterns';
import type { TimelineData } from '~/types/core';

interface Props {
  items: TimelineData[];
}

const { items } = Astro.props;
---

<div class="tl-wrap relative w-full" data-timeline>
  {/* 桌面端连接线 */}
  <svg class="tl-svg hidden md:block" aria-hidden="true" fill="none" data-tl-svg-desktop>
    <path data-tl-path fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round"></path>
  </svg>
  {/* 移动端连接线 */}
  <svg class="tl-svg md:hidden" aria-hidden="true" fill="none" data-tl-svg-mobile>
    <path data-tl-path fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round"></path>
  </svg>

  <ul class="relative w-full" data-tl-list>
    {
      items.map((item, index) => (
        <TimelineItem
          year={item.year}
          title={item.title}
          description={item.description}
          iconColor={item.iconColor}
          iconName={item.iconName}
          index={index}
          total={items.length}
        />
      ))
    }
  </ul>
</div>

<style>
  .tl-wrap {
    position: relative;
  }
  .tl-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const CORNER_RADIUS = 20;

  function buildPath(dots: { x: number; y: number }[]): string {
    if (dots.length < 2) return '';
    let d = `M ${dots[0].x},${dots[0].y}`;
    for (let i = 0; i < dots.length - 1; i++) {
      const a = dots[i];
      const b = dots[i + 1];
      const ymid = (a.y + b.y) / 2;
      // 圆角半径还要受水平距离约束（短横段下 r 过大会让曲线倒着走），
      // 且用带符号的 y 差值：点的顺序异常时 Math.abs 会把路径引向错误方向
      const r = Math.max(
        0,
        Math.min(CORNER_RADIUS, ymid - a.y, b.y - ymid, Math.abs(b.x - a.x) / 2),
      );
      const dx = b.x - a.x;
      if (dx === 0 || r === 0) {
        // 同一列或圆角退化为 0：直接竖直到点，别再绕圆角
        d += ` L ${b.x},${b.y}`;
        continue;
      }
      const dir = dx > 0 ? 1 : -1;
      d += ` L ${a.x},${ymid - r}`;
      d += ` Q ${a.x},${ymid} ${a.x + dir * r},${ymid}`;
      d += ` L ${b.x - dir * r},${ymid}`;
      d += ` Q ${b.x},${ymid} ${b.x},${ymid + r}`;
      d += ` L ${b.x},${b.y}`;
    }
    return d;
  }

  function drawOne(wrap: Element, svg: SVGSVGElement, dotEls: NodeListOf<HTMLElement>, straight: boolean): void {
    const path = svg.querySelector('[data-tl-path]');
    if (!path) return;
    const wrapRect = wrap.getBoundingClientRect();
    const dots = Array.from(dotEls).map((dot) => {
      const r = dot.getBoundingClientRect();
      return { x: r.left - wrapRect.left + r.width / 2, y: r.top - wrapRect.top + r.height / 2 };
    });
    if (dots.length < 2) {
      path.setAttribute('d', '');
      return;
    }
    svg.setAttribute('width', String(wrapRect.width));
    svg.setAttribute('height', String(wrapRect.height));
    svg.setAttribute('viewBox', `0 0 ${wrapRect.width} ${wrapRect.height}`);
    if (straight) {
      path.setAttribute('d', dots.map((d, i) => `${i === 0 ? 'M' : 'L'} ${d.x},${d.y}`).join(' '));
    } else {
      path.setAttribute('d', buildPath(dots));
    }
  }

  // 只在元素确实参与渲染时测量：隐藏的那一套（hidden md:block / md:hidden）rect 全为 0，
  // 照画会写出一条所有点都塌在原点的退化路径
  function isRendered(el: Element): boolean {
    return el.getClientRects().length > 0;
  }

  function drawTimeline(wrap: Element): void {
    const list = wrap.querySelector('[data-tl-list]');
    if (!list) return;
    const svgDesktop = wrap.querySelector('[data-tl-svg-desktop]') as SVGSVGElement | null;
    if (svgDesktop && isRendered(svgDesktop)) {
      drawOne(wrap, svgDesktop, list.querySelectorAll('[data-tl-dot-desktop]'), false);
    }
    const svgMobile = wrap.querySelector('[data-tl-svg-mobile]') as SVGSVGElement | null;
    if (svgMobile && isRendered(svgMobile)) {
      drawOne(wrap, svgMobile, list.querySelectorAll('[data-tl-dot-mobile]'), true);
    }
  }

  function redrawAllTimelines(): void {
    document.querySelectorAll('[data-timeline]').forEach((wrap) => drawTimeline(wrap));
  }

  // md 断点两侧是两套 SVG 与圆点：跨断点时外层盒子可能尺寸不变、ResizeObserver 不触发，
  // 于是刚露出来的那套仍是空的（或隐藏期写下的退化路径），必须显式重画。
  // 768px 与 Tailwind 默认 md 一致（本仓未在 @theme 覆盖断点）
  window
    .matchMedia('(min-width: 768px)')
    .addEventListener('change', redrawAllTimelines);

  function initTimelines(): void {
    document.querySelectorAll('[data-timeline]').forEach((wrap) => {
      drawTimeline(wrap);
      new ResizeObserver(() => drawTimeline(wrap)).observe(wrap);
    });
  }

  // 首次加载直接初始化；Swup 导航后由 astro:page-load 重新初始化
  initTimelines();
  document.addEventListener('astro:page-load', initTimelines);
</script>
