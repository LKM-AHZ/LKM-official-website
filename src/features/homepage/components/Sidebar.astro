---
import { Icon } from "astro-icon/components";
import { t } from "~/lib/i18n";
import styles from "./Sidebar.module.css";

interface SidebarGroup {
  text: string;
  href: string;
  icon: string;
}

interface SidebarLogo {
  src: string;
  text: string;
  href: string;
}

interface Props {
  logo?: SidebarLogo;
  groups?: SidebarGroup[];
  currentPath?: string;
}

const { logo, groups = [], currentPath = "" } = Astro.props;
---

<nav
  class:list={[
    styles.shell,
    "fixed top-[72px] left-0 h-[calc(100vh-72px)] bg-base-100 z-10 pl-2 overflow-hidden border-r border-base-300",
  ]}
  aria-label="Sidebar navigation"
  data-sidebar
>
  <ul class={styles.nav}>
    {
      logo && (
        <li
          class:list={[styles.logoItem, { active: currentPath === logo.href }]}
        >
          <a href={logo.href}>
            <div class={styles.icon}>
              <div class={styles.imageBox}>
                <img src={logo.src} alt={logo.text} />
              </div>
            </div>
            <div class={styles.text}>{logo.text}</div>
          </a>
        </li>
      )
    }

    {
      groups.map(({ text, href, icon }) => {
        const isActive = (() => {
          const linkUrl = new URL(href, "https://example.com");
          if (linkUrl.hash) return currentPath === linkUrl.pathname;
          return currentPath === href || currentPath.startsWith(href + "#");
        })();

        return (
          <li class:list={{ active: isActive }}>
            <a href={href}>
              <div class={styles.icon}>
                <Icon name={icon} />
              </div>
              <div class={styles.text}>{t(text)}</div>
            </a>
          </li>
        );
      })
    }
  </ul>

  <button
    class={styles.toggle}
    aria-label="Toggle sidebar"
    id="sidebar-toggle-btn"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg
    >
    <span class={styles.toggleText}>{t("blog.collapse")}</span>
  </button>
</nav>

<!-- 本脚本设为 is:inline：侧边栏容器 #sidebar-wrapper 现已加入 Swup containers，
     容器内内联脚本会被 reloadScripts 在每次导航过渡时重跑。因此必须：
     1) 用 IIFE + var 包裹，避免顶层 const/let 重复声明抛 "already declared" 中断脚本；
     2) 各生命周期监听（document 点击委托 / window scroll / matchMedia）只注册一次（持久化到
        window 的标记属性，IIFE 重跑不重置），仅节点态初始化每次对新 sidebar 节点重做。
     事件改用 document 级委托：Swup 切换后旧节点被替换、新节点进入，委托监听天然覆盖新节点，
     无需逐个节点重绑，杜绝切换多次后监听叠加导致的功能失灵（顶栏 dropdown 曾踩过此坑）。 -->
<script is:inline>
  (function () {
    var currentSidebar = function () {
      return document.querySelector("[data-sidebar]");
    };
    var currentMain = function () {
      return document.querySelector("[data-main-content]");
    };

    // 折叠状态恢复/同步：仅在切换后对新节点调用（SSR 首帧已由 BaseLayout 内联脚本设定
    // html.sidebar-collapsed，此处将 shell 收起态与文档级标记对齐，不触碰 main 内联 padding，
    // 避免首帧后改布局触发 CLS）。
    function syncToggleState() {
      var sidebar = currentSidebar();
      if (!sidebar) return;
      var stored = null;
      try {
        stored = localStorage.getItem("sidebar-expanded");
      } catch {
        /* noop */
      }
      var mobile = window.matchMedia("(max-width: 767px)").matches;
      var collapsed = stored !== null ? stored === "false" : mobile;
      var prevTransition = sidebar.style.transition;
      sidebar.style.transition = "none";
      sidebar.classList.toggle("collapsed", collapsed);
      document.documentElement.classList.toggle("sidebar-collapsed", collapsed);
      void sidebar.offsetWidth;
      sidebar.style.transition = prevTransition;
    }

    // 用户点击折叠按钮：切换展开态并持久化，同步主内容偏移。
    function setExpanded(expanded) {
      var sidebar = currentSidebar();
      if (!sidebar) return;
      var mobile = window.matchMedia("(max-width: 767px)").matches;
      sidebar.classList.toggle("collapsed", !expanded);
      document.documentElement.classList.toggle("sidebar-collapsed", !expanded);
      var main = currentMain();
      if (main) {
        main.style.paddingLeft = (expanded ? (mobile ? 200 : 240) : (mobile ? 50 : 67)) + "px";
      }
      try {
        localStorage.setItem("sidebar-expanded", String(expanded));
      } catch {
        /* noop */
      }
    }

    // 依据当前路径+hash 更新 .active。跨页路径高亮由 SSR 渲染，此处仅当存在 hash 锚点
    // 时按 hash 高亮；无 hash 时保持 SSR 的路径高亮不被误清。
    function updateActive() {
      var sidebar = currentSidebar();
      if (!sidebar) return;
      var currentHash = location.hash;
      var currentPath = location.pathname.replace(/\/$/, "");
      sidebar.querySelectorAll("a[href]").forEach(function (a) {
        var href = a.getAttribute("href");
        if (!href) return;
        var linkUrl = new URL(href, location.origin);
        if (linkUrl.pathname.replace(/\/$/, "") !== currentPath) return;
        var li = a.closest("li");
        if (!li) return;
        var isActive = linkUrl.hash ? linkUrl.hash === currentHash : !currentHash;
        if (isActive) {
          li.classList.add("active");
        } else if (!linkUrl.hash) {
          li.classList.remove("active");
        }
      });
    }

    // 文档级点击委托：折叠按钮 + 锚点链接。仅注册一次（无论脚本被 reloadScripts 重跑多少次）。
    if (!window.__lkmSidebarBound) {
      window.__lkmSidebarBound = true;

      document.addEventListener("click", function (e) {
        var target = e.target;
        if (target.closest && target.closest("#sidebar-toggle-btn")) {
          var sidebar = currentSidebar();
          if (!sidebar) return;
          setExpanded(sidebar.classList.contains("collapsed"));
          return;
        }
        var link = target.closest ? target.closest("[data-sidebar] a[href]") : null;
        if (!link) return;
        var href = link.getAttribute("href");
        if (!href) return;
        var url = new URL(href, location.origin);
        var isSamePage =
          url.pathname.replace(/\/$/, "") === location.pathname.replace(/\/$/, "");
        var hash = url.hash;
        if (!hash || !isSamePage) return;
        e.preventDefault();
        var anchorTarget = document.querySelector(hash);
        if (anchorTarget) {
          anchorTarget.scrollIntoView({ behavior: "smooth" });
          history.replaceState(null, "", hash);
          updateActive();
        }
      });

      // window scroll：新 sidebar 节点替换后本监听仍生效（内部动态取当前节点）。
      var scrollTicking = false;
      window.addEventListener(
        "scroll",
        function () {
          if (scrollTicking) return;
          scrollTicking = true;
          requestAnimationFrame(function () {
            scrollTicking = false;
            var sidebar = currentSidebar();
            if (!sidebar) return;
            var links = sidebar.querySelectorAll("a[href]");
            var sections = Array.prototype.filter.call(links, function (a) {
              var href = a.getAttribute("href");
              if (!href) return false;
              var url = new URL(href, location.origin);
              return (
                url.pathname.replace(/\/$/, "") ===
                  location.pathname.replace(/\/$/, "") && url.hash
              );
            })
              .map(function (a) {
                var url = new URL(a.getAttribute("href"), location.origin);
                return document.querySelector(url.hash);
              })
              .filter(Boolean);
            if (sections.length === 0) return;
            var currentId = "";
            for (var i = 0; i < sections.length; i++) {
              if (sections[i].getBoundingClientRect().top <= 120) {
                currentId = "#" + sections[i].id;
              }
            }
            if (currentId && location.hash !== currentId) {
              history.replaceState(null, "", currentId);
              updateActive();
            } else if (!currentId && location.hash) {
              history.replaceState(null, "", location.pathname);
              updateActive();
            }
          });
        },
        { passive: true }
      );

      // 视口断点切换时重新对齐折叠态（读 localStorage 重算）。
      window
        .matchMedia("(max-width: 767px)")
        .addEventListener("change", syncToggleState);
    }

    // 首次加载与每次 Swup 导航后：对新 sidebar 节点恢复/同步折叠态，并刷新 hash 高亮。
    syncToggleState();
    updateActive();
    document.addEventListener("astro:after-swap", function () {
      syncToggleState();
      updateActive();
    });
  })();
</script>
