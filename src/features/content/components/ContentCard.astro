---
import { Icon } from 'astro-icon/components';
import type { ContentItem } from '~/types/content.d';
import { getPermalink } from '~/lib/utils/permalinks';
import { t, getLocale } from '~/lib/i18n';

export interface Props {
  post: ContentItem;
}

const { post } = Astro.props;

function formatTime(dateStr: string): string {
  const date = new Date(dateStr);
  const now = new Date();
  const diff = now.getTime() - date.getTime();
  const days = Math.floor(diff / 86400000);
  if (days === 0) return t('community.forum.today');
  if (days === 1) return t('community.forum.yesterday');
  if (days < 7) return t('community.forum.daysAgo', { count: days });
  return date.toLocaleDateString(getLocale(), { month: 'short', day: 'numeric' });
}

function formatCount(n: number): string {
  if (n >= 10000) return t('community.forum.countTenThousand', { count: (n / 10000).toFixed(1) });
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return String(n);
}

// 内容体裁判别
const TYPE_LABEL: Record<string, string> = {
  discussion: '',
  article: '官方',
  column_post: '专栏',
  blog_post: '博客',
};

const timeStr = formatTime(post.created_at);
const authorName = post.author_name || post.publisher || t('community.forum.anonymous');
const typeLabel = TYPE_LABEL[post.content_type] ?? '';
---

<a href={getPermalink(`/forum/post/${post.id}`)} class="profile-card group block">
  <div class="profile-inner p-4 flex flex-col gap-2.5">
    <!-- 标记：内容体裁 + 置顶/精华 -->
    <div class="flex items-center gap-2">
      {
        typeLabel && (
          <span class="inline-flex items-center gap-1 text-xs px-1.5 py-0.5 rounded font-medium bg-primary/10 text-primary">
            {typeLabel}
          </span>
        )
      }
      {
        post.is_pinned && (
          <span class="inline-flex items-center gap-1 text-xs px-1.5 py-0.5 rounded font-medium bg-red-100 dark:bg-red-950/30 text-red-600 dark:text-red-400">
            <Icon name="tabler:pin" class="w-3 h-3" />
            {t('community.forum.pinned')}
          </span>
        )
      }
      {
        post.is_featured && (
          <span class="inline-flex items-center gap-1 text-xs px-1.5 py-0.5 rounded font-medium bg-amber-100 dark:bg-amber-950/30 text-amber-600 dark:text-amber-400">
            <Icon name="tabler:star-filled" class="w-3 h-3" />
            {t('community.forum.featured')}
          </span>
        )
      }
    </div>

    <!-- 标题 -->
    <h3 class="font-semibold text-deep-text group-hover:text-primary transition-colors leading-snug line-clamp-2">
      {post.title}
    </h3>

    <!-- 摘要 -->
    <p class="text-sm text-text-muted line-clamp-2 leading-relaxed">{post.excerpt || post.summary}</p>

    <!-- 标签 -->
    {
      post.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {post.tags.map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded-full bg-surface-3 text-text-muted">{tag}</span>
          ))}
        </div>
      )
    }

    <!-- 底部信息 -->
    <div class="flex items-center justify-between text-xs text-text-muted/60 pt-2 border-t border-surface-3">
      <div class="flex items-center gap-3">
        <span>{authorName}</span>
        <span>{timeStr}</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1">
          <Icon name="tabler:eye" class="w-3.5 h-3.5" />
          {formatCount(post.view_count)}
        </span>
        <span class="inline-flex items-center gap-1">
          <Icon name="tabler:heart" class="w-3.5 h-3.5" />
          {formatCount(post.like_count)}
        </span>
        <span class="inline-flex items-center gap-1">
          <Icon name="tabler:message-circle" class="w-3.5 h-3.5" />
          {post.comment_count}
        </span>
      </div>
    </div>
  </div>
</a>
