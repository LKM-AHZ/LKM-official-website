---
import { t } from '~/lib/i18n';

interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  width?: number;
  align?: 'left' | 'center' | 'right';
}

// alt 缺省时退回 caption：空 alt 会把有信息量的内容图标记成装饰图，
// 直接从无障碍树里摘掉；两者都没有才是真的没描述可给
const { src, caption, alt = caption ?? '', width, align = 'center' } = Astro.props as Props;

// 用 Props 的联合类型做键：MDX/内容侧传进来非法 align（如 "justify"）时，
// 查找结果 undefined 会让 class:list 注入空项，故下面显式回退到 center
const alignClasses: Record<NonNullable<Props['align']>, string> = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
};
---

<figure
  class:list={['my-6', alignClasses[align] ?? alignClasses.center, 'not-prose']}
>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        class="rounded-lg inline-block"
        style={{
          width: width ? `${width}px` : 'auto',
          maxWidth: '100%',
          height: 'auto',
        }}
      />
    ) : (
      <div class="border-2 border-dashed border-surface-3 rounded-lg p-8 text-deep-text/50">
        <p class="text-center text-sm">{t('primitives.noImage')}</p>
      </div>
    )
  }
  {caption && <figcaption class="text-xs text-deep-text/60 mt-2">{caption}</figcaption>}
</figure>
