---
import { ANALYTICS } from '~/lib/config';

// 原先按 ANALYTICS.vendors.googleAnalytics.partytown 决定 script type="text/partytown"，
// 但该字段在 site.ts 的 SharedAnalyticsConfig 里从不赋值、项目也没有 @astrojs/partytown 依赖：
// 恒为 false 的死分支，一旦被误设为 true 反而会让 GA 脚本以 text/partytown 类型静默不执行，故移除。
const id = ANALYTICS?.vendors?.googleAnalytics?.id ? String(ANALYTICS.vendors.googleAnalytics.id) : '';
---

{id && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />}

{id && (
  <script is:inline define:vars={{ gaId: id }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function (...args) {
      window.dataLayer.push(args);
    };
    window.gtag('js', new Date());
    window.gtag('config', gaId);
  </script>
)}
