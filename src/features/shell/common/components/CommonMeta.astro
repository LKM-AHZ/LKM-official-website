---
import { getAsset } from "~/lib/utils/permalinks";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

{
  /* sitemap 只在配置了稳定对外域名时生成，未绑定域名时不暴露空链接 */
  Astro.site && (
    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href={getAsset("/sitemap-index.xml")}
    />
  )
}
