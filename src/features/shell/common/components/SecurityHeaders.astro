---
// 安全 Headers（通过 HTML <meta> 标签实现，GitHub Pages 不支持 HTTP headers）
//
// ⚠️ 能力边界：<meta http-equiv> 下发的 CSP 会被浏览器忽略若干关键指令——
// frame-ancestors、report-uri/report-to、sandbox 都不生效。也就是说本组件
// **不能防点击劫持，也没有违规上报通道**；这两项必须在托管/网关侧
// （Cloudflare/Vercel 前置、或反代/网关）补 frame-ancestors / X-Frame-Options 与上报端点。
//
// CSP 通过 meta 标签实现，但策略需与现有内联脚本兼容：
// - 不使用 'strict-dynamic' 以避免破坏 Astro/Partytown/Vue 等框架的内联脚本
// - img-src/script-src 允许 HTTPS 和 'unsafe-inline'（当前架构依赖内联脚本）
//   ⚠️ 已知取舍：script-src 里 'unsafe-inline' 与 host 白名单**同时存在**时，白名单不会
//   收紧内联脚本的执行——任意注入的 <script> 仍会跑，CSP 对 XSS 的这道防线基本失效。
//   之所以保留：预绘制主题脚本、GA 初始化、导航控制器等都靠内联注入。要收紧需改成
//   构建期脚本 hash（Astro 静态构建可产出），属独立改造，不在本次范围内。
// - frame-src 仅允许 giscus（评论系统）
//
// connect-src 里的 Sentry ingest 主机随 DSN 而变，写死会在配置了
// PUBLIC_SENTRY_DSN 后被 CSP 静默拦截（只报 console 错，极难定位），
// 因此从 DSN 推导 origin；未配置/格式非法时为 null，由 filter 过滤掉。
const sentryDsn = (
  import.meta.env.PUBLIC_SENTRY_DSN as string | undefined
)?.trim();
let sentryOrigin: string | null = null;
if (sentryDsn) {
  try {
    sentryOrigin = new URL(sentryDsn).origin;
  } catch {
    sentryOrigin = null;
  }
}
const csp = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline' https://giscus.app https://www.googletagmanager.com https://www.google-analytics.com",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https: blob:",
  "font-src 'self' https://fonts.gstatic.com",
  "frame-src 'self' https://giscus.app",
  [
    "connect-src 'self'",
    "https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com",
    // GA4 除 www 外还会用区域端点做 collect 上报
    "https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com",
    sentryOrigin,
  ]
    .filter(Boolean)
    .join(' '),
  "media-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  // form-action 不回退到 default-src：不显式声明时，注入的 <form action="https://evil"> 仍可提交
  "form-action 'self'",
].join('; ');
---

<meta http-equiv="Content-Security-Policy" content={csp} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
