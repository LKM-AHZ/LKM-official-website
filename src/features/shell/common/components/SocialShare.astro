---
import { Icon } from 'astro-icon/components';
import { t } from '~/lib/i18n';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-block' } = Astro.props;
---

<div class={className}>
  <span class="align-super font-bold text-text-muted">Share:</span>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Twitter Share"
    aria-label={t('share.twitter')}
    data-aw-social-share="twitter"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:brand-x" class="w-6 h-6 text-text-muted hover:text-deep-text" />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Facebook Share"
    aria-label={t('share.facebook')}
    data-aw-social-share="facebook"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:brand-facebook" class="w-6 h-6 text-text-muted hover:text-deep-text" />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Linkedin Share"
    aria-label={t('share.linkedin')}
    data-aw-social-share="linkedin"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:brand-linkedin" class="w-6 h-6 text-text-muted hover:text-deep-text" />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Whatsapp Share"
    aria-label={t('share.whatsapp')}
    data-aw-social-share="whatsapp"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:brand-whatsapp" class="w-6 h-6 text-text-muted hover:text-deep-text" />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Email Share"
    aria-label={t('share.email')}
    data-aw-social-share="mail"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:mail" class="w-6 h-6 text-text-muted hover:text-deep-text" />
  </button>
</div>
