---
import merge from 'lodash.merge';
import { SEO } from 'astro-seo';

import type { SEOProps } from 'astro-seo';

import { SITE, METADATA, I18N } from '~/lib/config';
import type { MetaData, MetaDataOpenGraph } from '~/types/core';
import { getCanonical } from '~/lib/utils/permalinks';

import { adaptOpenGraphImages } from '~/lib/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

// images 单独按「调用方 > 配置 > 空」取一份，不交给 lodash.merge：
// merge 对数组是按索引合并而非替换（配置 2 张 + prop 1 张会得到 [prop0, config1]），
// 而 og:image 只取首图，拼出来的顺序会改掉分享卡主图。
const mergedImages = openGraph.images ?? METADATA?.openGraph?.images ?? [];

const mergedOg: MetaDataOpenGraph = {
  ...merge(
    {
      url: canonical,
      siteName: SITE?.name,
      locale: I18N?.language || 'en',
      type: 'website',
    },
    METADATA?.openGraph,
    { url: canonical, ...openGraph }
  ),
  images: mergedImages,
};

const adaptedOg = await adaptOpenGraphImages(mergedOg, Astro.site);

function buildOpenGraph(og: MetaDataOpenGraph): SEOProps['openGraph'] | undefined {
  if (!og) return undefined;

  // 取第一张「解析成功」的图：原先只看 images[0]，首图解析失败（url 为空）时会连
  // 后面可用的图一起丢掉
  const image = adaptedOg?.images?.find((i) => i?.url);
  const imageUrl = image?.url || '';

  const basic = {
    title: title || METADATA?.title?.default || '',
    type: og.type || 'website',
    url: og.url,
  };
  const optional = {
    description: description || METADATA?.description,
    // 配置里是 snake_case 的 site_name，astro-seo 要的是 siteName，
    // 不在这里搬运的话配置的 og:site_name 永远不会生效
    siteName: METADATA?.openGraph?.site_name || og.siteName,
    locale: og.locale,
  };

  // 无图时仍只能返回 undefined：astro-seo 的 SEOProps['openGraph'].basic 把 image 声明为
  // 必填（去掉这里会直接报 ts(2741)），库的模型里「有 basic 就有 og:image」。
  // 想让无图页面也拿到 og:title/og:description，只能换库或手写 <meta>，超出本单元范围。
  if (!imageUrl) return undefined;

  return {
    basic: { ...basic, image: imageUrl },
    optional,
    image: {
      url: imageUrl,
      width: image?.width,
      height: image?.height,
      alt: basic.title,
    },
  };
}

// card 由「实际有没有图」决定：配置里的 cardType 只在其与实际图片状态相容时采用，
// 否则会出现 summary_large_image 却无图（空白卡）或 summary 有图（浪费大卡）
const resolvedCard: 'summary_large_image' | 'summary' = adaptedOg?.images?.length
  ? 'summary_large_image'
  : 'summary';
const compatibleCard = (
  configured: string | undefined,
): 'summary_large_image' | 'summary' | undefined =>
  configured === resolvedCard ? resolvedCard : undefined;

const mergedTwitter = merge(
  { card: resolvedCard },
  METADATA?.twitter
    ? {
        card: compatibleCard(METADATA.twitter.cardType),
        site: METADATA.twitter.site,
        creator: METADATA.twitter.handle,
      }
    : {},
  twitter
    ? {
        card: compatibleCard(twitter.cardType),
        site: twitter.site,
        creator: twitter.handle,
      }
    : {}
);

const seoProps: SEOProps = {
  title: title || METADATA?.title?.default || '',
  titleTemplate: ignoreTitleTemplate ? '%s' : METADATA?.title?.template || '%s',
  canonical: canonical,
  noindex:
    typeof robots?.index !== 'undefined'
      ? !robots.index
      : typeof METADATA?.robots?.index !== 'undefined'
        ? !METADATA.robots.index
        : true,
  nofollow:
    typeof robots?.follow !== 'undefined'
      ? !robots.follow
      : typeof METADATA?.robots?.follow !== 'undefined'
        ? !METADATA.robots.follow
        : true,
  description: description || METADATA?.description,
  openGraph: buildOpenGraph(adaptedOg),
  twitter: mergedTwitter,
  surpressWarnings: true,
};
---

<SEO {...seoProps} />
