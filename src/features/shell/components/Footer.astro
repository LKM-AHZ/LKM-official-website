---
import { Icon } from 'astro-icon/components';
import { SITE } from '~/lib/config';
import { t } from '~/lib/i18n';
import { getHomePermalink } from '~/lib/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '' } = Astro.props;
---

<footer class:list={['relative border-t border-surface-3 not-prose']}>
  <div class="bg-white dark:bg-[oklch(0.23_0.015_var(--hue))] absolute inset-0 pointer-events-none" aria-hidden="true">
  </div>
  <div class="relative max-w-7xl mx-auto px-4 md:px-6 text-text-muted">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-[64px]">
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-2">
          <a class="inline-block text-[17px] font-semibold text-deep-text no-underline" href={getHomePermalink()}
            >{SITE?.name}</a
          >
        </div>
        <div class="text-[12px] text-text-muted flex gap-1">
          {
            secondaryLinks.map(({ text, href }, index) => (
              <>
                {/* 分隔符纯装饰：标 aria-hidden，避免读屏把它念出来 */}
                {index !== 0 ? <span aria-hidden="true"> · </span> : ''}
                <a
                  class="text-[12px] text-text-muted hover:text-deep-text hover:underline transition duration-150 ease-in-out"
                  href={href}
                  set:html={t(text)}
                />
              </>
            ))
          }
        </div>
      </div>
      {
        links.map(({ title, links: groupLinks }) => (
          <div class="col-span-12 sm:col-span-6 md:col-span-3 lg:col-span-2">
            <div class="text-[14px] font-semibold text-deep-text mb-2">{t(title)}</div>
            {groupLinks.length > 0 && (
              <ul class="text-[12px] leading-[2.41]">
                {groupLinks.map(({ text, href, ariaLabel }) => (
                  <li class="mb-2">
                    <a
                      class="text-[12px] text-text-muted hover:text-deep-text hover:underline transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={t(text)} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8 border-t border-surface-3">
      {
        socialLinks?.length ? (
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-text-muted hover:text-deep-text focus:outline-none focus:ring-2 focus:ring-[var(--primary)] rounded-[8px] text-sm p-2.5 inline-flex items-center"
                  aria-label={ariaLabel ?? (text ? undefined : icon)}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" aria-hidden="true" />}
                  <Fragment set:html={t(text)} />
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }

      <div class="text-[12px] mr-4 text-text-muted">
        <Fragment set:html={t(footNote)} />
      </div>
    </div>
  </div>
</footer>
