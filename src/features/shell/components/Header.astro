---
import { Icon } from 'astro-icon/components';
import { t } from '~/lib/i18n';
import Logo from '~/features/shell/components/Logo.astro';
import ToggleTheme from '~/features/shell/common/components/ToggleTheme.astro';
import ToggleMenu from '~/features/shell/common/components/ToggleMenu.astro';
import MobileNavPanel from '~/features/shell/components/MobileNavPanel.astro';

import { getAsset, getHomePermalink } from '~/lib/utils/permalinks';
import { trimSlash } from '~/lib/utils/paths';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  isSticky?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  showGithub?: boolean;
  /** GitHub 图标指向的地址；默认沿用本仓库既有账号，可由调用方覆盖（避免把账号写死在共享组件里） */
  githubUrl?: string;
  position?: string;
}

const {
  id = 'header',
  links = [],
  isSticky = false,
  showToggleTheme = false,
  showRssFeed = false,
  showGithub = false,
  githubUrl = 'https://github.com/LKM-AHZ',
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

// 从 MenuLink[] 转换为 MobileNavPanel 需要的格式
function toMobileLinks(
  items: Array<MenuLink>
): Array<{ name: string; url: string; children?: Array<{ name: string; url: string }> }> {
  return items.map(({ text, href, links }) => ({
    name: text || '',
    url: href || '#',
    children: links?.map(({ text: childText, href: childHref }) => ({
      name: childText || '',
      url: childHref || '#',
    })),
  }));
}

const mobileLinks = toMobileLinks(links);
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky },
    'top-0 z-40 flex-none mx-auto w-full transition-[opacity] ease-in-out',
    'border-b border-surface-3',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0 bg-white dark:bg-[oklch(0.23_0.015_var(--hue))]"></div>
  <div
    class:list={[
      'relative text-default py-2.5 px-4 md:px-6 mx-auto w-full',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-3 md:items-center': position === 'center',
      },
      'max-w-7xl',
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex items-center md:hidden">
        <ToggleMenu />
      </div>
    </div>
    <nav
      class="items-center w-full md:w-auto hidden md:flex md:mx-5 text-default overflow-y-auto overflow-x-hidden md:overflow-visible md:justify-self-center"
      aria-label={t('nav.mainNav')}
    >
      <ul
        class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-base md:text-base tracking-[-0.01em] font-medium md:justify-center"
      >
        {
          links.map(({ text, href, links }) => (
            <li class={links?.length ? 'dropdown' : ''}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-primary text-deep-text px-4 py-3 flex items-center whitespace-nowrap"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                  </button>
                  <ul class="dropdown-menu md:backdrop-blur-md rounded md:absolute pl-4 md:pl-0 md:hidden font-medium md:bg-card-bg/95 md:min-w-[200px] drop-shadow-xl">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b hover:bg-page-bg text-deep-text/90 hover:text-primary py-2 px-5 block whitespace-no-wrap',
                            { 'aw-link-active': href2 === currentPath },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-primary text-deep-text px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0 md:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full md:w-auto">
        <div class="flex gap-1">
          {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />}
          {
            showGithub && (
              <a
                class="text-text-muted hover:bg-surface-3 focus:outline-none focus:ring-4 focus:ring-base-300 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="GitHub"
                target="_blank"
                rel="noopener noreferrer"
                href={githubUrl}
              >
                <Icon name="tabler:brand-github" class="w-5 h-5" />
              </a>
            )
          }
          {
            showRssFeed && (
              <a
                class="text-text-muted hover:bg-surface-3 focus:outline-none focus:ring-4 focus:ring-base-300 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="RSS"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</header>

<!-- 注意：这个 id 必须全局唯一，且与 ToggleMenu.astro 里硬编码的 data-mobile-menu-trigger
     / aria-controls（"mobile-nav-header"，用 querySelector 只取首个匹配）保持一致；
     同页渲染两个 Header 会导致重复 id、只有第一个汉堡按钮生效。 -->
<MobileNavPanel id="mobile-nav-header" title={t('nav.navigation')} links={mobileLinks} />
