---
import { profileConfig } from '~/lib/config';
import { url } from '~/lib/utils/url-utils';

const currentYear = new Date().getFullYear();
---

<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>
<div
  class="transition border border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6"
>
  <!-- text-50 在 14px 正文下对比度不足 WCAG AA，改用 text-75 -->
  <div class="transition text-75 text-sm text-center">
    &copy; <span>{currentYear}</span>
    {profileConfig.name}. All Rights Reserved. /
    <!-- rss/sitemap 是同源资源，不必强开新标签页；只有下面的 Astro 外链保留 target/rel -->
    <a class="transition link text-primary font-medium" href={url('rss.xml')}>RSS</a
    > /
    <a class="transition link text-primary font-medium" href={url('sitemap-index.xml')}>Sitemap</a
    ><br />
    Powered by
    <a
      class="transition link text-primary font-medium"
      target="_blank"
      rel="noopener noreferrer"
      href="https://astro.build">Astro</a
    >
  </div>
</div>
