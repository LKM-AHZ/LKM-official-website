---
import { Icon } from 'astro-icon/components';
import { t } from '~/lib/i18n';
import { url } from '~/lib/utils/url-utils';

interface MobileMenuLink {
  name: string;
  url: string;
  external?: boolean;
  children?: MobileMenuLink[];
}

interface Props {
  id: string;
  links: MobileMenuLink[];
  title?: string;
}

const { id, links = [], title = t('nav.navigation') } = Astro.props;
---

<div id={id} data-mobile-nav-panel class="fixed inset-0 z-[100] pointer-events-none" aria-hidden="true" inert>
  <!-- overlay -->
  <div data-nav-overlay class="absolute inset-0 bg-black/50 dark:bg-black/70 opacity-0 transition-opacity duration-300">
  </div>

  <!-- panel -->
  <div
    data-nav-panel
    class="absolute top-0 right-0 h-full w-[85vw] max-w-xs bg-white dark:bg-[oklch(0.23_0.015_var(--hue))] shadow-2xl transition-transform duration-300 ease-out translate-x-full flex flex-col"
  >
    <!-- header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--line-divider)]">
      <span class="text-[17px] font-semibold text-deep-text">{title}</span>
      <button
        data-nav-close
        aria-label={t('nav.closeMenu')}
        class="btn-plain rounded-lg w-10 h-10 flex items-center justify-center"
      >
        <Icon name="material-symbols:close" class="text-[1.25rem]" />
      </button>
    </div>

    <!-- links -->
    <nav class="flex-1 overflow-y-auto py-2" aria-label={t('nav.mobileNav')}>
      <ul>
        {
          links.map((link) => {
            const hasChildren = link.children && link.children.length > 0;
            return (
              <li>
                {hasChildren ? (
                  <div>
                    <button
                      type="button"
                      data-nav-accordion-trigger
                      class="flex items-center justify-between w-full px-5 py-3 text-left font-semibold text-deep-text hover:bg-[var(--btn-plain-bg-hover)] transition"
                    >
                      <span>{t(link.name)}</span>
                      <Icon
                        name="material-symbols:keyboard-arrow-down-rounded"
                        class="text-[1.25rem] text-text-muted transition-transform duration-200"
                        data-nav-accordion-arrow
                      />
                    </button>
                    <ul data-nav-accordion-content class="hidden">
                      {link.children!.map((child) => (
                        <li>
                          <a
                            href={child.external ? child.url : url(child.url)}
                            target={child.external ? '_blank' : undefined}
                            rel={child.external ? 'noopener' : undefined}
                            class="flex items-center gap-2 px-8 py-2.5 text-[15px] text-text-muted hover:text-deep-text hover:bg-[var(--btn-plain-bg-hover)] transition"
                            data-nav-link
                          >
                            {t(child.name)}
                            {child.external && (
                              <Icon
                                name="fa6-solid:arrow-up-right-from-square"
                                class="text-[0.625rem] text-text-muted"
                              />
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : (
                  <a
                    href={link.external ? link.url : url(link.url)}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener' : undefined}
                    class="flex items-center gap-2 px-5 py-3 font-semibold text-deep-text hover:bg-[var(--btn-plain-bg-hover)] transition"
                    data-nav-link
                  >
                    {t(link.name)}
                    {link.external && (
                      <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.625rem] text-text-muted" />
                    )}
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</div>

<script is:inline>
  (function () {
    const openClass = 'mobile-nav-open';

    function getPanelElements(panelRoot) {
      const overlay = panelRoot.querySelector('[data-nav-overlay]');
      const panel = panelRoot.querySelector('[data-nav-panel]');
      return { overlay, panel };
    }

    function open(panelRoot) {
      const { overlay, panel } = getPanelElements(panelRoot);
      if (!overlay || !panel) return;

      panelRoot.classList.remove('pointer-events-none');
      panelRoot.removeAttribute('inert');
      panelRoot.setAttribute('aria-hidden', 'false');
      overlay.classList.remove('opacity-0');
      panel.classList.remove('translate-x-full');
      // 记下打开前的行内 overflow，关闭时还原：直接写 '' 会丢掉页面原有的值
      panelRoot.dataset.navPrevOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      document.body.classList.add(openClass);
    }

    function close(panelRoot) {
      const { overlay, panel } = getPanelElements(panelRoot);
      if (!overlay || !panel) return;

      overlay.classList.add('opacity-0');
      panel.classList.add('translate-x-full');
      document.body.classList.remove(openClass);
      // 仍有别的面板开着就保持锁定；全关才还原，避免第二个面板/弹层还锁着时被提前解锁
      let anyOpen = false;
      document.querySelectorAll('[data-nav-panel]').forEach(function (p) {
        if (!p.classList.contains('translate-x-full')) anyOpen = true;
      });
      if (!anyOpen) {
        document.body.style.overflow = panelRoot.dataset.navPrevOverflow ?? '';
      }

      setTimeout(function () {
        if (panel.classList.contains('translate-x-full')) {
          panelRoot.classList.add('pointer-events-none');
          // 关闭态用 inert 把抽屉内的链接/按钮移出 Tab 序列。
          // 只加 aria-hidden + pointer-events-none 只挡鼠标，键盘仍能 Tab 进不可见内容（WCAG 失败）。
          panelRoot.setAttribute('inert', '');
          panelRoot.setAttribute('aria-hidden', 'true');
        }
      }, 300);
    }

    function toggle(panelRoot) {
      const { panel } = getPanelElements(panelRoot);
      if (!panel) return;
      if (panel.classList.contains('translate-x-full')) {
        open(panelRoot);
      } else {
        close(panelRoot);
      }
    }

    // 每个面板只绑定一次。astro:after-swap 后会对新节点重新初始化，
    // 若重复绑定，手风琴触发的 toggle 会被执行偶数次而看似失灵，close() 也会重复执行。
    function initPanel(panelRoot) {
      if (!panelRoot || panelRoot.dataset.navInit === '1') return;
      panelRoot.dataset.navInit = '1';

      const overlay = panelRoot.querySelector('[data-nav-overlay]');
      if (overlay) {
        overlay.addEventListener('click', function () {
          close(panelRoot);
        });
      }

      const closeBtn = panelRoot.querySelector('[data-nav-close]');
      if (closeBtn) {
        closeBtn.addEventListener('click', function () {
          close(panelRoot);
        });
      }

      panelRoot.querySelectorAll('[data-nav-link]').forEach(function (link) {
        link.addEventListener('click', function () {
          setTimeout(function () {
            close(panelRoot);
          }, 150);
        });
      });

      panelRoot.querySelectorAll('[data-nav-accordion-trigger]').forEach(function (trigger) {
        trigger.addEventListener('click', function () {
          const arrow = trigger.querySelector('[data-nav-accordion-arrow]');
          // 用显式 hook 而非 nextElementSibling：模板一旦在触发器与内容间插入节点就会静默失效
          const content = trigger.parentElement?.querySelector('[data-nav-accordion-content]');
          if (!content) return;
          if (content.classList.contains('hidden')) {
            content.classList.remove('hidden');
            if (arrow) arrow.classList.add('rotate-180');
          } else {
            content.classList.add('hidden');
            if (arrow) arrow.classList.remove('rotate-180');
          }
        });
      });

      // 通过 CustomEvent 暴露面板 API，替代 window.__mobileNavPanel 全局对象
      panelRoot.addEventListener('mobile-nav:open', function () {
        open(panelRoot);
      });
      panelRoot.addEventListener('mobile-nav:close', function () {
        close(panelRoot);
      });
      panelRoot.addEventListener('mobile-nav:toggle', function () {
        toggle(panelRoot);
      });
    }

    function initAllPanels() {
      document.querySelectorAll('[data-mobile-nav-panel]').forEach(initPanel);
    }

    function closeOpenPanels() {
      document.querySelectorAll('[data-mobile-nav-panel]').forEach(function (root) {
        const panel = root.querySelector('[data-nav-panel]');
        if (panel && !panel.classList.contains('translate-x-full')) close(root);
      });
    }

    initAllPanels();

    // document 在视图切换（Swup/ClientRouter）之间是复用的，若每次导航都注册，
    // document 上的监听会逐次累积；用 documentElement 标记保证全局只注册一次。
    if (!document.documentElement.dataset.mobileNavHooked) {
      document.documentElement.dataset.mobileNavHooked = '1';

      document.addEventListener('astro:after-swap', function () {
        // 页面主体被换掉后，旧节点上的监听已随旧 DOM 一并消失，这里对新节点重新绑定
        initAllPanels();
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeOpenPanels();
      });
    }
  })();
</script>
