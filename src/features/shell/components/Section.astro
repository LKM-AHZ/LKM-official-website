---
import { Headline, WidgetWrapper } from '~/components/primitives';
import type { Widget, Headline as HeadlineType } from '~/types/core';

// 最小 props 契约（与 homepage/components/Section.astro 同口径）：此前直接复用 Features 作为 Props，
// 声明了 items/columns/variant/image 等本包装件从不读取的字段，调用方传了也只会被静默丢弃
interface Props extends Widget, Pick<HeadlineType, 'title' | 'subtitle' | 'tagline'> {
  classes?: Widget['classes'];
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<!-- 宽度/居中/内边距由 WidgetWrapper 负责（它按 width 生成 max-w-*，并已带 mx-auto/px-*）；
     这里再写死 max-w-7xl 会在 twMerge 里压掉调用方想要的 narrow 宽度。
     Widget.classes 的值类型允许嵌套对象，故先确认是字符串再透传 -->
<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={typeof classes?.container === "string"
    ? classes.container
    : undefined}
  bg={bg}
>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline} />

  <slot />
</WidgetWrapper>
