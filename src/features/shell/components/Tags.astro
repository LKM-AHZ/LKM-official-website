---
import { t } from '~/lib/i18n';
import { getTagList } from '~/lib/utils/content-utils';
import { getTagUrl } from '~/lib/utils/url-utils';
import { ButtonTag } from '~/components/primitives';
import WidgetLayout from './WidgetLayout.astro';

// 名称只归一化一次：原来 URL 用原始 name、显示与 aria-label 各自 trim，
// 三处口径可能不一致；顺便丢掉 trim 后为空的标签（否则渲染出无名 chip）
const tags = (await getTagList())
  .map((tag) => ({ ...tag, name: tag.name.trim() }))
  .filter((tag) => tag.name.length > 0);

const COLLAPSED_HEIGHT = '7.5rem';

const isCollapsed = tags.length >= 20;

interface Props {
  class?: string;
  style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout
  name={t('blog.tags')}
  id="tags"
  isCollapsed={isCollapsed}
  collapsedHeight={COLLAPSED_HEIGHT}
  class={className}
  style={style}
>
  <div class="flex gap-2 flex-wrap">
    {
      tags.map((tag) => (
        <ButtonTag href={getTagUrl(tag.name)} label={t('blog.tagLabel', { name: tag.name })}>
          {tag.name}
        </ButtonTag>
      ))
    }
  </div>
</WidgetLayout>
