---
import type { MarkdownHeading } from 'astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/primitives/Image.astro';
import TableOfContents from '~/components/patterns/TableOfContents.astro';
import ArticleTags from './ArticleTags.astro';
import type { ArticleDetail } from '~/lib/api/modules/official-articles';
import { categoryLabel } from '~/lib/api/modules/official-articles';
import { getPermalink } from '~/lib/utils/permalinks';
import { getFormattedDate } from '~/lib/utils/utils';

interface Props {
  article: ArticleDetail;
  headings?: MarkdownHeading[];
}

const { article, headings = [] } = Astro.props;
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <div class="max-w-7xl mx-auto">
    <div class="flex gap-8 relative">
      <article class="flex-1 min-w-0">
        <header>
          <div class="flex flex-wrap items-center gap-x-2 gap-y-2 text-sm max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6">
            <time datetime={article.published} class="inline-flex items-center gap-1 text-text-muted">
              <Icon name="tabler:calendar" class="w-4 h-4 -mt-0.5" />
              {getFormattedDate(new Date(article.published))}
            </time>

            {
              article.publisher && (
                <span class="inline-flex items-center gap-1 text-text-muted">
                  <Icon name="tabler:user" class="w-4 h-4 -mt-0.5" />
                  {article.publisher}
                </span>
              )
            }

            {
              article.category && (
                <a
                  href={getPermalink(`/articles/category/${article.category}`)}
                  class="inline-block text-xs px-2.5 py-0.5 rounded-full bg-primary/10 text-primary hover:bg-primary/20 transition-colors"
                >
                  {categoryLabel(article.category)}
                </a>
              )
            }

            {
              article.reading_time > 0 && (
                <span class="inline-flex items-center gap-1 text-text-muted">
                  <Icon name="tabler:clock" class="w-4 h-4 -mt-0.5" />
                  {article.reading_time} 分钟
                </span>
              )
            }
          </div>

          <h1
            class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
          >
            {article.title}
          </h1>
          <p
            class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted dark:text-slate-400 text-justify"
          >
            {article.description}
          </p>

          {
            article.cover ? (
              <Image
                src={article.cover}
                class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
                widths={[400, 900]}
                sizes="(max-width: 900px) 400px, 900px"
                alt={article.title}
                width={900}
                height={506}
                format="webp"
                loading="eager"
                decoding="async"
              />
            ) : (
              <div class="max-w-3xl mx-auto px-4 sm:px-6">
                <div class="border-t dark:border-slate-700" />
              </div>
            )
          }
        </header>

        <div
          data-article-body
          class="mx-auto px-6 sm:px-6 max-w-3xl prose prose-md lg:prose-lg dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px]"
        >
          <slot />
        </div>

        {
          article.keywords && article.keywords.length > 0 && (
            <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8">
              <ArticleTags keywords={article.keywords} />
            </div>
          )
        }
      </article>

      <aside class="hidden xl:block flex-shrink-0">
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </div>
</section>

<style is:global>
  /* 代码块语言标签：rendered markdown 的 <pre class="astro-code"> 带 data-language，
     通过 ::before 伪元素在其右上角显示语言名。仅作用于文章正文容器内。 */
  [data-article-body] pre.astro-code {
    position: relative;
  }
  [data-article-body] pre.astro-code[data-language] {
    padding-top: 2.4rem;
  }
  [data-article-body] pre.astro-code[data-language]::before {
    content: attr(data-language);
    position: absolute;
    top: 0.55rem;
    right: 0.75rem;
    padding: 0.1rem 0.5rem;
    border-radius: 0.25rem;
    background: rgba(128, 128, 128, 0.18);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: capitalize;
    color: #e1e4e8;
    user-select: none;
    pointer-events: none;
  }
  [data-article-body] pre.astro-code[data-language]::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0;
    border-bottom: 1px solid rgba(128, 128, 128, 0.25);
  }
</style>
