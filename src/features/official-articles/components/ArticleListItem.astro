---
import { Icon } from 'astro-icon/components';
import Image from '~/components/primitives/Image.astro';
import type { OfficialArticle } from '~/lib/api/modules/official-articles';
import { categoryLabel } from '~/lib/api/modules/official-articles';
import { getPermalink } from '~/lib/utils/permalinks';
import { findImage } from '~/lib/utils/images';
import { buildUrl } from '~/lib/utils/paths';
import { getFormattedDate } from '~/lib/utils/utils';

interface Props {
  article: OfficialArticle;
}

const { article } = Astro.props;
const image = (await findImage(article.cover)) ?? buildUrl('/images/article-default.png');
const link = getPermalink(`/articles/${article.slug}`);
---

<article
  class="max-w-md mx-auto md:max-w-none bg-card-bg border border-surface-3 rounded-lg p-4 md:p-5 shadow-sm transition hover:border-primary hover:shadow-lg group"
>
  <div class="flex items-start gap-4 md:gap-6">
    <a class="relative block flex-none w-28 sm:w-36 md:w-44" href={link}>
      <div
        class="relative aspect-[4/3] overflow-hidden rounded shadow-lg bg-surface-3 transition-transform duration-300 group-hover:scale-[1.03]"
      >
        <Image
          src={image}
          class="absolute inset-0 object-cover w-full h-full rounded shadow-lg bg-surface-3"
          widths={[200, 400]}
          width={400}
          height={300}
          sizes="(max-width: 900px) 200px, 400px"
          alt={article.title}
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </div>
    </a>
    <div class="min-w-0 mt-0.5 flex-1">
      <header>
        <div class="mb-1.5">
          <span class="text-sm text-text-muted">
            <Icon name="tabler:clock" class="w-3.5 h-3.5 inline-block -mt-0.5" />
            <time datetime={article.published} class="inline-block"
              >{getFormattedDate(new Date(article.published))}</time
            >
            {
              article.category && (
                <>
                  {' '}
                  ·{' '}
                  <a
                    class="font-medium hover:text-primary hover:underline transition-colors"
                    href={getPermalink(`/articles/category/${article.category}`)}
                  >
                    {categoryLabel(article.category)}
                  </a>
                </>
              )
            }
          </span>
        </div>
        <h2 class="text-lg sm:text-xl font-bold leading-tight mb-2 font-heading text-deep-text">
          <a class="inline-block hover:text-primary transition ease-in duration-200" href={link}>
            {article.title}
          </a>
        </h2>
      </header>

      {article.description && <p class="flex-grow text-text-muted text-sm sm:text-base">{article.description}</p>}
    </div>
  </div>
</article>
