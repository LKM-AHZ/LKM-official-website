---
import type { OfficialArticle } from '~/lib/api/modules/official-articles';
import Image from '~/components/primitives/Image.astro';
import { findImage } from '~/lib/utils/images';
import { getPermalink } from '~/lib/utils/permalinks';

interface Props {
  article: OfficialArticle;
}

const { article } = Astro.props;
const image = await findImage(article.cover);
const link = getPermalink(`/articles/${article.slug}`);
---

<article class="mb-6 transition">
  <div class="relative md:h-64 bg-gray-400 dark:bg-slate-700 rounded shadow-lg mb-6">
    {
      image && (
        <a href={link}>
          <Image
            src={image}
            class="w-full md:h-full object-cover rounded shadow-lg bg-gray-400 dark:bg-slate-700"
            widths={[400, 900]}
            width={900}
            height={506}
            sizes="(max-width: 900px) 400px, 900px"
            alt={article.title}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </a>
      )
    }
  </div>

  <h3 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading dark:text-slate-300">
    <a class="inline-block hover:text-primary dark:hover:text-blue-700 transition ease-in duration-200" href={link}>
      {article.title}
    </a>
  </h3>

  {article.description && <p class="text-muted dark:text-slate-400 text-lg">{article.description}</p>}
</article>
