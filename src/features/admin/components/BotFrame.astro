---
/**
 * 机器人面板内嵌容器（社区后台「机器人」各页共用）。
 *
 * 面板跑在 LKMBot 进程里（网关剥掉 /bot 前缀后转发），此处用**同源 iframe** 内嵌，保留面板
 * 原有 UI 与全部功能。
 *
 * 免登链路（详见 LKM-service 的 `app/modules/admin/bot_router.py` 与 LKM-bot 的
 * `astrbot/dashboard/api/auth_sso.py`）：
 *   1. middleware 在页面开始流式输出前检查后台 cookie，并换一张 60s 一次性票据；
 *      后端拒绝会话时直接跳登录页；
 *   2. iframe 指向面板的 `/api/v1/auth/sso?ticket=...&next=<hash 路由>`，面板验签后用面板
 *      自己的会话 cookie 落座，并 302 到 `#<hash 路由>`（URL 里不留票据）。
 *
 * 拿不到票（后端不可达/auth 未配 RS256 私钥）时降级为无票 iframe —— 面板会落到自带登录页，
 * 即「需要手动登录一次」，而不是白屏或越权。
 */
interface Props {
  /** 面板内的 hash 路由（如 `/platforms`），作为登录后的落地页。 */
  hashRoute: string;
  title: string;
}

const { hashRoute, title } = Astro.props;

const ticket = (Astro.locals as { botTicket?: string }).botTicket;
// 降级分支也带上 hashRoute：面板是 hash 路由的单页应用，能识别就直达用户点开的分区
// （识别不了也只是落回默认页，无副作用）
const iframeSrc = ticket
  ? `/bot/api/v1/auth/sso?ticket=${encodeURIComponent(ticket)}&next=${encodeURIComponent(hashRoute)}`
  : `/bot/#${hashRoute}`;
---

<!-- sandbox 的组合是**显式声明能力**，不是隔离边界：面板与本站同源，
     allow-same-origin + allow-scripts 下被嵌文档本就能摘掉自己的 sandbox 属性并触达
     父文档；反过来去掉 allow-same-origin 又会打断面板的同站会话 cookie（免登链路依赖它）。
     真正的门禁是后端会话 + 一次性 SSO 票据，故保留该组合并在此说明意图。 -->
<iframe
  src={iframeSrc}
  title={title}
  class="w-full flex-1 border-0"
  referrerpolicy="no-referrer"
  sandbox="allow-same-origin allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox allow-modals allow-downloads"
></iframe>
