---
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/lib/utils/permalinks';
import { t } from '~/lib/i18n';
import { buildAdminNav, isActive } from '../nav';

interface Props {
  /** 内容区去掉内边距并占满视口高度（供全高 iframe，如「机器人」各页）。 */
  flush?: boolean;
}

const { flush = false } = Astro.props;
const groups = buildAdminNav();
const currentPath = Astro.url.pathname;
const itemClass = (href: string) =>
  [
    'flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors',
    isActive(currentPath, href)
      ? 'bg-surface-3 text-primary font-medium'
      : 'text-text-muted hover:bg-surface-3',
  ].join(' ');
---

<div class="min-h-screen bg-page-bg flex">
  <!-- 侧边栏 -->
  <aside class="w-56 shrink-0 bg-card-bg border-r border-surface-3 min-h-screen hidden md:block">
    <div class="p-4 border-b border-surface-3">
      <a href={getPermalink('/admin')} class="text-lg font-bold text-primary">{t('admin.title')}</a>
    </div>
    <nav class="p-2 space-y-1">
      {
        groups.map((group) => (
          <>
            {group.titleKey && (
              <div class="px-3 pt-3 pb-1 text-xs font-medium uppercase tracking-wide text-text-muted">
                {t(group.titleKey)}
              </div>
            )}
            {group.items.map((item) => (
              <a href={getPermalink(item.href)} class={itemClass(item.href)}>
                <Icon name={item.icon} class="w-4 h-4" />
                {t(item.textKey)}
              </a>
            ))}
          </>
        ))
      }
      <div class="border-t border-surface-3 my-2"></div>
      <a
        href={getPermalink('/')}
        class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-text-muted hover:bg-surface-3 transition-colors"
      >
        <Icon name="tabler:arrow-left" class="w-4 h-4" />
        {t('admin.backToSite')}
      </a>
    </nav>
  </aside>

  <!-- 主内容区 -->
  <div class={flush ? 'flex-1 min-w-0 h-screen flex flex-col' : 'flex-1 min-w-0'}>
    {flush ? <slot /> : <div class="p-6"><slot /></div>}
  </div>
</div>

<script>
  // 后台页面访问守卫：校验 cookie 会话，未登录/失效则跳登录页。
  // 凭证在 httpOnly cookie（@respond 后端是最终防线），这里只做 UX 层软门禁。
  import { apiFetch } from '~/lib/api/fetch';

  (async () => {
    // 已是登录页则不再拦截
    if (window.location.pathname.startsWith('/admin/login')) return;

    try {
      const result = await apiFetch('/api/v1/admin/auth/me', { method: 'GET' });
      // 401/403 = 未登录或后台权限不足 → 跳登录页
      if (result.isOk() && (result.value.status === 401 || result.value.status === 403)) {
        // 防重入：仅在未处于登录页时跳转一次
        window.location.replace('/admin/login');
      } else if (result.isErr()) {
        // 网络/超时/5xx 时不强闯，避免打不开后台业务页；由具体请求各自报错。
      }
    } catch {
      // 兜底
    }
  })();
</script>
