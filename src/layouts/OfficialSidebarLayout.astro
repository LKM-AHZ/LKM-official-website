---
import OfficialLayout from './OfficialLayout.astro';
import Sidebar from '~/features/homepage/components/Sidebar.astro';

import type { MetaData } from '~/types/core';

export interface SidebarLink {
  text: string;
  href: string;
  icon?: string;
}

export interface Props {
  metadata?: MetaData;
  sidebarLinks?: SidebarLink[];
  currentPath?: string;
  showFooter?: boolean;
  navItems?: string[];
}

const DEFAULT_ICON = 'tabler:link';
const { metadata, sidebarLinks = [], currentPath = '', showFooter = true, navItems } = Astro.props;
---

<OfficialLayout metadata={metadata} showFooter={showFooter} navItems={navItems}>
  <!-- 侧边栏走命名插槽 → 渲染进外层 #sidebar-wrapper 独立 Swup 容器（main 外） -->
  {
    sidebarLinks.length > 0 && (
      <Sidebar
        slot="sidebar"
        groups={sidebarLinks.map(({ icon, ...rest }) => ({ ...rest, icon: icon ?? DEFAULT_ICON }))}
        currentPath={currentPath}
      />
    )
  }

  <div data-main-content>
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20 lg:py-24">
      <slot />
    </div>
  </div>
</OfficialLayout>
