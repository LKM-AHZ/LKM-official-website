---
import PageLayout from "./PageLayout.astro";
import Sidebar from "~/features/homepage/components/Sidebar.astro";

import type { MetaData } from "~/types/core";

export interface SidebarLink {
  text: string;
  href: `#${string}`;
  icon?: string;
}

export interface Props {
  metadata?: MetaData;
  sidebarLinks?: SidebarLink[];
  currentPath?: string;
  navItems?: string[];
  showFooter?: boolean;
}

const DEFAULT_ICON = "tabler:link";

const {
  metadata,
  sidebarLinks = [],
  currentPath = Astro.url.pathname.replace(/\/$/, "") || "/",
  navItems,
  showFooter = true,
} = Astro.props;
---

<PageLayout metadata={metadata} navItems={navItems} showFooter={showFooter}>
  <!-- 侧边栏只接受本页锚点；跨页面导航统一由顶栏负责。 -->
  {
    sidebarLinks.length > 0 && (
      <Sidebar
        slot="sidebar"
        groups={sidebarLinks.map(({ icon, ...rest }) => ({
          ...rest,
          icon: icon?.trim() || DEFAULT_ICON,
        }))}
        currentPath={currentPath}
      />
    )
  }

  <div data-main-content>
    <div class="site-content-frame">
      <slot />
    </div>
  </div>
</PageLayout>
