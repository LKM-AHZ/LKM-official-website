---
import { BackToTop } from '~/components/primitives';
import Image from '~/components/primitives/Image.astro';
import Footer from '~/features/shell/components/FuwariFooter.astro';
import SideBar from '~/features/shell/components/BlogSidePanel.astro';
import type { MarkdownHeading } from 'astro';
import { Icon } from 'astro-icon/components';
import TOC from '~/features/shell/components/TOC.astro';
import SiteNavbar from '~/features/shell-official/components/SiteNavbar.astro';
import { allMenuItems } from '~/features/shell/menus';
import { filterNavbarByNames } from '~/lib/navigation';
import { siteConfig } from '~/lib/config';
import { t } from '~/lib/i18n';
import type { NavBarLink } from '~/types/config';
import { BANNER_HEIGHT, BANNER_HEIGHT_EXTEND, MAIN_PANEL_OVERLAPS_BANNER_HEIGHT } from '~/lib/constants/constants';
import Layout from './BlogLayout.astro';

interface Props {
  title?: string;
  banner?: string;
  description?: string;
  lang?: string;
  setOGTypeArticle?: boolean;
  headings?: MarkdownHeading[];
  username?: string;
  navItems?: string[];
}

const { title, banner, description, lang, setOGTypeArticle, headings = [], username, navItems } = Astro.props;
// 必须同时要求 credit.url 非空：否则会渲染出 href="" + target="_blank" 的空链接
const hasBannerCredit =
  siteConfig.banner.enable &&
  siteConfig.banner.credit.enable &&
  !!siteConfig.banner.credit.url;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
  ? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
  : '5.5rem';

// 博客网格顶栏：从统一菜单池用 navItems 白名单挑选（桌面 SiteNavbar），并向底层 BlogLayout 透传（移动端）
const navbarLinks: NavBarLink[] = filterNavbarByNames(allMenuItems, navItems);

// filterNavbarByNames 对未命中的名字是静默丢弃的：白名单写错（或传 []）会得到一个
// 没有任何链接的导航栏，且不报错。开发期显式告警，避免上线后才发现。
if (import.meta.env.DEV && navItems?.length && navbarLinks.length === 0) {
  console.warn(
    `[BlogMainGridLayout] navItems 全部未匹配到菜单项（导航栏为空）: ${navItems.join(', ')}`,
  );
}
---

<Layout
  title={title}
  banner={banner}
  description={description}
  lang={lang}
  setOGTypeArticle={setOGTypeArticle}
  navItems={navItems}
>
  <!-- Navbar -->
  <slot slot="head" name="head" />
  <SiteNavbar class="transition-all" links={navbarLinks} />

  <!-- Banner -->
  {
    siteConfig.banner.enable && (
      <div
        id="banner-wrapper"
        class="absolute z-10 w-full transition duration-700 overflow-hidden"
        style={`top: -${BANNER_HEIGHT_EXTEND}vh`}
      >
        <div id="banner" class="overflow-hidden relative w-full h-full">
          <Image
            id="banner-img"
            alt={t('blog.bannerAlt')}
            src={`~/assets/images/${String(siteConfig.banner.src).replace(/^assets\/images\//, '')}`}
            layout="cover"
            class="object-cover h-full w-full transition duration-700 opacity-0 scale-105"
            style={`object-position: ${siteConfig.banner.position}`}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    )
  }

  <!-- Main content -->
  <div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
      <div
        id="main-grid"
        class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4"
      >
        <!-- Banner image credit -->
        {
          hasBannerCredit && (
            <a
              href={siteConfig.banner.credit.url}
              id="banner-credit"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t('blog.imageSourceLabel')}
              class:list={[
                'group onload-animation transition-all absolute flex justify-center items-center rounded-full ' +
                  'px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9',
                { 'hover:pr-9 active:bg-black/80': hasBannerLink },
              ]}
            >
              <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" />
              <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
              <Icon
                class:list={[
                  'transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0',
                  { 'group-hover:opacity-100': hasBannerLink },
                ]}
                name="fa6-solid:arrow-up-right-from-square"
              />
            </a>
          )
        }

        <SideBar
          class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem]"
          headings={headings}
          username={username}
        />

        <main id="main-container" class="col-span-2 lg:col-span-1 overflow-hidden">
          <div id="content-wrapper" class="onload-animation">
            <!-- the overflow-hidden here prevent long text break the layout-->
            <slot />
            <div class="footer col-span-2 onload-animation hidden lg:block">
              <Footer />
            </div>
          </div>
        </main>

        <div class="footer col-span-2 onload-animation block lg:hidden">
          <Footer />
        </div>
      </div>

      <BackToTop />
    </div>
  </div>

  <!-- The things that should be under the banner, only the TOC for now -->
  <div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-[var(--page-width)] mx-auto">
      <!-- TOC component -->
      {
        siteConfig.toc.enable && (
          <div
            id="toc-wrapper"
            class:list={[
              'hidden lg:block transition absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center',
              { 'toc-hide': siteConfig.banner.enable },
            ]}
          >
            <div
              id="toc-inner-wrapper"
              class="fixed top-14 w-[var(--toc-width)] h-[calc(100vh_-_20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar"
            >
              <div id="toc" class="w-full h-full">
                <div class="h-8 w-full" />
                <TOC headings={headings} />
                <div class="h-8 w-full" />
              </div>
            </div>
          </div>
        )
      }

      <!-- #toc needs to exist for View Transitions to work normally -->
      {!siteConfig.toc.enable && <div id="toc" />}
    </div>
  </div>
</Layout>
