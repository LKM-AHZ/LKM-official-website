---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  icon?: string;
  id?: string;
}

const { title, description, eyebrow, icon, id = "overview" } = Astro.props;
---

<header id={id} class="page-intro">
  <div class="page-intro-copy">
    {eyebrow && <p class="page-intro-eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <p class="page-intro-description">{description}</p>}
  </div>
  {
    icon && (
      <span class="page-intro-icon" aria-hidden="true">
        <Icon name={icon} />
      </span>
    )
  }
  <slot name="actions" />
</header>
