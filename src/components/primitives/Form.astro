---
import type { HTMLAttributes } from 'astro/types';
import type { Form as Props } from '~/types/core';
import Button from './Button.astro';

// 与 astro 的 JSX 定义同源（HTMLAttributes<'input'>['type']），比 as never 有约束力
type InputType = HTMLAttributes<'input'>['type'];

const { inputs, textarea, disclaimer, button = 'Contact us', description = '' } = Astro.props as Props;
---

{/* 这是静态展示表单（提交由脚本拦下并提示，i18n 文案见 primitives.formStaticWarning）：
    没有接收端，就不该保留 method="POST"/action="#" 这套假接线 */}
<form id="contact-form">
  <div id="form-message" class="hidden mb-4" role="alert"></div>
  {
    inputs &&
      inputs.map(
        ({ type, name, label = '', autocomplete = 'on', placeholder = '', ...rest }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label class="label" for={name}>
                  <span class="label-text">{label}</span>
                </label>
              )}
              <input
                type={(type ?? 'text') as InputType}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                {...rest}
                class="input input-bordered w-full"
              />
            </div>
          )
      )
  }

  {
    textarea && (
      <div class="mb-6">
        {textarea.label && (
          <label class="label" for="textarea">
            <span class="label-text">{textarea.label}</span>
          </label>
        )}
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          class="textarea textarea-bordered w-full"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3">
        <label class="label cursor-pointer justify-start gap-2">
          <input type="checkbox" id="disclaimer" name="disclaimer" class="checkbox" />
          <span class="label-text">{disclaimer.label}</span>
        </label>
      </div>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-[12px] text-text-muted">{description}</p>
      </div>
    )
  }
</form>

<script>
  import { t } from '~/lib/i18n';
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', function (this: HTMLFormElement, e: SubmitEvent) {
      e.preventDefault();
      const msg = document.getElementById('form-message');
      if (msg) {
        // 只摘掉 hidden，别整体覆盖 className——否则模板上新加的类会被无声丢弃
        msg.classList.remove('hidden');
        msg.classList.add('alert', 'alert-warning');
        msg.textContent = t('primitives.formStaticWarning');
      }
    });
  }
</script>
