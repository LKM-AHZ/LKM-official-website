---
import { twMerge } from 'tailwind-merge';
import { Icon } from 'astro-icon/components';
import type { CallToAction as Props } from '~/types/core';

const {
  variant = 'secondary',
  target,
  text = await Astro.slots.render('default'),
  icon = '',
  class: className = '',
  type,
  href,
  // classes 来自共享的 CallToAction 类型（给带子部件的组件用），Button 没有可覆写的子部件：
  // 从 rest 里摘掉，否则整个对象会被展开到 DOM，渲染出 classes="[object Object]"
  classes: _classes,
  ...rest
} = Astro.props;

const variantClass =
  {
    primary: 'btn-primary',
    secondary: 'btn-neutral',
    tertiary: 'btn-ghost',
    link: 'btn-link',
  }[variant] || 'btn-neutral';

// type 只可能是 button/submit/reset（见 CallToAction），所以「是否显式给了 type」等价于
// `type != null`：直接用 `type ?? 'button'` 即可，不必再引入名字误导的 isSubmit 标志
---

{
  href ? (
    <a
      class={twMerge('btn', variantClass, 'pointer-events-auto', className)}
      href={href}
      {...(target ? { target } : {})}
      {...(target === '_blank' ? { rel: 'noopener noreferrer' } : {})}
      {...rest}
    >
      <Fragment set:html={text} />
      {icon && <Icon name={icon} class="w-5 h-5 inline-block" />}
    </a>
  ) : (
    <button
      class={twMerge('btn', variantClass, 'pointer-events-auto', className)}
      type={type ?? 'button'}
      {...rest}
    >
      <Fragment set:html={text} />
      {icon && <Icon name={icon} class="w-5 h-5 inline-block" />}
    </button>
  )
}
