{
  "name": "lkm-official-website",
  "version": "1.0.0-beta.63",
  "description": "LiKeMi Official Website",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:frontend": "astro dev",
    "dev:clean": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\" && astro dev",
    "start": "node ./dist/server/entry.mjs",
    "build": "node scripts/generate-icons.mjs && node scripts/generate-i18n-flat.mjs && astro build && node scripts/precompress.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "turbo run check:astro check:eslint check:prettier check:jscpd",
    "check:serial": "pnpm run check:astro && pnpm run check:eslint && pnpm run check:prettier && pnpm run check:jscpd",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "check:jscpd": "jscpd src --config .jscpdrc.json",
    "fix": "pnpm run fix:eslint && pnpm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "pnpm run test",
    "test:auth": "vitest run src/features/auth",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "dev:packages": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "typecheck": "pnpm run check:astro",
    "lint": "eslint src scripts",
    "format:check": "pnpm run check:prettier",
    "test:smoke": "playwright test --project=chromium routes.spec.ts",
    "test:a11y": "playwright test --project=chromium accessibility.spec.ts",
    "check:seo": "node scripts/check-seo-output.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "lighthouse:budget": "node scripts/lighthouse-budget.mjs",
    "lighthouse:budget:update": "node scripts/lighthouse-budget.mjs --update-baseline",
    "measure:cwv": "node scripts/measure-cwv.mjs"
  },
