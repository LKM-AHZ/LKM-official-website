{
  "ignore": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.git/**",
    "**/src/lib/icons/**",
    "**/tests/**",
    "**/*.d.ts"
  ],
  "minLines": 8,
  "minTokens": 40,
  "threshold": 8,
  "maxSize": "50kb",
  "format": ["typescript", "tsx", "javascript", "jsx", "vue", "astro"],
  "reporters": ["console", "json"],
  "output": "reports/jscpd"
}
